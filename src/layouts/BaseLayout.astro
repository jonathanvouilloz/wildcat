---
import '../styles/global.css';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';
import { site } from '../config/site';
import { m } from '../paraglide/messages.js';

export interface Props {
  title: string;
  description?: string;
  /** Locale de la page. Par défaut, celle détectée par Astro i18n. */
  lang?: string;
  /** Image OG/Twitter (chemin public ou URL absolue). Défaut : site.defaultOgImage. */
  image?: string;
  /** og:type — 'article' pour le blog (E8). */
  ogType?: 'website' | 'article';
  /** Pages à exclure de l'index (ex : confirmation formulaire). */
  noindex?: boolean;
  /**
   * Hreflang asymétriques (E8) — les slugs d'articles blog sont TRADUITS par
   * locale, le calcul symétrique /en↔/fr serait un 404. Hrefs ABSOLUS,
   * uniquement les locales où la traduction existe (lib/blog getAlternates).
   * Absent = calcul symétrique (toutes les autres pages, inchangé).
   */
  alternates?: { lang: string; href: string }[];
}

const {
  title,
  description,
  lang = Astro.currentLocale ?? 'en',
  image = site.defaultOgImage,
  ogType = 'website',
  noindex = false,
  alternates: alternatesProp,
} = Astro.props;

// Default évalué dans le corps (pas en destructuration) : la locale Paraglide
// est posée par le middleware avant le rendu, pas avant l'évaluation des props.
const metaDescription = description ?? m.meta_default_description();

const locales = ['en', 'fr'];
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';
const ogLocaleAlternate = lang === 'fr' ? 'en_US' : 'fr_FR';

const base = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;

// hreflang alternates — override par prop (blog, slugs traduits) ou calcul
// symétrique (pages service : paths identiques EN/FR).
const path = Astro.url.pathname.replace(/^\/(en|fr)/, '');
const alternates =
  alternatesProp ??
  locales.map((loc) => ({
    lang: loc,
    href: new URL(`/${loc}${path}`, base).href,
  }));
// x-default = la version EN si elle existe — jamais de lien vers un 404
// (article FR-only : pas de x-default plutôt qu'un x-default cassé).
const xDefault = alternates.find((alt) => alt.lang === 'en')?.href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <!-- Favicon — tigre (logo-only). SVG moderne + .ico fallback (16/32/48). -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- Fonts — preload du poids critique uniquement (Satoshi 700 : titres + nav).
         400 non préchargé (below the fold) ; Fraunces non préchargeable (bundlée
         par Vite via fontsource, accent-only, pas LCP) — voir docs/DESIGN.md. -->
    <link
      rel="preload"
      href="/fonts/satoshi/satoshi-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD (E7) : <script type="application/ld+json" slot="jsonld"> -->
    <slot name="jsonld" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Nav alternates={alternatesProp} />
    <slot />
    <Footer />
  </body>
</html>
