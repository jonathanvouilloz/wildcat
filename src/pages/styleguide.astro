      /* A — centré, ancré bas, gradient vertical + voile gold.
         Plus haut que B (88vh) : la place verticale permet visages intacts
         en haut ET texte lisible en bas, qui chevauche le brush. */
      .sg-heroA {
        background-position: center 60%;
        align-items: flex-end;
        justify-content: center;
        min-height: clamp(600px, 88vh, 860px);
      }
      .sg-heroA::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(rgba(224, 166, 43, 0.06), rgba(224, 166, 43, 0.06)),
          linear-gradient(
            180deg,
            rgba(33, 66, 44, 0.55) 0%,
            rgba(33, 66, 44, 0.26) 26%,
            rgba(33, 66, 44, 0.58) 54%,
            rgba(33, 66, 44, 0.95) 100%
          );
      }
      .sg-hero-inner {
        position: relative;
        z-index: 2; /* au-dessus du brush — le texte le chevauche un peu */
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        max-width: 880px;
        margin: 0 auto;
        padding: clamp(140px, 20vh, 220px) var(--gutter) clamp(24px, 3vw, 44px);
