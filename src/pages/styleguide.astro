        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 14px 18px;
        margin-top: 34px;
        padding-top: 20px;
        border-top: 1px solid rgba(246, 241, 230, 0.25);
        color: rgba(246, 241, 230, 0.85);
        font-size: 13.5px;
      }
      .sg-metastrip b { color: var(--cream); font-weight: 800; }
      .sg-metastrip i { color: var(--gold); font-style: normal; font-size: 10px; }

      .sg-foreststrip {
        background: var(--forest);
        color: rgba(246, 241, 230, 0.6);
        text-align: center;
        font-size: 12px;
        padding: 14px 0 18px;
      }

      /* B — bottom-left, image décalée à droite, gradient diagonal */
      .sg-heroB {
        background-position: 70% 68%;
        align-items: flex-end;
      }
      .sg-heroB::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(rgba(224, 166, 43, 0.05), rgba(224, 166, 43, 0.05)),
          linear-gradient(
            76deg,
            rgba(33, 66, 44, 0.94) 0%,
            rgba(33, 66, 44, 0.62) 34%,
            rgba(33, 66, 44, 0.12) 64%,
            rgba(33, 66, 44, 0.3) 100%
          );
      }
      .sg-hero-innerB {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: var(--maxw);
        margin: 0 auto;
        padding: clamp(160px, 22vh, 220px) var(--gutter) clamp(56px, 6vw, 84px);
      }
      .sg-hero-innerB .sg-sub { margin-bottom: 26px; }
      .sg-eyebrow { font-size: clamp(17px, 1.6vw, 21px); margin-bottom: 14px; }

      /* C — split cream, image full-height jusqu'au bord droit */
      .sg-heroC {
        background: var(--cream);
        display: grid;
        grid-template-columns: 1.04fr 1fr;
        align-items: center;
        gap: clamp(24px, 4vw, 46px);
      }
      .sg-heroC .c-copy {
        padding: clamp(48px, 6vw, 80px) 0 clamp(48px, 6vw, 80px)
          max(var(--gutter), calc((100vw - var(--maxw)) / 2));
      }
      .c-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 22px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 7px 14px 7px 8px;
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--forest);
        box-shadow: var(--shadow-sm);
      }
      .c-badge .pill {
        background: var(--gold);
        color: #1c1407;
        font-size: 11px;
        padding: 3px 9px;
        border-radius: 999px;
        letter-spacing: 0.04em;
      }
      .sg-subC {
        color: var(--ink-2);
        font-size: clamp(17px, 1.5vw, 20px);
        max-width: 40ch;
        margin: 18px 0 28px;
      }
      .sg-heroC .c-media {
        position: relative;
        align-self: stretch;
        min-height: 480px;
      }
      .sg-heroC .c-media > img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 45% 30%;
      }
      .c-float {
        position: absolute;
        left: -18px;
        bottom: 26px;
        background: var(--forest);
        color: var(--cream);
        border-radius: var(--r-md);
        padding: 14px 18px;
        box-shadow: var(--shadow-lg);
        max-width: 210px;
      }
      .c-float .t { color: var(--gold); font-weight: 800; font-size: 15px; margin-bottom: 2px; }
      .c-float .d { font-size: 12.5px; color: rgba(246, 241, 230, 0.8); line-height: 1.4; }

      /* D — poster stacked : bande forest + tigre watermark, photo dessous */
      .sg-heroD .d-band {
        position: relative;
        overflow: hidden;
        background: var(--forest);
        text-align: center;
        padding: clamp(48px, 7vw, 90px) var(--gutter);
      }
      .d-tiger {
        position: absolute;
        inset: 0;
        margin: auto;
        width: min(480px, 70%);
        background: var(--cream);
        opacity: 0.07;
        -webkit-mask: url('/assets/logo-only.svg') center / contain no-repeat;
        mask: url('/assets/logo-only.svg') center / contain no-repeat;
      }
      .sg-heroD .sg-title { position: relative; }
      .d-logo {
        position: relative;
        display: block;
        height: 30px;
        width: auto;
        margin: 28px auto 0;
        opacity: 0.92;
      }
      .d-photo img {
        display: block;
        width: 100%;
        height: clamp(280px, 38vw, 440px);
        object-fit: cover;
        object-position: center 30%;
      }

      /* D2 — poster inversé : photo en haut + brush (forest) qui mord le bas
         de la photo, contenu 100% lisible sur la bande forest dessous */
      .sg-heroD2 .d2-photo {
        position: relative;
      }
      .sg-heroD2 .d2-photo > img {
        display: block;
        width: 100%;
        height: clamp(380px, 62vh, 640px);
        object-fit: cover;
        object-position: center 28%;
      }
      .sg-heroD2 .d2-photo::after {
        /* léger voile forest+gold pour lier la photo à la palette */
        content: '';
        position: absolute;
        inset: 0;
        background:
          linear-gradient(rgba(224, 166, 43, 0.05), rgba(224, 166, 43, 0.05)),
          rgba(33, 66, 44, 0.16);
      }
      .d2-brush {
        position: absolute;
        left: 0;
        right: 0;
        bottom: -2px;
        width: 100%;
        height: auto;
        z-index: 1;
      }
      .d2-brush :global(path) { fill: var(--forest); }
      .d2-band {
        position: relative;
        overflow: hidden;
        background: var(--forest);
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        /* compacte : la photo domine, la bande porte juste lockup + sub + CTAs */
        padding: clamp(12px, 1.6vw, 24px) var(--gutter) clamp(36px, 4vw, 56px);
      }
      .d2-band .sg-sub { margin: 14px 0 22px; }

      @media (max-width: 860px) {
        .sg-heroC { grid-template-columns: 1fr; gap: 0; }
        .sg-heroC .c-copy { padding: 40px var(--gutter) 36px; }
        .sg-heroC .c-media { min-height: 380px; margin: 0 0 0 var(--gutter); }
        .c-float { left: 12px; }
        .sg-vcap .reco { margin-left: 0; }
      }

      /* ============================================================
         Fighter guest book — démo composant final (le gros du style
         vit dans FighterCard.astro / AchievementStamp.astro).
         ============================================================ */
      .fg-counter {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 14px 26px;
        background: var(--forest);
        color: var(--cream);
        border-radius: var(--r-lg);
        padding: 24px 30px;
        box-shadow: var(--shadow-md);
      }
      .fg-count { display: flex; align-items: baseline; gap: 10px; }
      .fg-count b {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: clamp(28px, 3vw, 38px);
        line-height: 1;
        color: var(--gold);
      }
      .fg-count span { font-size: 13.5px; color: rgba(246, 241, 230, 0.85); }
      .fg-counter > i { color: var(--gold); font-style: normal; font-size: 11px; }

      @media (min-width: 768px) {
        /* punaisé, pas aligné au cordeau */
        .fg-demo-grid > :global(*:nth-child(even)) { margin-top: 34px; }
      }

    </style>
  </body>
</html>
