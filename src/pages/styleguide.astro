  { name: 'Surface', hex: '#FFFFFF' },
  { name: 'Soft', hex: '#FAF7F0' },
  { name: 'Soft 2', hex: '#F2ECE1' },
  { name: 'Line', hex: '#E6DDC9' },
  { name: 'Line 2', hex: '#D8CBB3' },
  { name: 'Line 3', hex: '#B5A98C' },
