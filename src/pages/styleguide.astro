---
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Nav from '../components/sections/Nav.astro';
import { Icon } from 'astro-icon/components';

// Inventaire des icônes (set candidat : Tabler). Swappable : changer le préfixe.
const iconGroups = [
  {
    title: 'Navigation / mega menu',
    items: [
      { label: 'Classes (Muay Thai)', name: 'karate' },
      { label: 'Conditioning', name: 'barbell' },
      { label: 'Niveaux', name: 'chart-bar' },
      { label: 'Coach / privé', name: 'user' },
      { label: 'Communauté', name: 'users' },
      { label: "Women's", name: 'gender-female' },
      { label: 'Kids & family', name: 'mood-kid' },
      { label: 'Fight team', name: 'flame' },
      { label: 'Horaires', name: 'calendar-event' },
      { label: 'Pricing', name: 'tag' },
      { label: 'Essai gratuit', name: 'sparkles' },
      { label: 'Stay & Train', name: 'route' },
      { label: 'Long-stay', name: 'home-2' },
      { label: 'Logement', name: 'bed' },
      { label: 'Scooter / moto', name: 'motorbike' },
      { label: 'Getting here', name: 'map-pin' },
      { label: 'Chiang Mai guide', name: 'map-2' },
      { label: 'Things to do', name: 'leaf' },
      { label: 'DTV / id', name: 'id' },
      { label: 'Éligible', name: 'circle-check' },
      { label: 'How to apply', name: 'list-check' },
      { label: 'Documents', name: 'file-text' },
      { label: 'FAQ', name: 'help-circle' },
      { label: 'Talk to us', name: 'message-circle' },
      { label: 'Gallery', name: 'camera' },
      { label: 'Reviews', name: 'star' },
      { label: 'Caret', name: 'chevron-down' },
    ],
  },
  {
    title: 'Mini-app DTV (formulaire / upload)',
    items: [
      { label: 'Passeport', name: 'id-badge-2' },
      { label: 'Photo ID', name: 'photo' },
      { label: 'Justif. revenus', name: 'receipt' },
      { label: 'Upload', name: 'upload' },
      { label: 'Cloud upload', name: 'cloud-upload' },
      { label: 'Fichier OK', name: 'file-check' },
      { label: 'Erreur', name: 'alert-circle' },
      { label: 'Succès', name: 'confetti' },
      { label: 'Consentement', name: 'lock' },
      { label: 'Sécurité', name: 'shield-check' },
      { label: 'Email', name: 'mail' },
    ],
  },
  {
    title: 'Contact / footer / réseaux (logos)',
    items: [
      { label: 'Adresse', name: 'map-pin' },
      { label: 'Téléphone', name: 'phone' },
      { label: 'Email', name: 'mail' },
      { label: 'Horaires', name: 'clock' },
      { label: 'Instagram', name: 'brand-instagram' },
      { label: 'Facebook', name: 'brand-facebook' },
      { label: 'YouTube', name: 'brand-youtube' },
      { label: 'WhatsApp', name: 'brand-whatsapp' },
      { label: 'TikTok', name: 'brand-tiktok' },
      { label: 'Google', name: 'brand-google' },
    ],
  },
  {
    title: 'Fighters / Coaches / Pricing',
    items: [
      { label: 'Trophée', name: 'trophy' },
      { label: 'Médaille', name: 'medal' },
      { label: 'Combats', name: 'swords' },
      { label: 'Feature ✓', name: 'check' },
      { label: 'Most popular', name: 'star' },
    ],
  },
  {
    title: 'UI transverse',
    items: [
      { label: 'Menu (burger)', name: 'menu-2' },
      { label: 'Close', name: 'x' },
      { label: 'Langue', name: 'world' },
      { label: 'Arrow', name: 'arrow-right' },
      { label: 'Play (vidéo)', name: 'player-play' },
      { label: 'Lien externe', name: 'external-link' },
      { label: 'Chevron', name: 'chevron-right' },
    ],
  },
];

// Page interne de référence design — non indexée, non localisée.

const coreColors = [
  { name: 'Forest Light', hex: '#3B6645', role: 'Surfaces en relief (bouton forest)', dark: true },
  { name: 'Forest', hex: '#2E5D3C', role: 'Base — nav, footer, sections sombres, titres', dark: true },
  { name: 'Forest Deep', hex: '#21422C', role: 'Ombres / ledges, util bar', dark: true },
  { name: 'Gold', hex: '#E0A62B', role: 'CTA principal, accents', dark: false },
  { name: 'Gold Deep', hex: '#C98A12', role: 'Accents texte / liens', dark: false },
  { name: 'Cream', hex: '#F6F1E6', role: 'Fond clair principal', dark: false },
  { name: 'Orange', hex: '#D97732', role: 'Terracotta — ◆ section heads', dark: false },
  { name: 'Charcoal', hex: '#111111', role: 'Contraste extrême', dark: true },
];
const surfaces = [
  { name: 'Surface', hex: '#FFFFFF' },
  { name: 'Soft', hex: '#FAF7F0' },
  { name: 'Soft 2', hex: '#F2ECE1' },
  { name: 'Line', hex: '#E6DDC9' },
  { name: 'Line 2', hex: '#D8CBB3' },
  { name: 'Line 3', hex: '#B5A98C' },
];
const inks = [
  { name: 'Ink', hex: '#1B2A22' },
  { name: 'Ink 2', hex: '#556157' },
  { name: 'Ink 3', hex: '#8A9389' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Wildcat — Design System</title>
  </head>
  <body>
    <!-- Mega menu live (sticky) -->
    <Nav />

    <div class="mx-auto max-w-[1100px] px-6 py-14">
      <!-- Intro -->
      <header class="mb-16">
        <SectionHead>Design System v1</SectionHead>
        <h1 class="display mt-3">
          The Wildcat <span class="em">look book.</span>
        </h1>
        <p class="mt-4 max-w-[60ch] text-lg text-ink-2">
          La base verrouillée — couleurs, typographie, boutons, motifs et navigation — pour toute la
          suite du site. Référence vivante (Astro + Tailwind v4). Voir <code>docs/DESIGN.md</code>.
        </p>
        <p class="mt-3 text-sm text-ink-3">
          ↑ Le <strong>mega menu</strong> est live en haut de page — survole <em>Train · Stay &amp; Train · DTV Visa · About</em> (réduis la fenêtre &lt; 1080px pour le drawer mobile).
        </p>
      </header>

      <!-- Signature lockup -->
      <section class="mb-20">
        <SectionHead>Signature lockup</SectionHead>
        <div
          class="mt-4 overflow-hidden rounded-[var(--r-lg)] bg-forest px-8 py-16 text-center md:py-24"
          style="box-shadow: var(--shadow-md)"
        >
          <p class="font-display text-4xl font-bold leading-[1.05] tracking-[-0.035em] text-cream md:text-6xl">
            Come for the fight.<br />
            <span class="em on-dark">Stay for the family.</span>
          </p>
        </div>
        <p class="mt-3 text-sm text-ink-3">
          Satoshi Bold (cream) + Fraunces 72pt SemiBold Italic (gold). Le pattern de marque.
        </p>
      </section>

      <!-- Colors -->
      <section class="mb-20">
        <SectionHead>Couleurs</SectionHead>
        <h2 class="h2 mt-3 mb-6">Palette Tropical Garden</h2>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
          {
            coreColors.map((c) => (
              <div class="overflow-hidden rounded-[var(--r-md)] border border-line bg-surface">
                <div class="h-24 w-full" style={`background:${c.hex}`} />
                <div class="p-3">
                  <div class="font-display font-bold text-ink">{c.name}</div>
                  <div class="font-mono text-xs text-ink-2">{c.hex}</div>
                  <div class="mt-1 text-xs text-ink-3">{c.role}</div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
          {
            [...surfaces, ...inks].map((c) => (
              <div class="rounded-[var(--r-md)] border border-line bg-surface p-3">
                <div
                  class="mb-2 h-12 w-full rounded border border-line"
                  style={`background:${c.hex}`}
                />
                <div class="text-[13px] font-bold text-ink">{c.name}</div>
                <div class="font-mono text-[11px] text-ink-2">{c.hex}</div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Typography -->
      <section class="mb-20">
        <SectionHead>Typographie</SectionHead>
        <h2 class="h2 mt-3 mb-2">
          Satoshi + <span class="em">Fraunces.</span>
        </h2>
        <p class="mb-8 max-w-[60ch] text-ink-2">
          Satoshi Bold pour les titres, Satoshi pour le corps. Fraunces 72pt SemiBold Italic (or)
          pour les accents et variations de titres.
        </p>

        <div class="space-y-6 rounded-[var(--r-lg)] border border-line bg-surface p-8">
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">.display · Satoshi 800</div>
            <div class="display">Train <span class="em">today.</span></div>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">.h1 · Satoshi 800</div>
            <h2 class="h1">Your Muay Thai home</h2>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">.h2 · Satoshi 700</div>
            <h2 class="h2">Real training, family vibe</h2>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">.h3 · Satoshi 700</div>
            <h3 class="h3">Beginner-friendly classes</h3>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Accent · Fraunces 72 SemiBold Italic</div>
            <div class="font-accent text-4xl italic text-gold-deep" style="font-variation-settings:'opsz' 72; font-weight:600">
              stay for the family.
            </div>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Lead · Satoshi 400</div>
            <p class="max-w-[60ch] text-lg text-ink-2">
              Real training. Real people. Real community. A warm, family-led gym where every level is
              welcome.
            </p>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Body · Satoshi 400</div>
            <p class="max-w-[64ch] text-ink">
              Open-air training in a Chiang Mai garden. Drop in for a class or stay for the season —
              train daily, recover by the pool, find your people.
            </p>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-3">Eyebrow / label</div>
            <SectionHead>Training programs</SectionHead>
          </div>
        </div>
      </section>

      <!-- Buttons -->
      <section class="mb-20">
        <SectionHead>Boutons</SectionHead>
        <h2 class="h2 mt-3 mb-2">
          The Wildcat <span class="em">press.</span>
        </h2>
        <p class="mb-7 max-w-[56ch] text-ink-2">
          Pill, Satoshi Bold en casse normale, relief (surface claire + ombre foncée) et flèche maison.
          Survol : lift + flèche qui glisse. Clic : la pastille s'enfonce.
        </p>

        <!-- showcase -->
        <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-8">
          <Button variant="forest" arrow>Start your DTV</Button>
          <Button variant="gold" arrow>Book a class</Button>
          <Button variant="outline" arrow>Start your DTV</Button>
        </div>

        <!-- flat (CTA nav) -->
        <div class="mb-8 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button variant="gold" flat arrow>Join now</Button>
          <span class="text-sm text-ink-3">variante <code>flat</code> (sans relief) — utilisée pour le CTA du nav, texte dynamique selon la page</span>
        </div>

        <!-- on dark -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-8 rounded-[var(--r-lg)] bg-forest p-8">
          <Button variant="gold" arrow>Start your DTV</Button>
          <Button variant="outline" onDark arrow>Start your DTV</Button>
        </div>

        <!-- links (navbar) -->
        <h3 class="mb-3 mt-10 font-display text-lg font-bold text-forest">Liens (navbar) — variante <code>link</code></h3>
        <div class="flex flex-wrap items-center gap-7">
          <Button variant="link" href="#">Classes</Button>
          <Button variant="link" href="#">Stay &amp; Train</Button>
          <Button variant="link" href="#">DTV Visa</Button>
          <Button variant="link" href="#">Contact</Button>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-7 rounded-[var(--r-lg)] bg-forest p-6">
          <Button variant="link" onDark href="#">Classes</Button>
          <Button variant="link" onDark href="#">Stay &amp; Train</Button>
          <Button variant="link" onDark href="#">DTV Visa</Button>
          <Button variant="link" onDark href="#">Contact</Button>
        </div>
      </section>

      <!-- Motifs -->
      <section class="mb-20">
        <SectionHead>Motifs &amp; iconographie</SectionHead>
        <h2 class="h2 mt-3 mb-6">
          The tiger, and a few marks of our own.
        </h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
          <figure class="overflow-hidden rounded-[var(--r-md)] border border-line bg-surface">
            <div class="m-stripes h-24"></div>
            <figcaption class="p-3 text-[13px] font-bold text-ink">
              Tiger stripes<small class="block font-mono text-[10px] font-normal uppercase text-ink-3">dividers · edges</small>
            </figcaption>
          </figure>
          <figure class="overflow-hidden rounded-[var(--r-md)] border border-line bg-surface">
            <div class="m-claw relative h-24"><i></i><i></i><i></i></div>
            <figcaption class="p-3 text-[13px] font-bold text-ink">
              Claw slash<small class="block font-mono text-[10px] font-normal uppercase text-ink-3">accent · hover</small>
            </figcaption>
          </figure>
          <figure class="overflow-hidden rounded-[var(--r-md)] border border-line bg-surface">
            <div class="flex h-24 items-center justify-center bg-gold">
              <div class="stamp-round">Wildcat · Est. Chiang Mai · Muay Thai</div>
            </div>
            <figcaption class="p-3 text-[13px] font-bold text-ink">
              Round stamp<small class="block font-mono text-[10px] font-normal uppercase text-ink-3">seals · stickers</small>
            </figcaption>
          </figure>
          <figure class="flex flex-col items-center justify-center rounded-[var(--r-md)] border border-line bg-forest p-5">
            <div class="dtv-stamp">
              <div class="big">DTV</div>
              <div class="l1">Visa Friendly</div>
              <div class="l2">Muay Thai · Soft Power</div>
            </div>
          </figure>
        </div>
      </section>

      <!-- Icon library -->
      <section class="mb-20">
        <SectionHead>Bibliothèque d'icônes</SectionHead>
        <h2 class="h2 mt-3 mb-2">Inventaire — <span class="em">Tabler.</span></h2>
        <p class="mb-8 max-w-[60ch] text-ink-2">
          Tous les besoins du PRD couverts par <strong>un seul set</strong> (Tabler, style ligne) —
          y compris les logos réseaux. Set swappable (Phosphor…) en changeant le préfixe.
          Le swoosh, le tigre et le DTV stamp restent custom.
        </p>

        {
          iconGroups.map((g) => (
            <div class="mb-7">
              <div class="mb-3 font-mono text-[11px] uppercase tracking-wider text-ink-3">{g.title}</div>
              <div class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6">
                {g.items.map((it) => (
                  <div class="flex flex-col items-center gap-2 rounded-[var(--r-md)] border border-line bg-surface px-2 py-4 text-center">
                    <Icon name={`tabler:${it.name}`} class="h-6 w-6 text-forest" />
                    <div class="text-[11px] font-bold leading-tight text-ink">{it.label}</div>
                    <code class="text-[10px] text-ink-3">{it.name}</code>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <!-- Components sample -->
      <section class="mb-20">
        <SectionHead>Composants</SectionHead>
        <h2 class="h2 mt-3 mb-6">Aperçu</h2>
        <div class="grid gap-5 md:grid-cols-3">
          <!-- program card -->
          <article class="overflow-hidden rounded-[var(--r-md)] border border-line bg-surface" style="box-shadow:var(--shadow-sm)">
            <div class="h-32 bg-soft-2"></div>
            <div class="p-5">
              <span class="inline-block rounded-full bg-soft-2 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-forest">Beginners</span>
              <h3 class="mt-3 font-display text-xl font-bold text-forest">Muay Thai Basics</h3>
              <p class="mt-1 text-sm text-ink-2">Start strong — stance, movement and technique in a no-ego space.</p>
            </div>
          </article>
          <!-- pricing plan -->
          <article class="relative flex flex-col rounded-[var(--r-md)] border-[1.5px] border-gold bg-surface p-7" style="box-shadow:var(--shadow-md)">
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gold px-3.5 py-1 text-[11px] font-bold uppercase tracking-wider text-charcoal">Most popular</span>
            <div class="text-[13px] font-bold uppercase tracking-wider text-forest">Monthly</div>
            <div class="font-display text-4xl font-extrabold text-forest">3,500 <span class="text-base font-bold text-ink-3">THB</span></div>
            <div class="mt-1 text-sm text-ink-2">Unlimited classes</div>
            <Button variant="gold" class="mt-5 w-full justify-center">Get started</Button>
          </article>
          <!-- faq -->
          <article class="rounded-[var(--r-md)] border border-line bg-surface p-2">
            <details open class="rounded-[var(--r-sm)] p-3">
              <summary class="flex cursor-pointer items-center justify-between font-display font-bold text-forest">Do I need experience? <span class="text-gold-deep">+</span></summary>
              <p class="mt-2 text-sm text-ink-2">Not at all — most members started as complete beginners. Come as you are.</p>
            </details>
            <details class="rounded-[var(--r-sm)] p-3">
              <summary class="flex cursor-pointer items-center justify-between font-display font-bold text-forest">What should I bring? <span class="text-gold-deep">+</span></summary>
              <p class="mt-2 text-sm text-ink-2">Comfortable clothes, water and a towel. Gloves &amp; wraps to borrow.</p>
            </details>
          </article>
        </div>
      </section>

      <!-- Logos -->
      <section class="mb-10">
        <SectionHead>Logo &amp; lockups</SectionHead>
        <h2 class="h2 mt-3 mb-6">The master mark</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="flex h-40 items-center justify-center rounded-[var(--r-md)] border border-line bg-surface p-8">
            <img src="/assets/logo-knockout.png" alt="Wildcat logo on light" class="max-h-20 w-auto" />
          </div>
          <div class="flex h-40 items-center justify-center rounded-[var(--r-md)] bg-forest p-8">
            <img src="/assets/logo-cream.png" alt="Wildcat logo on forest" class="max-h-20 w-auto" />
          </div>
          <div class="flex h-40 items-center justify-center rounded-[var(--r-md)] bg-gold p-8">
            <img src="/assets/logo.png" alt="Wildcat logo on gold" class="max-h-20 w-auto" />
          </div>
        </div>
      </section>

      <footer class="border-t border-line pt-6 text-sm text-ink-3">
        Wildcat Muay Thai · Design System v1 · interne (noindex) · juin 2026
      </footer>
    </div>

    <style>
      /* Motifs (repris de brand-board.css, adaptés aux tokens) */
      .m-stripes {
        background: repeating-linear-gradient(60deg, var(--forest) 0 14px, var(--gold) 14px 28px);
      }
      .m-claw {
        background: var(--charcoal);
      }
      .m-claw i {
        position: absolute;
        top: 50%;
        width: 7px;
        height: 54px;
        background: var(--gold);
        border-radius: 6px;
        transform: translateY(-50%) rotate(16deg);
      }
      .m-claw i:nth-child(1) { left: 38%; height: 40px; }
      .m-claw i:nth-child(2) { left: 47%; }
      .m-claw i:nth-child(3) { left: 56%; height: 46px; }

      .stamp-round {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        border: 2px solid var(--charcoal);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-family: ui-monospace, monospace;
        font-size: 8.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--charcoal);
        line-height: 1.25;
        padding: 6px;
      }

      /* DTV stamp (repris de landing.css) */
      .dtv-stamp {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 34%, #efb63a, #db9a14);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #1c1407;
        border: 3px solid #1c1407;
        box-shadow: 0 30px 60px -28px rgba(0, 0, 0, 0.7);
        position: relative;
      }
      .dtv-stamp::before {
        content: '';
        position: absolute;
        inset: 9px;
        border: 1.5px solid rgba(28, 20, 7, 0.45);
        border-radius: 50%;
      }
      .dtv-stamp .big {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 34px;
        line-height: 0.85;
      }
      .dtv-stamp .l1 {
        font-weight: 800;
        font-size: 9px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        margin-top: 6px;
      }
      .dtv-stamp .l2 {
        font-size: 8px;
        font-weight: 700;
        margin-top: 3px;
        opacity: 0.85;
      }

      details summary::-webkit-details-marker { display: none; }
      details[open] summary span { transform: rotate(45deg); display: inline-block; }
    </style>
  </body>
</html>
