// --- Program & Pricing cards — démo des composants finaux (données factices)
const cxPrograms = [
  {
    level: 'Beginners',
    title: 'Muay Thai Basics',
    body: 'Stance, movement and real technique — built from zero in a no-ego space.',
    image: { src: '/assets/gym-place.webp', alt: 'The open-air gym at Wildcat' },
