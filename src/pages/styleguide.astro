        position: absolute;
        right: 0;
        bottom: 0;
        width: min(52%, 620px);
        aspect-ratio: 1008 / 972;
        -webkit-mask-image: url('/assets/decor/tiger-head.webp');
        mask-image: url('/assets/decor/tiger-head.webp');
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        -webkit-mask-position: bottom right;
        mask-position: bottom right;
      }
      .d2c-tigerwrap::after {
        /* scratches légères (pattern FighterCard) — masquées avec la photo */
        content: '';
        position: absolute;
        inset: 0;
        background: url('/assets/textures/photo-scratches.png') center / cover;
        mix-blend-mode: screen;
        opacity: 0.18;
        pointer-events: none;
      }
      .d2c-tiger {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      @media (max-width: 860px) {
        .sg-cta2D {
          grid-template-columns: 1fr;
          gap: 36px;
          /* le tigre repasse in-flow, collé au bord bas de la carte */
          padding-bottom: 0;
        }
        .d2c-media {
          min-height: 0;
        }
        .d2c-tigerwrap {
          position: static;
          width: 100%;
          margin-left: auto;
        }
      }

    </style>
