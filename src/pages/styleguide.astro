// --- Fighter guest book — protos de cards (données factices) -----------------
// Livre d'or : pas de record W/L. La stat = combats pris ; les victoires
// deviennent des stamps achievements (jamais de "0-1" sur une carte).
const flagOf = (cc: string) =>
  String.fromCodePoint(...[...cc.toUpperCase()].map((c) => 0x1f1a5 + c.charCodeAt(0)));
// Nom du pays au build (zéro dep) — l'emoji drapeau ne rend pas sur Chrome/Windows
const regionName = (cc: string) =>
  new Intl.DisplayNames(['en'], { type: 'region' }).of(cc.toUpperCase()) ?? cc;
const initialsOf = (name: string) =>
  name
    .split(/\s+/)
    .map((part) => part[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
// Rotation pseudo-aléatoire mais stable au build (hash du seed → -max..+max deg)
const seedRot = (seed: string, max = 6) => {
  let h = 0;
  for (const ch of seed) h = (h * 31 + ch.charCodeAt(0)) % 9973;
  return (h % (max * 2 + 1)) - max;
};
// Zone machine façon passeport (footer de la variante F·A)
const mrzLine = (raw: string, len = 34) =>
  (raw.toUpperCase().replace(/[^A-Z0-9<]+/g, '<') + '<'.repeat(len)).slice(0, len);

const ACH: Record<string, { label: string; ink: string }> = {
  'first-fight': { label: 'First fight', ink: 'var(--gold-deep)' },
  'stadium-win': { label: 'Stadium win', ink: 'var(--forest)' },
  ko: { label: 'KO win', ink: 'var(--orange)' },
  'five-fights': { label: '5+ fights', ink: 'var(--forest)' },
};

