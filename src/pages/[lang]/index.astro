---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import Button from '../../components/ui/Button.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { m } from '../../paraglide/messages.js';

// V1 : EN + FR. Génère /en et /fr.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

// Placeholder minimal (E5 remplacera par la vraie home). Strings : messages/{locale}.json.
---

<BaseLayout title={m.home_title()}>
  <main>
    <Section>
      <SectionHead>{m.home_eyebrow()}</SectionHead>
      <h1 class="display mt-3">
        {m.home_h1()} <span class="em">{m.home_h1_em()}</span> {m.home_h1b()}
      </h1>
      <p class="mt-6 max-w-[42ch] text-lg text-ink-2">{m.home_sub()}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="#" arrow>{m.home_cta()}</Button>
        <Button href="#programs" variant="forest">{m.home_cta2()}</Button>
      </div>
    </Section>
  </main>
</BaseLayout>
