---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoadingScreen from '../../components/interactive/LoadingScreen.astro';
import Section from '../../components/layout/Section.astro';
import TornDivider from '../../components/layout/TornDivider.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Button from '../../components/ui/Button.astro';
import Hero from '../../components/sections/Hero.astro';
import ValueStrip from '../../components/sections/ValueStrip.astro';
import DtvTeaser from '../../components/sections/DtvTeaser.astro';
import ProgramGrid from '../../components/sections/ProgramGrid.astro';
import ScheduleTable from '../../components/sections/ScheduleTable.astro';
import StayTrainUpsell from '../../components/sections/StayTrainUpsell.astro';
import CoachGrid from '../../components/sections/CoachGrid.astro';
import TestimonialQuote from '../../components/sections/TestimonialQuote.astro';
import InstagramFeed from '../../components/sections/InstagramFeed.astro';
import PricingTable from '../../components/sections/PricingTable.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';
import { localePath } from '../../lib/routes';
import { waLink } from '../../lib/whatsapp';
import { safeQuery } from '../../lib/content';
import { COACHES_QUERY, FEATURED_TESTIMONIALS_QUERY } from '../../lib/queries';
import type {
  COACHES_QUERY_RESULT,
  FEATURED_TESTIMONIALS_QUERY_RESULT,
} from '../../lib/sanity.types';
import { pickLocale } from '../../lib/i18n-content';
import { mapTestimonial } from '../../lib/testimonials';
import { urlFor } from '../../lib/image';
import { m } from '../../paraglide/messages.js';

// Home — port fidèle de la maquette `wildcat/project/WildCat Landing.html`
// sur le thème verrouillé (Satoshi/Fraunces + tokens). Contenu CMS via safeQuery
// avec fallbacks messages : publiable dataset vide.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

/* ---------- Contenu CMS (sections masquées si dataset vide) ---------- */

// Coachs — CMS only : pas de fallback factice (audit V1 2026-06-06, les noms
// inventés type « Kru Nut » nuisent à la crédibilité). Section masquée si vide.
const coachDocs = await safeQuery<COACHES_QUERY_RESULT>({ query: COACHES_QUERY }, []);
const coaches = coachDocs.slice(0, 3).map((coach) => ({
  name: coach.name ?? '',
  role: pickLocale(coach.role, lang),
  bio: pickLocale(coach.bio, lang),
  photo: coach.photo?.asset
    ? {
        // 640 carré : card coach v2 « polaroid » pleine colonne (+ retina)
        src: urlFor(coach.photo).width(640).height(640).format('webp').url(),
        alt: coach.photo.alt ?? coach.name ?? '',
      }
    : undefined,
}));

// Témoignages — CMS only : pas de faux avis (même raison), masqués si vide.
// #coaches = 1re featured NON-dtv (la quote DTV a sa place dans le teaser DTV,
// pas de doublon sur la même page) ; DtvTeaser = 1re featured dtv.
const testimonialDocs = await safeQuery<FEATURED_TESTIMONIALS_QUERY_RESULT>(
  { query: FEATURED_TESTIMONIALS_QUERY, params: { service: null } },
  [],
);
const quoteDoc = testimonialDocs.find((doc) => doc.service !== 'dtv');
const quote = quoteDoc ? mapTestimonial(quoteDoc, lang) : null;
const dtvQuoteDoc = testimonialDocs.find((doc) => doc.service === 'dtv');
const dtvQuote = dtvQuoteDoc
  ? {
      content: pickLocale(dtvQuoteDoc.content, lang),
      name: dtvQuoteDoc.name ?? '',
      meta: dtvQuoteDoc.country ?? undefined,
    }
  : undefined;

// Planning (teaser) — site.ts : les 4 sessions de groupe (horaires fixes 7j/7)
const scheduleRows = site.schedule.group.map((time) => ({
  time,
  cls: m.schedule_group_title(),
  tag: m.schedule_level_all(),
}));

/* ---------- Contenu statique (messages + site.ts) ---------- */

const values = [
  { icon: 'tabler:karate', title: m.home_val1_title(), body: m.home_val1_body() },
  { icon: 'tabler:users', title: m.home_val2_title(), body: m.home_val2_body() },
  { icon: 'tabler:flame', title: m.home_val3_title(), body: m.home_val3_body() },
  { icon: 'tabler:leaf', title: m.home_val4_title(), body: m.home_val4_body() },
];

const dtvSteps = [
  { title: m.home_dtv_step1_t(), body: m.home_dtv_step1_b() },
  { title: m.home_dtv_step2_t(), body: m.home_dtv_step2_b() },
  { title: m.home_dtv_step3_t(), body: m.home_dtv_step3_b() },
];

const programs = [
  // Card Beginners → satellite /classes/beginners (maillage silo Train)
  // Photos : même programme = même asset que /classes ; padwork = asset dédié (fight.jpg)
  { level: m.home_prog1_lvl(), title: m.home_prog1_t(), body: m.home_prog1_b(), href: p('/classes/beginners'), image: { src: '/assets/prog-beginners.webp', srcset: '/assets/prog-beginners-400.webp 400w, /assets/prog-beginners.webp 800w', width: 800, height: 800, alt: m.home_prog1_t(), position: 'center 28%' } },
  { level: m.home_prog2_lvl(), title: m.home_prog2_t(), body: m.home_prog2_b(), href: p('/classes'), image: { src: '/assets/prog-padwork.webp', srcset: '/assets/prog-padwork-400.webp 400w, /assets/prog-padwork.webp 800w', width: 800, height: 800, alt: m.home_prog2_t() } },
  { level: m.home_prog3_lvl(), title: m.home_prog3_t(), body: m.home_prog3_b(), href: p('/classes'), image: { src: '/assets/prog-fight-team.webp', srcset: '/assets/prog-fight-team-400.webp 400w, /assets/prog-fight-team.webp 800w', width: 800, height: 1067, alt: m.home_prog3_t(), position: 'center 32%' } },
];

// Tarifs réels (site.ts) — prix formatés selon la locale
const fmt = (price: number) => price.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US');
const priceOf = (list: readonly { key: string; price: number }[], key: string) =>
  list.find((item) => item.key === key)?.price ?? 0;
const plans = [
  {
    name: m.pricing_card_dropin_name(),
    price: fmt(priceOf(site.pricing.groupAdults, 'dropin')),
    currency: site.pricing.currency,
    unit: m.pricing_card_dropin_unit(),
    features: [
      m.pricing_card_dropin_f1(),
      m.pricing_card_dropin_f2(),
      m.pricing_card_dropin_f3(),
      m.pricing_card_dropin_f4(),
    ],
    cta: { label: m.cta_book_class(), href: `${p('/contact')}?intent=class`, variant: 'outline' as const },
  },
  {
    name: m.pricing_card_monthly_name(),
    price: fmt(priceOf(site.pricing.groupAdults, 'month_unlimited')),
    currency: site.pricing.currency,
    unit: m.pricing_card_monthly_unit(),
    features: [
      m.pricing_card_monthly_f1(),
      m.pricing_card_monthly_f2(),
      m.pricing_card_monthly_f3(),
      m.pricing_card_monthly_f4(),
    ],
    cta: { label: m.pricing_card_monthly_cta(), href: `${p('/contact')}?intent=class`, variant: 'gold' as const },
    popular: true,
  },
  {
    name: m.pricing_card_fighter_name(),
    price: fmt(priceOf(site.pricing.fighter, 'fighter_month')),
    currency: site.pricing.currency,
    unit: m.pricing_card_fighter_unit(),
    features: [
      m.pricing_card_fighter_f1(),
      m.pricing_card_fighter_f2(),
      m.pricing_card_fighter_f3(),
      m.pricing_card_fighter_f4(),
    ],
    cta: { label: m.cta_plan_stay(), href: p('/stay-train'), variant: 'forest' as const },
  },
];

const faqItems = [
  { q: m.faq_q1(), a: m.faq_a1() },
  { q: m.faq_q2(), a: m.faq_a2() },
  { q: m.faq_q3(), a: m.faq_a3() },
  { q: m.faq_q4(), a: m.faq_a4() },
  { q: m.faq_q5(), a: m.faq_a5() },
];

const instagram = site.social.find((s) => s.label === 'Instagram')?.href ?? '#';

/* ---------- JSON-LD SportsClub (PRD §7 : LocalBusiness sur la home) ---------- */
const base = Astro.site ?? Astro.url.origin;
// Ouvert 7j/7, mêmes horaires (site.hours = 1 entrée "daily")
const [opens, closes] = site.hours[0].time.split('–').map((part) => part.trim());
const hoursSpec = [
  {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens,
    closes,
  },
];
// priceRange dérivé des prix publics réels (site.pricing) — jamais en dur.
// `stayTrain` (28 000/mois) en est volontairement exclu : il embarque le logement,
// et priceRange sur un SportsClub se lit comme le coût de la pratique.
const allPrices = [
  ...site.pricing.groupAdults,
  ...site.pricing.groupKids,
  ...site.pricing.fighter,
  ...site.pricing.private,
].map((p) => p.price);
const priceRange = `${Math.min(...allPrices)}–${Math.max(...allPrices)} THB`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  name: site.name,
  sport: 'Muay Thai',
  url: new URL(`/${lang}`, base).href,
  image: new URL(site.defaultOgImage, base).href,
  telephone: site.contact.phone,
  email: site.contact.email,
  priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address,
    addressLocality: 'Chiang Mai',
    addressCountry: 'TH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.contact.geo.latitude,
    longitude: site.contact.geo.longitude,
  },
  sameAs: site.social.map((s) => s.href),
  openingHoursSpecification: hoursSpec,
};
---

<BaseLayout title={m.home_title()} description={m.home_meta_desc()}>
  <script type="application/ld+json" slot="jsonld" is:inline set:html={JSON.stringify(jsonld)} />

  {/* Intro scénographique — 1×/session, skip reduced-motion/no-JS */}
  {/* Désactivé (2026-07-11) — gardé au cas où : décommenter <LoadingScreen /> pour réactiver */}
  {/* <LoadingScreen /> */}

  <main>
    <Hero
      title={m.home_hero_title()}
      titleEm={m.home_hero_title_em()}
      sub={m.home_hero_sub()}
      ctaPrimary={{ label: m.home_hero_cta1(), href: p('/classes#pricing') }}
      ctaSecondary={{ label: m.home_hero_cta2(), href: p('/classes#schedule') }}
      metas={[
        { b: m.home_hero_meta1_b(), s: m.home_hero_meta1_s() },
        { b: m.home_hero_meta2_b(), s: m.home_hero_meta2_s() },
        { b: m.home_hero_meta3_b(), s: m.home_hero_meta3_s() },
      ]}
      image={{
        src: '/assets/hero-home-v3.webp',
        srcset: '/assets/hero-home-v3-768.webp 768w, /assets/hero-home-v3.webp 1080w',
        alt: m.home_hero_img_alt(),
        position: 'center 45%',
      }}
    />

    <ValueStrip items={values} />

    <DtvTeaser
      id="dtv"
      head={m.home_dtv_head()}
      title={m.home_dtv_title()}
      titleEm={m.home_dtv_title_em()}
      lead={m.home_dtv_lead()}
      steps={dtvSteps}
      cta={{ label: m.home_dtv_cta(), href: p('/dtv-visa') }}
      scooterTag={m.home_dtv_scooter()}
      quote={dtvQuote}
    />

    {/* le teaser DTV (forest-deep) déchire sur la section programs (soft) */}
    <TornDivider variant="wave-base" color="var(--forest-deep)" bg="var(--soft)" flipY />

    <Section soft id="programs">
      <div class="block-head row" data-animate="fade-up">
        <div>
          <SectionHead>{m.home_prog_head()}</SectionHead>
          <h2 class="h2 mt-2">{m.home_prog_title()}</h2>
        </div>
        <Button href={p('/classes#pricing')} variant="outline">{m.home_prog_seeall()}</Button>
      </div>
      <ProgramGrid programs={programs} moreLabel={m.home_prog_more()} />
    </Section>

    <Section id="schedule">
      <div class="split">
        <div data-animate="fade-up">
          <SectionHead>{m.home_sched_head()}</SectionHead>
          <h2 class="h2 mt-2 mb-3">{m.home_sched_title()}</h2>
          <p class="lead mb-6">{m.home_sched_lead()}</p>
          <ScheduleTable
            rows={scheduleRows}
            foot={{ label: m.home_sched_more(), href: p('/classes#schedule') }}
          />
        </div>
        <div data-animate="fade-right">
          <StayTrainUpsell
            head={m.home_stay_head()}
            title={m.home_stay_title()}
            titleEm={m.home_stay_title_em()}
            lead={m.home_stay_lead()}
            price={{
              value: site.pricing.stayTrain.price.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US'),
              currency: site.pricing.currency,
              unit: m.pricing_st_unit(),
            }}
            cta={{ label: m.pricing_st_cta(), href: `${p('/stay-train')}#packages` }}
            image={{ src: '/assets/gym-garden.jpg', alt: m.home_stay_img_alt() }}
          />
          <div class="guide-cta">
            <Button href={p('/chiang-mai-guide')} variant="link" arrow>{m.home_guide_link()}</Button>
          </div>
        </div>
      </div>
    </Section>

    {
      (coaches.length > 0 || quote) && (
        <Section soft id="coaches">
          <div class="block-head center">
            <SectionHead center>{m.home_coach_head()}</SectionHead>
            <h2 class="h2 mt-2">{m.home_coach_title()}</h2>
          </div>
          <div class="split split--coaches">
            {coaches.length > 0 && <CoachGrid coaches={coaches} />}
            {/* le blur d'entrée vit dans le composant TestimonialQuote */}
            {quote && (
              <TestimonialQuote
                {...quote}
                ratingLabel={m.testimonial_rating_label({ rating: String(quote.rating) })}
              />
            )}
          </div>
          <div class="coaches-cta">
            <Button href={p('/about/coaches')} variant="link" arrow>{m.home_coaches_link()}</Button>
          </div>
        </Section>
      )
    }

    <Section>
      <div class="block-head row">
        <div>
          <SectionHead>{m.home_comm_head()}</SectionHead>
          <h2 class="h2 mt-2">
            {m.home_comm_title()} <span class="em">{m.home_comm_title_em()}</span>
          </h2>
        </div>
        <a href={instagram} target="_blank" rel="noopener" class="gal-foot">
          <Icon name="tabler:brand-instagram" aria-hidden="true" />
          {m.home_comm_follow()}
        </a>
      </div>
      <InstagramFeed />
    </Section>

    <Section soft id="pricing">
      <div class="block-head center" data-animate="fade-up">
        <SectionHead center>{m.home_price_head()}</SectionHead>
        <h2 class="h2 mt-2 mb-3">{m.home_price_title()}</h2>
        <p class="lead lead--center">{m.home_price_lead()}</p>
      </div>
      <PricingTable plans={plans} popularLabel={m.pricing_popular()} />
    </Section>

    <Section>
      <div class="split split--faq">
        <div data-animate="fade-up">
          <SectionHead>{m.home_faq_head()}</SectionHead>
          <h2 class="h2 mt-2 mb-3">{m.home_faq_title()}</h2>
          <p class="lead">
            {m.home_faq_lead_pre()}
            <a href={p('/contact')} class="faq-link">{m.home_faq_lead_link()}</a>
            {m.home_faq_lead_post()}
          </p>
        </div>
        <Faq items={faqItems} firstOpen />
      </div>
    </Section>

    <CtaBanner
      variant="torn"
      hand={m.home_cta_hand()}
      title={m.home_h1()}
      titleEm={m.home_h1_em()}
      titleAfter={m.home_h1b()}
      sub={m.home_cta_sub()}
      ctaPrimary={{ label: m.home_cta_banner1(), href: `${p('/contact')}?intent=class` }}
      ctaSecondary={{ label: m.home_cta_banner2(), href: waLink(m.contact_wa_text_class()) }}
      image={{ src: '/assets/family-party.webp' }}
    />
  </main>
</BaseLayout>

<style>
  .block-head {
    margin-bottom: 38px;
  }
  .block-head.row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .block-head.center {
    text-align: center;
  }

  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    margin-top: 0;
  }
  .lead--center {
    margin-inline: auto;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 46px;
    align-items: start;
  }
  .split--coaches {
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
  }
  .split--faq {
    grid-template-columns: 0.85fr 1.15fr;
  }

  .gal-foot {
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: 700;
    color: var(--forest);
  }
  .gal-foot :global(svg) {
    width: 20px;
    height: 20px;
  }
  .gal-foot:hover {
    color: var(--gold-deep);
  }
  .gal-foot:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* liens de redistribution home → piliers About & Guide */
  .coaches-cta {
    margin-top: 30px;
    text-align: center;
  }
  .guide-cta {
    margin-top: 18px;
  }

  .faq-link {
    color: var(--gold-deep);
    font-weight: 700;
  }
  .faq-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 860px) {
    .split,
    .split--coaches,
    .split--faq {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
