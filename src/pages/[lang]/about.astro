---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import SplitHero from '../../components/sections/SplitHero.astro';
import Button from '../../components/ui/Button.astro';
import CoachGrid from '../../components/sections/CoachGrid.astro';
import TestimonialQuote from '../../components/sections/TestimonialQuote.astro';
import CommunityGallery from '../../components/sections/CommunityGallery.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import { site } from '../../config/site';
import { localePath } from '../../lib/routes';
import { safeQuery } from '../../lib/content';
import { COACHES_QUERY, FEATURED_TESTIMONIALS_QUERY } from '../../lib/queries';
import type {
  COACHES_QUERY_RESULT,
  FEATURED_TESTIMONIALS_QUERY_RESULT,
} from '../../lib/sanity.types';
import { pickLocale } from '../../lib/i18n-content';
import { urlFor } from '../../lib/image';
import { m } from '../../paraglide/messages.js';

// About — pillar du silo : histoire (familial, woman-run), coachs en teaser
// (#coaches conservé — footer + liens legacy ; la page complète vit sur
// /about/coaches), communauté (#community), avis (#reviews — ancres du mega menu).
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

// Coachs — même fallback trio que la home (rôles/bios via messages)
const coachDocs = await safeQuery<COACHES_QUERY_RESULT>({ query: COACHES_QUERY }, []);
const coaches =
  coachDocs.length > 0
    ? coachDocs.map((coach) => ({
        name: coach.name ?? '',
        role: pickLocale(coach.role, lang),
        bio: pickLocale(coach.bio, lang),
        photo: coach.photo?.asset
          ? {
              src: urlFor(coach.photo).width(280).height(280).format('webp').url(),
              alt: coach.photo.alt ?? coach.name ?? '',
            }
          : undefined,
      }))
    : [
        { name: 'Kru Nut', role: m.home_coach1_role(), bio: m.home_coach1_bio() },
        { name: 'Kru Fern', role: m.home_coach2_role(), bio: m.home_coach2_bio() },
        { name: 'Kru Bank', role: m.home_coach3_role(), bio: m.home_coach3_bio() },
      ];

// Avis (#reviews) — TOUS les témoignages featured ; fallback : 3 quotes messages
// (la section ne doit jamais paraître vide, dataset vide compris).
const testimonialDocs = await safeQuery<FEATURED_TESTIMONIALS_QUERY_RESULT>(
  { query: FEATURED_TESTIMONIALS_QUERY, params: { service: 'general' } },
  [],
);
const reviews =
  testimonialDocs.length > 0
    ? testimonialDocs.map((doc) => ({
        content: pickLocale(doc.content, lang),
        name: doc.name ?? '',
        meta: doc.country ?? undefined,
        rating: doc.rating ?? 5,
      }))
    : [
        { content: m.home_quote_text(), name: 'James T.', meta: m.home_quote_meta(), rating: 5 },
        { content: m.about_reviews_fb1_text(), name: 'Sofia R.', meta: m.about_reviews_fb1_meta(), rating: 5 },
        { content: m.about_reviews_fb2_text(), name: 'Marc D.', meta: m.about_reviews_fb2_meta(), rating: 5 },
      ];
---

<BaseLayout title={m.about_meta_title()} description={m.about_meta_desc()}>
  <main>
    <Breadcrumb
      ariaLabel={m.breadcrumb_aria()}
      items={[
        { label: m.breadcrumb_home(), href: p('/') },
        { label: m.nav_about() },
      ]}
    />

    <SplitHero
      image={{ src: '/assets/family-party.webp', alt: m.about_hero_img_alt(), position: 'center 62%' }}
      eyebrow={m.about_hero_eyebrow()}
      head={m.about_hero_head()}
      title={m.about_hero_title()}
      titleEm={m.about_hero_title_em()}
      lead={m.about_hero_lead()}
      float={{ title: m.about_hero_float_t(), body: m.about_hero_float_b() }}
    />

    <Section soft>
      <div class="story">
        <div>
          <SectionHead>{m.about_story_head()}</SectionHead>
          <h2 class="h2 mt-2 mb-4">
            {m.about_story_title()} <span class="em">{m.about_story_title_em()}</span>
          </h2>
          <p class="body-p">{m.about_story_p1()}</p>
          <p class="body-p">{m.about_story_p2()}</p>
        </div>
        <div class="imgbox">
          {/* l'enseigne dans la végétation — pas de doublon avec la photo famille du hero */}
          <img src="/assets/gym-place.webp" alt={m.home_stay_img_alt()} loading="lazy" />
        </div>
      </div>
    </Section>

    <!-- Coachs en teaser — la page complète vit sur /about/coaches.
         L'id #coaches reste ici (footer + liens legacy). -->
    <Section id="coaches">
      <div class="block-head center">
        <SectionHead center>{m.about_coaches_head()}</SectionHead>
        <h2 class="h2 mt-2 mb-3">{m.about_coaches_title()}</h2>
        <p class="body-p centered">{m.about_coaches_teaser_lead()}</p>
      </div>
      <CoachGrid coaches={coaches.slice(0, 3)} />
      <div class="teaser-cta">
        <Button href={p('/about/coaches')} variant="outline" arrow>
          {m.about_coaches_teaser_cta()}
        </Button>
      </div>
    </Section>

    <Section soft id="community">
      <div class="comm-head">
        <SectionHead>{m.about_comm_head()}</SectionHead>
        <h2 class="h2 mt-2 mb-7">
          {m.about_comm_title()} <span class="em">{m.about_comm_title_em()}</span>
        </h2>
      </div>
      <CommunityGallery count={6} />
    </Section>

    <Section id="reviews">
      <div class="block-head center">
        <SectionHead center>{m.about_reviews_head()}</SectionHead>
        <h2 class="h2 mt-2 mb-3">
          {m.about_reviews_title()} <span class="em">{m.about_reviews_title_em()}</span>
        </h2>
        <p class="body-p centered">{m.about_reviews_lead()}</p>
      </div>
      <div class="reviews">
        {
          reviews.map((review) => (
            <TestimonialQuote
              content={review.content}
              name={review.name}
              meta={review.meta}
              rating={review.rating}
              ratingLabel={m.testimonial_rating_label({ rating: String(review.rating) })}
            />
          ))
        }
      </div>
      <div class="teaser-cta">
        <Button href={site.reviews.googleUrl} variant="outline" arrow>
          {m.about_reviews_google_cta()}
        </Button>
      </div>
    </Section>

    <CtaBanner
      title={m.about_cta_title()}
      titleEm={m.about_cta_title_em()}
      ctaPrimary={{ label: m.cta_book_class(), href: p('/contact') }}
      ctaSecondary={{ label: m.cta_whatsapp(), href: site.contact.whatsapp }}
      image={{ src: '/assets/gym-garden.jpg' }}
    />
  </main>
</BaseLayout>

<style>
  .block-head {
    margin-bottom: 38px;
  }
  .block-head.center {
    text-align: center;
  }
  .body-p {
    font-size: 17px;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 16px;
    max-width: 60ch;
  }
  .body-p.centered {
    margin-inline: auto;
  }
  .story {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 46px;
    align-items: center;
  }
  .imgbox {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    height: 320px;
  }
  .imgbox img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .teaser-cta {
    margin-top: 34px;
    text-align: center;
  }
  /* Avis — grille de quotes (1 seule rangée propre même avec 2-3 avis) */
  .reviews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .story {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
