---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import TornDivider from '../../components/layout/TornDivider.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Card from '../../components/ui/Card.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ProgramGrid from '../../components/sections/ProgramGrid.astro';
import LongStayPackages from '../../components/sections/LongStayPackages.astro';
import DaySchedule from '../../components/sections/DaySchedule.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import { site } from '../../config/site';
import { localePath } from '../../lib/routes';
import { waLink } from '../../lib/whatsapp';
import { m } from '../../paraglide/messages.js';

// Pilier Train (kw : "Muay Thai classes Chiang Mai").
// Anchors #schedule / #pricing : cibles du Nav, du Footer et de la home.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

/* ---------- Programmes (taxonomie du mega menu Train) ---------- */
// Card Beginner → satellite /classes/beginners (lien pillar→satellite structurant,
// ancre dédiée) · card Fight Team → /fighters. Les autres convertissent en
// CTA explicite « Book this class » → form pré-ciblé /contact?intent=class
// (fin du learn-more déguisé qui atterrissait sur un form générique).
const bookClass = `${p('/contact')}?intent=class`;
// Photos réelles du camp (batch 2026-06-06) — alt = titre du programme.
const programs = [
  {
    level: m.classes_prog1_lvl(),
    title: m.classes_prog1_t(),
    body: m.classes_prog1_b(),
    href: p('/classes/beginners'),
    moreLabel: m.classes_prog1_more(),
    image: { src: '/assets/prog-beginners.webp', alt: m.classes_prog1_t(), position: 'center 28%' },
  },
  { level: m.classes_prog2_lvl(), title: m.classes_prog2_t(), body: m.classes_prog2_b(), href: bookClass, moreLabel: m.classes_prog_book(), image: { src: '/assets/prog-all-levels.webp', alt: m.classes_prog2_t(), position: 'center 68%' } },
  { level: m.classes_prog3_lvl(), title: m.classes_prog3_t(), body: m.classes_prog3_b(), href: bookClass, moreLabel: m.classes_prog_book(), image: { src: '/assets/prog-private.webp', alt: m.classes_prog3_t() } },
  { level: m.classes_prog4_lvl(), title: m.classes_prog4_t(), body: m.classes_prog4_b(), href: bookClass, moreLabel: m.classes_prog_book(), image: { src: '/assets/prog-women.webp', alt: m.classes_prog4_t(), position: 'center 22%' } },
  { level: m.classes_prog5_lvl(), title: m.classes_prog5_t(), body: m.classes_prog5_b(), href: bookClass, moreLabel: m.classes_prog_book(), image: { src: '/assets/prog-kids.webp', alt: m.classes_prog5_t() } },
  { level: m.classes_prog6_lvl(), title: m.classes_prog6_t(), body: m.classes_prog6_b(), href: p('/fighters'), image: { src: '/assets/prog-fight-team.webp', alt: m.classes_prog6_t(), position: 'center 32%' } },
];

/* ---------- Planning « journée type » (site.ts, horaires fixes 7j/7) ---------- */
const daySchedule = {
  note: m.schedule_same_every_day(),
  group: {
    title: m.schedule_group_title(),
    subnote: m.schedule_group_sub(),
    times: [...site.schedule.group],
  },
  priv: {
    title: m.schedule_private_title(),
    subnote: m.schedule_private_sub(),
    flexibleLabel: m.schedule_flexible_start(),
    items: site.schedule.private.map((slot) => ({
      time: slot.time,
      flexible: 'flexibleStart' in slot && slot.flexibleStart,
    })),
  },
};

/* ---------- Tarifs publics complets (site.ts, source de vérité) ---------- */
const fmt = (price: number) => price.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US');
const priceLabels: Record<string, string> = {
  dropin: m.pricing_label_dropin(),
  times10: m.pricing_label_times10(),
  month_once: m.pricing_label_month_once(),
  month_unlimited: m.pricing_label_month_unlimited(),
  week_unlimited: m.pricing_label_week_unlimited(),
  fighter_month: m.pricing_label_fighter_month(),
  private_head: m.pricing_label_private_head(),
  private_normal: m.pricing_label_private_normal(),
};
const priceGroups = [
  { title: m.pricing_group_adults(), items: site.pricing.groupAdults },
  { title: m.pricing_group_kids(), items: site.pricing.groupKids },
  { title: m.pricing_group_fighter(), items: site.pricing.fighter },
  { title: m.pricing_group_private(), items: site.pricing.private },
];

const faqItems = [
  { q: m.faq_q1(), a: m.faq_a1() },
  { q: m.faq_q2(), a: m.faq_a2() },
  { q: m.faq_q3(), a: m.faq_a3() },
  { q: m.faq_q4(), a: m.faq_a4() },
  { q: m.faq_q5(), a: m.faq_a5() },
];
---

<BaseLayout title={m.classes_meta_title()} description={m.classes_meta_desc()}>
  <main>
    <Breadcrumb
      ariaLabel={m.breadcrumb_aria()}
      items={[
        { label: m.breadcrumb_home(), href: p('/') },
        { label: m.nav_train() },
      ]}
    />

    <PageHero
      title={m.classes_hero_title()}
      titleEm={m.classes_hero_title_em()}
      lead={m.classes_hero_lead()}
      cta={{ label: m.cta_book_class(), href: bookClass }}
    />

    <Section soft id="programs">
      <SectionHead>{m.classes_prog_head()}</SectionHead>
      <h2 class="h2 mt-2 mb-7">{m.classes_prog_title()}</h2>
      <ProgramGrid programs={programs} moreLabel={m.home_prog_more()} />
    </Section>

    <!-- Le camp — section vibe/ancrage local (gap SERP : personne ne mène
         avec famille + open-air). Géo prudente : adresse exacte [À VÉRIFIER]. -->
    {/* le camp (forest) mord vers le haut sur programs (soft) — wave = open-air/garden */}
    <TornDivider variant="wave-seg-a" color="var(--forest)" bg="var(--soft)" />
    <Section dark id="camp">
      <SectionHead onDark>{m.classes_camp_head()}</SectionHead>
      <h2 class="h2 h2--dark mt-2 mb-3">
        {m.classes_camp_title()} <span class="em on-dark">{m.classes_camp_title_em()}</span>
      </h2>
      <p class="camp-body">{m.classes_camp_body()}</p>
      <p class="camp-body">
        {m.classes_camp_outro()}{' '}
        <a class="ilink ilink--dark" href={p('/about/coaches')}>{m.classes_camp_link_coaches()}</a>{' '}
        {m.classes_camp_outro2()}
      </p>
    </Section>

    {/* le camp (forest) déchire vers le bas sur schedule (cream) */}
    <TornDivider variant="wave-seg-b" color="var(--forest)" flipY />

    <Section id="schedule">
      <SectionHead>{m.classes_sched_head()}</SectionHead>
      <h2 class="h2 mt-2 mb-3">{m.classes_sched_title()}</h2>
      <p class="lead mb-7">{m.classes_sched_lead()}</p>
      <DaySchedule note={daySchedule.note} group={daySchedule.group} priv={daySchedule.priv} />
    </Section>

    <Section soft id="pricing">
      <SectionHead>{m.classes_price_head()}</SectionHead>
      <h2 class="h2 mt-2 mb-3">{m.classes_price_title()}</h2>
      <p class="lead mb-7">{m.classes_price_lead()}</p>
      <div class="price-groups">
        {
          priceGroups.map((group) => (
            <Card padded hover={false}>
              <h3 class="pg-title">{group.title}</h3>
              <ul class="pg-list">
                {group.items.map((item) => (
                  <li>
                    <span>{priceLabels[item.key]}</span>
                    <b>
                      {fmt(item.price)} {site.pricing.currency}
                    </b>
                  </li>
                ))}
              </ul>
            </Card>
          ))
        }
      </div>
      <p class="longstay">
        {m.classes_price_longstay_1()}{' '}
        <a class="ilink" href={p('/stay-train')}>{m.classes_price_link_staytrain()}</a>{' '}
        {m.classes_price_longstay_2()}{' '}
        <a class="ilink" href={p('/dtv-visa/long-stay-training')}>{m.classes_price_link_dtv()}</a>{m.classes_price_longstay_3()}
      </p>
      <div class="mt-7">
        <LongStayPackages lang={lang} />
      </div>
    </Section>

    <Section>
      <div class="faq-split">
        <div>
          <SectionHead>{m.classes_faq_head()}</SectionHead>
          <h2 class="h2 mt-2">{m.classes_faq_title()}</h2>
          <p class="faq-more">
            {m.classes_faq_more()}{' '}
            <a class="ilink" href={p('/classes/beginners')}>{m.classes_faq_link_beg()}</a>.
          </p>
        </div>
        <Faq items={faqItems} firstOpen />
      </div>
    </Section>

    <CtaBanner
      variant="scrapbook"
      hand={m.classes_cta_hand()}
      title={m.classes_cta_title()}
      titleEm={m.classes_cta_title_em()}
      sub={m.classes_cta_sub()}
      ctaPrimary={{ label: m.cta_book_class(), href: bookClass }}
      ctaSecondary={{ label: m.cta_whatsapp(), href: waLink(m.contact_wa_text_class()) }}
      image={{ src: '/assets/gym-garden.jpg' }}
    />
  </main>
</BaseLayout>

<style>
  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    margin-top: 0;
  }
  .h2--dark {
    color: var(--cream);
  }
  .camp-body {
    font-size: 17px;
    color: rgba(246, 241, 230, 0.82);
    line-height: 1.65;
    margin: 0 0 16px;
    max-width: 64ch;
  }
  .longstay {
    margin: 26px 0 0;
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.6;
    max-width: 64ch;
  }
  .faq-more {
    margin: 14px 0 0;
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .ilink {
    color: var(--forest);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-2);
  }
  .ilink:hover {
    color: var(--gold-deep);
    text-decoration-color: var(--gold);
  }
  .ilink--dark {
    color: var(--cream);
    text-decoration-color: rgba(246, 241, 230, 0.45);
  }
  .ilink--dark:hover {
    color: var(--gold);
  }
  .ilink:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .price-groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .pg-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin: 0 0 14px;
  }
  .pg-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .pg-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-size: 15px;
    color: var(--ink-2);
    border-bottom: 1px dashed var(--line);
    padding-bottom: 9px;
  }
  .pg-list li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .pg-list b {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--forest);
    white-space: nowrap;
  }
  .faq-split {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 46px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .price-groups,
    .faq-split {
      grid-template-columns: 1fr;
      gap: 26px;
    }
  }
</style>
