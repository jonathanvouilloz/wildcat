</style>

<script>
  // Accordéon animé (FAQ v2) — même technique que Faq.astro mais SANS
  // exclusivité : la FAQ filtrable doit pouvoir rester multi-ouverte, et
  // FaqSearch pose `open`/`hidden` par programme (reste en snap, voulu).
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const anims = new WeakMap<HTMLDetailsElement, Animation>();

    const panelOf = (d: HTMLDetailsElement) =>
      d.querySelector<HTMLElement>(':scope > [data-faq-panel]');

    const cancelAnim = (d: HTMLDetailsElement) => {
      const a = anims.get(d);
      if (a) {
        a.cancel();
        anims.delete(d);
      }
    };

    function openItem(d: HTMLDetailsElement) {
      const p = panelOf(d);
      if (!p) return;
      const from = anims.has(d) ? p.getBoundingClientRect().height : 0;
      cancelAnim(d);
      d.removeAttribute('data-closing');
      d.setAttribute('open', '');
      if (reduce) return;
      const anim = p.animate(
        [
          { height: `${from}px`, opacity: from > 0 ? 1 : 0.35 },
          { height: `${p.scrollHeight}px`, opacity: 1 },
        ],
        { duration: 300, easing: 'cubic-bezier(0.33, 1, 0.45, 1)' }
      );
      anims.set(d, anim);
      anim.onfinish = () => anims.delete(d);
    }

    function closeItem(d: HTMLDetailsElement) {
      if (!d.hasAttribute('open') || d.hasAttribute('data-closing')) return;
      const p = panelOf(d);
      if (!p) return;
      if (reduce) {
        d.removeAttribute('open');
        return;
      }
      const from = p.getBoundingClientRect().height || p.scrollHeight;
      cancelAnim(d);
      d.setAttribute('data-closing', '');
      const anim = p.animate(
        [
          { height: `${from}px`, opacity: 1 },
          { height: '0px', opacity: 0.3 },
        ],
        { duration: 260, easing: 'cubic-bezier(0.45, 0, 0.55, 1)' }
      );
      anims.set(d, anim);
      anim.onfinish = () => {
        anims.delete(d);
        d.removeAttribute('data-closing');
        d.removeAttribute('open');
      };
    }

    document
      .querySelectorAll<HTMLDetailsElement>('[data-faq-root] details[data-faq-item]')
      .forEach((d) => {
        const summary = d.querySelector(':scope > summary');
        if (!summary) return;
        summary.addEventListener('click', (e) => {
          e.preventDefault();
          const isOpen = d.hasAttribute('open') && !d.hasAttribute('data-closing');
          if (isOpen) closeItem(d);
          else openItem(d);
        });
      });
  })();
</script>
