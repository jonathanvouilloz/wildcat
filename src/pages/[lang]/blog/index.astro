---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/layout/Section.astro';
import Breadcrumb from '../../../components/ui/Breadcrumb.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import CtaBanner from '../../../components/sections/CtaBanner.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import BlogFilters from '../../../components/interactive/BlogFilters.astro';
import { localePath } from '../../../lib/routes';
import { waLink } from '../../../lib/whatsapp';
import { getPostsByLang, getCategoryCounts, BLOG_CATEGORIES } from '../../../lib/blog';
import { toBlogCards, categoryLabels } from '../../../lib/blog-cards';
import { m } from '../../../paraglide/messages.js';

// Page liste du blog (E8) — grille BlogCard filtrable (chips catégories ×
// recherche, BlogFilters). Contenu : Content Collections (src/content/blog),
// zéro article → état "coming soon" (pattern fighters). Pas de pagination V1
// (≤30 articles prévus, filtrage client).
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

const posts = await getPostsByLang(lang);
const counts = await getCategoryCounts(lang);

const catLabels = categoryLabels();
// Chips = catégories non vides uniquement (ordre canonique du schéma).
const categories = BLOG_CATEGORIES.filter((cat) => (counts[cat] ?? 0) > 0).map((cat) => ({
  value: cat as string,
  label: catLabels[cat],
}));

// Covers résolues au build (astro:assets) — BlogCard reste muet (src/alt).
const cards = await toBlogCards(lang, posts);

const whatsapp = waLink(m.contact_wa_text_general());

// JSON-LD Blog — cible du isPartOf des BlogPosting (template article).
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': new URL(`/${lang}/blog`, Astro.site).href,
  name: `${m.blog_hero_title()} ${m.blog_hero_title_em()}`,
  description: m.blog_meta_desc(),
  url: new URL(`/${lang}/blog`, Astro.site).href,
  inLanguage: lang,
};
---

<BaseLayout title={m.blog_meta_title()} description={m.blog_meta_desc()}>
  <script type="application/ld+json" slot="jsonld" is:inline set:html={JSON.stringify(blogSchema)} />
  <main>
    <Breadcrumb
      ariaLabel={m.breadcrumb_aria()}
      items={[{ label: m.breadcrumb_home(), href: p('/') }, { label: m.blog_hero_head() }]}
    />

    <PageHero
      title={m.blog_hero_title()}
      titleEm={m.blog_hero_title_em()}
      lead={m.blog_hero_lead()}
    />

    <Section soft>
      {
        cards.length > 0 ? (
          <>
            <BlogFilters categories={categories} whatsapp={whatsapp} />
            {/* Reveal CARTE PAR CARTE, pas un stagger de conteneur : à 23
                articles le <ul> dépasse 6,7 viewports et ne franchit jamais
                le threshold 0.15 de l'observer (grille invisible sur mobile),
                et le délai cumulé atteignait 1,5 s sur la dernière carte.
                L'attribut reste sur le <li> et jamais sur .bcard, dont la
                racine porte le hover-lift 0.2s que le reveal écraserait.
                data-delay = micro-cascade de rangée (120 ms max en 3 col). */}
            <ul class="blog-grid" data-blog-root>
              {cards.map((card, i) => (
                <li
                  data-blog-item
                  data-animate="fade-up"
                  data-delay={(i % 3) * 0.06}
                  data-category={card.categoryValue}
                >
                  <BlogCard
                    href={card.href}
                    title={card.title}
                    excerpt={card.excerpt}
                    category={card.category}
                    date={card.date}
                    image={card.image}
                  />
                </li>
              ))}
            </ul>
          </>
        ) : (
          <div class="empty">
            <h2 class="h3">{m.blog_empty_title()}</h2>
            <p>{m.blog_empty_body()}</p>
          </div>
        )
      }
    </Section>

    <CtaBanner
      variant="split"
      hand={m.blog_cta_hand()}
      title={m.blog_cta_title()}
      titleEm={m.blog_cta_title_em()}
      sub={m.blog_cta_sub()}
      ctaPrimary={{ label: m.blog_cta_btn(), href: `${p('/contact')}?intent=class` }}
      ctaSecondary={{ label: m.cta_whatsapp(), href: waLink(m.contact_wa_text_class()) }}
      image={{ src: '/assets/family-party.webp' }}
    />
  </main>
</BaseLayout>

<style>
  .blog-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  @media (max-width: 1024px) {
    .blog-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
  .empty {
    text-align: center;
    padding: 26px 0;
  }
  .empty p {
    margin: 10px auto 0;
    max-width: 48ch;
    font-size: 16px;
    color: var(--ink-2);
  }
</style>
