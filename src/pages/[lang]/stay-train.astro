---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/layout/Section.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import DtvStamp from '../../components/ui/DtvStamp.astro';
import PageHero from '../../components/sections/PageHero.astro';
import FeatureGrid from '../../components/sections/FeatureGrid.astro';
import PricingTable from '../../components/sections/PricingTable.astro';
import TestimonialQuote from '../../components/sections/TestimonialQuote.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import { site } from '../../config/site';
import { localePath } from '../../lib/routes';
import { safeQuery } from '../../lib/content';
import { FEATURED_TESTIMONIALS_QUERY } from '../../lib/queries';
import type { FEATURED_TESTIMONIALS_QUERY_RESULT } from '../../lib/sanity.types';
import { pickLocale } from '../../lib/i18n-content';
import { m } from '../../paraglide/messages.js';

// Pilier Stay & Train (kw : "Muay Thai training camp Chiang Mai").
// NB : le PRD nommait ce pilier /muay-thai-training — slug maquette retenu,
// redirect à prévoir en E7/E10.
export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

// Témoignage training — uniquement si présent en CMS
const testimonialDocs = await safeQuery<FEATURED_TESTIMONIALS_QUERY_RESULT>(
  { query: FEATURED_TESTIMONIALS_QUERY, params: { service: 'training' } },
  [],
);
const quote = testimonialDocs[0]
  ? {
      content: pickLocale(testimonialDocs[0].content, lang),
      name: testimonialDocs[0].name ?? '',
      meta: testimonialDocs[0].country ?? undefined,
      rating: testimonialDocs[0].rating ?? 5,
    }
  : null;

const features = [
  { icon: 'tabler:calendar-event', title: m.stay_feat1_t(), body: m.stay_feat1_b() },
  { icon: 'tabler:leaf', title: m.stay_feat2_t(), body: m.stay_feat2_b() },
  { icon: 'tabler:motorbike', title: m.stay_feat3_t(), body: m.stay_feat3_b() },
  { icon: 'tabler:bed', title: m.stay_feat4_t(), body: m.stay_feat4_b() },
];

// Formules orientées séjour — prix réels site.ts, formatés par locale
const fmt = (price: number) => price.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US');
const priceOf = (list: readonly { key: string; price: number }[], key: string) =>
  list.find((item) => item.key === key)?.price ?? 0;
const plans = [
  {
    name: m.pricing_card_week_name(),
    price: fmt(priceOf(site.pricing.groupAdults, 'week_unlimited')),
    currency: site.pricing.currency,
    unit: m.pricing_card_week_unit(),
    features: [
      m.pricing_card_week_f1(),
      m.pricing_card_week_f2(),
      m.pricing_card_week_f3(),
      m.pricing_card_week_f4(),
    ],
    cta: { label: m.cta_book_class(), href: p('/contact'), variant: 'outline' as const },
  },
  {
    name: m.pricing_card_monthly_name(),
    price: fmt(priceOf(site.pricing.groupAdults, 'month_unlimited')),
    currency: site.pricing.currency,
    unit: m.pricing_card_monthly_unit(),
    features: [
      m.pricing_card_monthly_f1(),
      m.pricing_card_monthly_f2(),
      m.pricing_card_monthly_f3(),
      m.pricing_card_monthly_f4(),
    ],
    cta: { label: m.pricing_card_monthly_cta(), href: p('/contact'), variant: 'gold' as const },
    popular: true,
  },
  {
    name: m.pricing_card_fighter_name(),
    price: fmt(priceOf(site.pricing.fighter, 'fighter_month')),
    currency: site.pricing.currency,
    unit: m.pricing_card_fighter_unit(),
    features: [
      m.pricing_card_fighter_f1(),
      m.pricing_card_fighter_f2(),
      m.pricing_card_fighter_f3(),
      m.pricing_card_fighter_f4(),
    ],
    cta: { label: m.cta_plan_stay(), href: p('/contact'), variant: 'forest' as const },
  },
];
---

<BaseLayout title={m.stay_meta_title()} description={m.stay_meta_desc()}>
  <main>
    <Breadcrumb
      ariaLabel={m.breadcrumb_aria()}
      items={[
        { label: m.breadcrumb_home(), href: p('/') },
        { label: m.nav_stay() },
      ]}
    />

    <PageHero
      head={m.stay_hero_head()}
      title={m.stay_hero_title()}
      titleEm={m.stay_hero_title_em()}
      lead={m.stay_hero_lead()}
      cta={{ label: m.cta_plan_stay(), href: p('/contact') }}
    />

    <Section soft>
      <div class="why">
        <div>
          <SectionHead>{m.stay_why_head()}</SectionHead>
          <h2 class="h2 mt-2 mb-7">{m.stay_why_title()}</h2>
        </div>
      </div>
      <FeatureGrid items={features} />
      <p class="beg-note">
        {m.stay_beg_note()}{' '}
        <a class="ilink" href={p('/classes/beginners')}>{m.stay_beg_link()}</a>.
      </p>
      <div class="imgbox">
        {/* session du soir — la vie du camp pour les long-stayers (gym-garden reste à la home) */}
        <img src="/assets/night-session.webp" alt={m.home_stay_img_alt()} loading="lazy" />
      </div>
    </Section>

    <Section id="pricing">
      <div class="block-head center">
        <SectionHead center>{m.stay_price_head()}</SectionHead>
        <h2 class="h2 mt-2 mb-3">{m.stay_price_title()}</h2>
        <p class="lead lead--center">{m.stay_price_lead()}</p>
      </div>
      <PricingTable plans={plans} popularLabel={m.pricing_popular()} />
    </Section>

    <Section dark>
      <div class="dtv-cross">
        <DtvStamp size={170} />
        <div>
          <SectionHead onDark>{m.stay_dtv_head()}</SectionHead>
          <h2 class="h2 h2--dark mt-2 mb-3">
            {m.stay_dtv_title()} <span class="em on-dark">{m.stay_dtv_title_em()}</span>
          </h2>
          <p class="dtv-body">{m.stay_dtv_body()}</p>
          <div class="mt-6">
            <Button href={p('/dtv-visa')} variant="gold" arrow>{m.stay_dtv_cta()}</Button>
          </div>
        </div>
      </div>
    </Section>

    {
      quote && (
        <Section>
          <div class="quote-wrap">
            <TestimonialQuote
              content={quote.content}
              name={quote.name}
              meta={quote.meta}
              rating={quote.rating}
              ratingLabel={m.testimonial_rating_label({ rating: String(quote.rating) })}
            />
          </div>
        </Section>
      )
    }

    <CtaBanner
      title={m.stay_cta_title()}
      titleEm={m.stay_cta_title_em()}
      ctaPrimary={{ label: m.cta_plan_stay(), href: p('/contact') }}
      ctaSecondary={{ label: m.cta_whatsapp(), href: site.contact.whatsapp }}
      image={{ src: '/assets/gym-garden.jpg' }}
    />
  </main>
</BaseLayout>

<style>
  .block-head {
    margin-bottom: 38px;
  }
  .block-head.center {
    text-align: center;
  }
  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    margin-top: 0;
  }
  .lead--center {
    margin-inline: auto;
  }
  .beg-note {
    margin: 22px 0 0;
    font-size: 16px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .ilink {
    color: var(--forest);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line-2);
  }
  .ilink:hover {
    color: var(--gold-deep);
    text-decoration-color: var(--gold);
  }
  .ilink:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .imgbox {
    margin-top: 28px;
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    height: clamp(240px, 38vw, 420px);
  }
  .imgbox img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .h2--dark {
    color: var(--cream);
  }
  .dtv-cross {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 48px;
    align-items: center;
  }
  .dtv-body {
    font-size: 17px;
    color: rgba(246, 241, 230, 0.78);
    max-width: 54ch;
    margin: 0;
  }
  .quote-wrap {
    max-width: 760px;
    margin-inline: auto;
  }
  @media (max-width: 860px) {
    .dtv-cross {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
