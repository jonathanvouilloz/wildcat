---
import Button from '../ui/Button.astro';

/**
 * SplitHero — hero split direction C du styleguide (« évolution douce ») :
 * texte sur cream à gauche (lisibilité maximale, zéro overlay), photo
 * full-height jusqu'au bord droit, callout forest flottant optionnel.
 * Pas de Container : la colonne copy aligne son bord gauche sur celui du
 * Container via max(gutter, (100vw - maxw)/2), la photo file au bord.
 * Plein viewport (2026-06-06) : la photo va de la nav au bord bas de l'écran ;
 * le Breadcrumb s'intègre via le slot `crumbs` + prop `overlay` (même système
 * que PageHero full) — plus de bande cream dédiée au-dessus. Utilisé sur /about.
 */
export interface Props {
  title: string;
  titleEm?: string;
  lead: string;
  eyebrow?: string;
  cta?: { label: string; href: string };
  image: { src: string; alt: string; position?: string };
  float?: { title: string; body: string };
}
const { title, titleEm, lead, eyebrow, cta, image, float } = Astro.props;
---

<section class="split-hero">
  {
    Astro.slots.has('crumbs') && (
      <div class="sh-crumbs">
        <slot name="crumbs" />
      </div>
    )
  }
  {/* Entrée au load — chorégraphie scoped sur la colonne copy uniquement :
      la photo (LCP) reste statique, le callout float arrive en dernier. */}
  <div class="copy" data-animate="hero" data-animate-load>
    {eyebrow && <p class="eyebrow"><span class="em">{eyebrow}</span></p>}
    <h1 class="h1">
      {title}
      {titleEm && ' '}{titleEm && <span class="em">{titleEm}</span>}
    </h1>
    <p class="lead">{lead}</p>
    {
      cta && (
        <div class="cta">
          <Button href={cta.href} variant="gold" arrow>
            {cta.label}
          </Button>
        </div>
      )
    }
  </div>
  <div class="media">
    {/* LCP de la page → fetchpriority high */}
    <img
      src={image.src}
      alt={image.alt}
      fetchpriority="high"
      style={image.position && `object-position:${image.position}`}
    />
    {
      float && (
        <div class="float" data-animate="scale" data-animate-load data-delay="0.6">
          <div class="t">{float.title}</div>
          <div class="d">{float.body}</div>
        </div>
      )
    }
  </div>
</section>

<style>
  .split-hero {
    position: relative;
    background: var(--cream);
    display: grid;
    grid-template-columns: 1.04fr 1fr;
    align-items: center;
    gap: clamp(24px, 4vw, 46px);
    /* plein viewport : 100svh − chrome (utility bar 38px + nav sticky 74px) —
       la photo touche le bas de l'écran au chargement */
    min-height: 100vh; /* fallback */
    min-height: calc(100svh - 112px);
  }
  /* breadcrumb intégré (slot crumbs) — flotte en haut du hero, pas de bande */
  .sh-crumbs {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
  }
  .copy {
    /* bord gauche aligné sur le Container, photo full-bleed à droite */
    padding: clamp(48px, 7vh, 96px) 0 clamp(48px, 7vh, 96px)
      max(var(--gutter), calc((100vw - var(--maxw)) / 2));
  }
  .eyebrow {
    font-size: clamp(17px, 1.6vw, 21px);
    margin: 0 0 10px;
  }
  /* H1 de hero : un cran au-dessus du .h1 global (56px max), sous la home (92px).
     Pas de kicker ◆ CAPS en hero (redondant avec le breadcrumb) → margin-top 0. */
  .h1 {
    margin: 0 0 16px;
    font-size: clamp(40px, 5.6vw, 68px);
  }
  .lead {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--ink-2);
    max-width: 46ch;
    margin: 0;
  }
  .cta {
    margin-top: 26px;
  }
  .media {
    position: relative;
    align-self: stretch;
    /* la hauteur vient du parent (plein viewport) — min de secours seulement */
    min-height: 420px;
  }
  .media > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* callout forest flottant — mord le bord gauche de la photo */
  .float {
    position: absolute;
    left: -18px;
    bottom: 26px;
    background: var(--forest);
    color: var(--cream);
    border-radius: var(--r-md);
    padding: 14px 18px;
    box-shadow: var(--shadow-lg);
    max-width: 230px;
  }
  .float .t {
    color: var(--gold);
    font-weight: 800;
    font-size: 15px;
    margin-bottom: 2px;
  }
  .float .d {
    font-size: 12.5px;
    color: rgba(246, 241, 230, 0.8);
    line-height: 1.4;
  }
  /* ------------------------------------------------------------
     Entrée au load (gated html.wc-anim — no-JS : tout visible).
     Transitions sur .in-view UNIQUEMENT (règle motion.css).
     Cascade : eyebrow 0.05s · H1 0.1s · lead 0.28s · CTA 0.42s
     (le float, sur la photo, suit à 0.6s via data-delay).
     ------------------------------------------------------------ */
  :global(html.wc-anim) .copy :is(.eyebrow, .h1, .lead, .cta) {
    opacity: 0;
    transform: translateY(16px);
  }
  :global(html.wc-anim) .copy.in-view :is(.eyebrow, .h1, .lead, .cta) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out-strong),
      transform 0.6s var(--ease-out-strong);
  }
  :global(html.wc-anim) .copy.in-view .eyebrow {
    transition-delay: 0.05s;
  }
  :global(html.wc-anim) .copy.in-view .h1 {
    transition-delay: 0.1s;
  }
  :global(html.wc-anim) .copy.in-view .lead {
    transition-delay: 0.28s;
  }
  :global(html.wc-anim) .copy.in-view .cta {
    transition-delay: 0.42s;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.wc-anim) .copy :is(.eyebrow, .h1, .lead, .cta) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .split-hero {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: 0; /* stacked : pas de plein viewport forcé */
    }
    .copy {
      /* top : place pour le breadcrumb overlay (stacked = plus de centrage) */
      padding: clamp(56px, 9vw, 72px) var(--gutter) clamp(28px, 5vw, 40px);
    }
    .media {
      min-height: 300px;
    }
    .float {
      left: 12px;
      bottom: 14px;
    }
  }
</style>
