---
import { Icon } from 'astro-icon/components';
import Field from '../ui/forms/Field.astro';
import Input from '../ui/forms/Input.astro';
import Select from '../ui/forms/Select.astro';
import Textarea from '../ui/forms/Textarea.astro';
import Checkbox from '../ui/forms/Checkbox.astro';
import Button from '../ui/Button.astro';
import WhatsappSubmitModal from './WhatsappSubmitModal.astro';
import { site } from '../../config/site';
import { waLink } from '../../lib/whatsapp';
import { m } from '../../paraglide/messages.js';

/**
 * ContactForm v2 — formulaire *intent-driven* (POST direct Web3Forms,
 * décision 2026-06-05 : zéro backend, site 100 % statique).
 * - 5 intentions en radios stylées cards (class/stay/scooter/dtv/general) ;
 *   les champs contextuels par intention sont togglés en pur CSS `:has()`
 *   → fonctionne sans JS. Champs contextuels jamais `required` (un champ
 *   caché requis bloquerait le submit).
 * - `?intent=` (+ legacy `?topic=`) présélectionne la card via un mini script.
 * - Sujet email pré-qualifié : champ caché `subject` mis à jour par intention
 *   (JS) ; fallback no-JS = sujet générique. Au submit, les champs des
 *   intentions non actives sont `disabled` (non soumis) → email propre ;
 *   fallback no-JS = tous les champs partent (verbeux mais fonctionnel).
 * - Fast lane WhatsApp : lien wa.me pré-rempli, re-câblé par intention en JS
 *   (fallback no-JS : texte « general »).
 * - Honeypot `botcheck` natif Web3Forms ; `redirect` → retour ?sent=1.
 * - Clé absente (PUBLIC_WEB3FORMS_KEY) : warning build, le form reste rendu
 *   (Web3Forms rejettera) — même philosophie que HelpfulWidget.
 */
/*
 * Multistep (2026-10-16) : 1. le besoin → 2. les détails de l'intention
 * (sautée pour « general ») → 3. les coordonnées. Le découpage est posé par le
 * script (`data-ms` sur le form) : sans JS, les 3 étapes s'affichent d'un bloc,
 * comme avant. `intent` (ou ?intent=) présélectionne et démarre à l'étape 2.
 * Après envoi, le modal propose des pages/articles selon l'intention (recoKey).
 */
export interface Props {
  lang: string;
  intent?: 'class' | 'stay' | 'scooter' | 'dtv' | 'general';
}
const { lang, intent } = Astro.props;

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
if (!accessKey) console.warn('[ContactForm] PUBLIC_WEB3FORMS_KEY missing — submissions will fail.');
// Web3Forms exige une URL absolue (Astro.site = domaine de prod).
const redirectUrl = new URL(`/${lang}/contact?sent=1`, Astro.site).href;

const intents = [
  { value: 'class', icon: 'tabler:karate', label: m.contact_intent_class() },
  { value: 'stay', icon: 'tabler:bed', label: m.contact_intent_stay() },
  { value: 'scooter', icon: 'tabler:motorbike', label: m.contact_intent_scooter() },
  { value: 'dtv', icon: 'tabler:id', label: m.contact_intent_dtv() },
  { value: 'general', icon: 'tabler:message-circle', label: m.contact_intent_general() },
];

const levelOptions = [
  { value: 'first-time', label: m.contact_cls_level_first() },
  { value: 'some-experience', label: m.contact_cls_level_some() },
  { value: 'experienced', label: m.contact_cls_level_exp() },
];
const durationOptions = [
  { value: '1-week', label: m.contact_stay_dur_1w() },
  { value: '1-2-weeks', label: m.contact_stay_dur_2w() },
  { value: '1-month', label: m.contact_stay_dur_1m() },
  { value: '2-3-months', label: m.contact_stay_dur_3m() },
  { value: '6-months-plus', label: m.contact_stay_dur_6m() },
];
const peopleOptions = ['1', '2', '3', '4', '5+'].map((v) => ({ value: v, label: v }));
// Modèles réels de la flotte (site.ts) + « pas encore décidé ».
const modelOptions = [
  ...site.scooterFleet.map((s) => ({ value: s.key, label: s.name })),
  { value: 'not-sure', label: m.contact_sct_model_any() },
];
// Qualifieur de forfait (2026-08-20) : depuis que les 4 forfaits long-stay ont
// laissé place à l'offre unique, la vraie question est « tout compris ou
// entraînement seul ? ». Affiché pour l’intention stay (la DTV pose la question en radios).
// Label = nom · prix (séparateur ·, pas d'em-dash).
const fmt = (n: number) => n.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US');
const packageOptions = [
  {
    value: site.pricing.stayTrain.key,
    label: `${m.contact_dtv_pkg_stay()} · ${fmt(site.pricing.stayTrain.price)} ${site.pricing.currency}`,
  },
  { value: 'training_only', label: m.contact_dtv_pkg_training() },
];

const dtvDurationOptions = [
  { value: '1-3-months', label: m.contact_dtv_dur_short() },
  { value: '3-6-months', label: m.contact_dtv_dur_mid() },
  { value: '6-months-plus', label: m.contact_dtv_dur_long() },
  { value: 'not-sure', label: m.contact_dtv_dur_unsure() },
];

// Textes wa.me pré-remplis par intention (le script swap le href ; fallback
// no-JS = texte general).
const waTexts: Record<string, string> = {
  class: m.contact_wa_text_class(),
  stay: m.contact_wa_text_stay(),
  scooter: m.contact_wa_text_scooter(),
  dtv: m.contact_wa_text_dtv(),
  general: m.contact_wa_text_general(),
};
---

<form method="POST" action="https://api.web3forms.com/submit" class="cform" data-cform data-preset={intent}>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="redirect" value={redirectUrl} />
  <input type="hidden" name="subject" value="[Wildcat] Website contact" data-subject />
  <input type="hidden" name="from_name" value="Wildcat Website" />
  <input type="hidden" name="lang" value={lang} />
  <!-- honeypot Web3Forms — invisible pour les humains, coché par les bots -->
  <div class="hp" aria-hidden="true">
    <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
  </div>

  <div class="ms-head">
    <p
      class="ms-count"
      aria-live="polite"
      data-ms-count
      data-1={m.contact_step_progress({ n: '1' })}
      data-2={m.contact_step_progress({ n: '2' })}
      data-3={m.contact_step_progress({ n: '3' })}
    >
      {m.contact_step_progress({ n: '1' })}
    </p>
    <div class="ms-bar" aria-hidden="true"><span data-ms-bar></span></div>
  </div>

  <!-- Étape 1 — le besoin -->
  <div class="step" data-step="1">
    <fieldset class="intents">
      <legend class="intents-legend step-t" tabindex="-1">{m.contact_intent_legend()}</legend>
      <div class="intents-grid">
        {
          intents.map((it) => (
            <label class="icard">
              <input
                type="radio"
                name="intent"
                value={it.value}
                checked={it.value === (intent ?? 'general')}
              />
              <Icon name={it.icon} class="icard-ic" aria-hidden="true" />
              <span class="icard-lb">{it.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="step-nav">
      <button type="button" class="step-btn step-btn--next" data-next>{m.contact_step_next()}</button>
    </div>
  </div>

  <!-- Étape 2 — les détails de l'intention (sautée pour « general ») -->
  <div class="step" data-step="2">
    <div>
      <p class="step-t" tabindex="-1">{m.contact_step2_title()}</p>
      <p class="step-hint">{m.contact_step2_hint()}</p>
    </div>

  <!-- Champs contextuels — affichés par :has() selon l'intention cochée -->
  <div class="xtra" data-i="class">
    <div class="pair">
      <Field label={m.contact_cls_date()} for="ct-cls-date" helper={m.contact_cls_date_help()}>
        <Input id="ct-cls-date" name="cls_date" type="date" />
      </Field>
      <Field label={m.contact_cls_level()} for="ct-cls-level">
        <Select id="ct-cls-level" name="cls_level" placeholder={m.contact_form_choose_ph()} options={levelOptions} />
      </Field>
    </div>
  </div>

  <div class="xtra" data-i="stay">
    <div class="pair">
      <Field label={m.contact_stay_arrival()} for="ct-stay-arrival">
        <Input id="ct-stay-arrival" name="stay_arrival" type="date" />
      </Field>
      <Field label={m.contact_stay_duration()} for="ct-stay-duration">
        <Select
          id="ct-stay-duration"
          name="stay_duration"
          placeholder={m.contact_form_choose_ph()}
          options={durationOptions}
        />
      </Field>
    </div>
    <Field label={m.contact_stay_people()} for="ct-stay-people" class="narrow">
      <Select id="ct-stay-people" name="stay_people" placeholder={m.contact_form_choose_ph()} options={peopleOptions} />
    </Field>
    <div class="checks">
      <Checkbox name="stay_acc" value="yes">{m.contact_stay_acc()}</Checkbox>
      <Checkbox name="stay_scoot" value="yes">{m.contact_stay_scoot()}</Checkbox>
    </div>
  </div>

  <div class="xtra" data-i="scooter">
    <div class="pair">
      <Field label={m.contact_sct_from()} for="ct-sct-from">
        <Input id="ct-sct-from" name="sct_from" type="date" />
      </Field>
      <Field label={m.contact_sct_to()} for="ct-sct-to">
        <Input id="ct-sct-to" name="sct_to" type="date" />
      </Field>
    </div>
    <Field label={m.contact_sct_model()} for="ct-sct-model" class="narrow">
      <Select id="ct-sct-model" name="sct_model" placeholder={m.contact_form_choose_ph()} options={modelOptions} />
    </Field>
  </div>

  <div class="xtra" data-i="stay">
    <Field label={m.contact_dtv_package()} for="ct-dtv-package" class="narrow">
      <Select id="ct-dtv-package" name="dtv_package" placeholder={m.contact_form_choose_ph()} options={packageOptions} />
    </Field>
  </div>

  <!-- DTV (2026-10-16) : les infos dont Meaw a besoin pour répondre sur le visa.
       Pas de question « d'où fais-tu la demande » : c'est forcément depuis son pays. -->
  <div class="xtra" data-i="dtv">
    <p class="dtv-note">{m.contact_dtv_note()}</p>
    <div class="pair">
      <Field label={m.contact_dtv_nationality()} for="ct-dtv-nat">
        <Input id="ct-dtv-nat" name="dtv_nationality" placeholder={m.contact_dtv_nationality_ph()} />
      </Field>
      <Field label={m.contact_dtv_arrival()} for="ct-dtv-arrival">
        <Input id="ct-dtv-arrival" name="dtv_arrival" type="date" />
      </Field>
    </div>
    <Field label={m.contact_dtv_duration()} for="ct-dtv-duration" class="narrow">
      <Select
        id="ct-dtv-duration"
        name="dtv_duration"
        placeholder={m.contact_form_choose_ph()}
        options={dtvDurationOptions}
      />
    </Field>
    <fieldset class="choices">
      <legend>{m.contact_dtv_stay()}</legend>
      <label class="choice">
        <input type="radio" name="dtv_stay" value={site.pricing.stayTrain.key} />
        <span>{m.contact_dtv_stay_wildcat({ price: `${fmt(site.pricing.stayTrain.price)} ${site.pricing.currency}` })}</span>
      </label>
      <label class="choice">
        <input type="radio" name="dtv_stay" value="training_only" />
        <span>{m.contact_dtv_stay_own()}</span>
      </label>
    </fieldset>
  </div>

    <div class="step-nav">
      <button type="button" class="step-btn" data-back>{m.contact_step_back()}</button>
      <button type="button" class="step-btn step-btn--next" data-next>{m.contact_step_next()}</button>
    </div>
  </div>

  <!-- Étape 3 — les coordonnées -->
  <div class="step" data-step="3">
    <p class="step-t" tabindex="-1">{m.contact_step3_title()}</p>
    <div class="pair">
      <Field label={m.contact_form_name()} for="ct-name" required>
        <Input id="ct-name" name="name" placeholder={m.contact_form_name_ph()} autocomplete="name" required />
      </Field>
      <Field label={m.contact_form_email()} for="ct-email" required>
        <Input
          id="ct-email"
          name="email"
          type="email"
          placeholder={m.contact_form_email_ph()}
          autocomplete="email"
          required
        />
      </Field>
    </div>

    <Field label={m.contact_form_phone()} for="ct-phone" class="narrow">
      <Input id="ct-phone" name="phone" type="tel" placeholder={m.contact_form_phone_ph()} autocomplete="tel" />
    </Field>

    <!-- requis sans JS ; avec JS, requis seulement pour « general » (les autres
         intentions ont déjà leurs champs structurés) -->
    <Field label={m.contact_form_msg()} for="ct-msg">
      <Textarea id="ct-msg" name="message" rows={5} placeholder={m.contact_form_msg_ph()} required />
    </Field>
    <Checkbox name="consent" required>{m.contact_form_consent()}</Checkbox>

    <div class="step-nav">
      <button type="button" class="step-btn" data-back>{m.contact_step_back()}</button>
      <Button type="submit" variant="gold" arrow>{m.contact_form_submit()}</Button>
    </div>
  </div>

  <!-- Fast lane WhatsApp — pré-rempli selon l'intention cochée -->
  <div
    class="wa"
    data-wa
    data-wa-base={site.contact.whatsapp}
    data-wa-class={waTexts.class}
    data-wa-stay={waTexts.stay}
    data-wa-scooter={waTexts.scooter}
    data-wa-dtv={waTexts.dtv}
    data-wa-general={waTexts.general}
  >
    <Icon name="tabler:brand-whatsapp" class="wa-ic" aria-hidden="true" />
    <div class="wa-tx">
      <b>{m.contact_wa_title()}</b>
      <p>{m.contact_wa_body()}</p>
    </div>
    <Button href={waLink(waTexts.general)} variant="outline" target="_blank" rel="noopener">
      {m.cta_whatsapp()}
    </Button>
  </div>
</form>

<WhatsappSubmitModal />


<script>
  // Présélection ?intent= (+ legacy ?topic=), sujet email pré-qualifié,
  // re-câblage du lien WhatsApp statique, et au submit : ouverture WhatsApp
  // pré-remplie + email en tâche de fond (voir src/scripts/wa-form.ts). Tout
  // fonctionne sans ce script — il n'apporte que le confort (deep links, texte
  // wa.me contextualisé, email plus propre côté Meaw). Sans JS, le POST natif
  // envoie l'email et le bouton WhatsApp statique reste le secours.
  import { submitViaWhatsApp, fieldValue, selectText, isChecked, minToday } from '../../scripts/wa-form';

  const LEGACY: Record<string, string> = { classes: 'class', other: 'general' };
  // Sujets email internes (EN, pour Meaw) — ex-labels de l'API /api/contact.
  const SUBJECTS: Record<string, string> = {
    class: 'Class booking',
    stay: 'Stay & Train',
    scooter: 'Scooter rental',
    dtv: 'DTV visa',
    general: 'General',
  };

  document.querySelectorAll<HTMLFormElement>('form[data-cform]').forEach((form) => {
    const params = new URLSearchParams(location.search);
    const pkg = params.get('package');
    // ?package= implique l'intention stay (le select forfait ne vit plus que là ;
    // la DTV demande le logement en radios, 2026-10-16).
    const raw = params.get('intent') ?? params.get('topic') ?? (pkg ? 'stay' : null);
    if (raw) {
      const want = LEGACY[raw] ?? raw;
      const radio = form.querySelector<HTMLInputElement>(`input[name="intent"][value="${want}"]`);
      // defaultChecked aussi : form.reset() (fermeture du modal) garde l'intention.
      if (radio) radio.checked = radio.defaultChecked = true;
    }
    // Saut direct à l'étape 2 : formulaires intégrés aux pages (prop intent) seulement.
    // ?intent= (CTA du menu, toujours présent) présélectionne la carte sans sauter l'étape 1.
    const preset = Boolean(form.dataset.preset);
    // Pré-sélectionne le forfait dans le dropdown stay s'il existe.
    if (pkg) {
      const sel = form.querySelector<HTMLSelectElement>('select[name="dtv_package"]');
      if (sel && [...sel.options].some((o) => o.value === pkg)) sel.value = pkg;
    }

    const checkedIntent = () =>
      form.querySelector<HTMLInputElement>('input[name="intent"]:checked')?.value ?? 'general';

    const wrap = form.querySelector<HTMLElement>('[data-wa]');
    const link = wrap?.querySelector<HTMLAnchorElement>('a');
    const base = wrap?.dataset.waBase;
    const subject = form.querySelector<HTMLInputElement>('input[data-subject]');

    const update = () => {
      const v = checkedIntent();
      if (msg) msg.required = v === 'general';
      if (subject && SUBJECTS[v]) subject.value = `[Wildcat] ${SUBJECTS[v]}`;
      const text = wrap?.dataset['wa' + v[0].toUpperCase() + v.slice(1)];
      if (wrap && link && base && text) link.href = `${base}?text=${encodeURIComponent(text)}`;
    };
    // ---- Multistep ----
    const steps = [...form.querySelectorAll<HTMLElement>('.step')];
    const bar = form.querySelector<HTMLElement>('[data-ms-bar]');
    const count = form.querySelector<HTMLElement>('[data-ms-count]');
    const msg = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 1;
    const isGeneral = () => checkedIntent() === 'general';
    const show = (n: number, focus = true) => {
      cur = n;
      steps.forEach((s) => (s.hidden = Number(s.dataset.step) !== n));
      if (bar) bar.style.width = `${(n / 3) * 100}%`;
      if (count) count.textContent = count.dataset[n] ?? '';
      if (!focus) return;
      if (form.getBoundingClientRect().top < 0)
        form.scrollIntoView({ block: 'start', behavior: reduced ? 'auto' : 'smooth' });
      steps[n - 1]?.querySelector<HTMLElement>('.step-t')?.focus({ preventScroll: true });
    };
    const next = () => show(cur === 1 && !isGeneral() ? 2 : 3);
    const back = () => show(cur === 3 && !isGeneral() ? 2 : 1);
    const startStep = () => (preset ? (isGeneral() ? 3 : 2) : 1);

    form.dataset.ms = '';
    minToday(form);
    const sctFrom = form.querySelector<HTMLInputElement>('input[name="sct_from"]');
    const sctTo = form.querySelector<HTMLInputElement>('input[name="sct_to"]');
    sctFrom?.addEventListener('change', () => sctTo && (sctTo.min = sctFrom.value || sctTo.min));
    form.querySelectorAll('[data-next]').forEach((b) => b.addEventListener('click', next));
    form.querySelectorAll('[data-back]').forEach((b) => b.addEventListener('click', back));
    // Clic souris/tactile sur une card = on avance (le clavier garde « Suivant » :
    // les flèches changent la radio sans sauter d'étape).
    form.querySelector('.intents-grid')?.addEventListener('pointerup', (e) => {
      if ((e.target as HTMLElement).closest('.icard')) setTimeout(next, 160);
    });
    // Entrée avant l'étape 3 = étape suivante (sinon le navigateur tente un
    // submit bloqué par les champs requis cachés de l'étape 3).
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key !== 'Enter' || cur === 3 || t.tagName === 'TEXTAREA' || t.tagName === 'BUTTON') return;
      e.preventDefault();
      next();
    });
    form.addEventListener('reset', () =>
      setTimeout(() => {
        update();
        show(startStep(), false);
      }),
    );

    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'intent') update();
    });
    update();
    show(startStep(), false);

    // Message WhatsApp lisible, construit depuis les champs remplis (EN dans
    // les 2 locales — équipe anglophone). Lu AVANT le disable des .xtra.
    const buildText = (f: HTMLFormElement) => {
      const intent = checkedIntent();
      const lines = [`Hi Wildcat! (${SUBJECTS[intent] ?? 'General'})`];
      const name = fieldValue(f, 'name');
      const email = fieldValue(f, 'email');
      const phone = fieldValue(f, 'phone');
      if (name) lines.push(`Name: ${name}`);
      if (email) lines.push(`Email: ${email}`);
      if (phone) lines.push(`Phone: ${phone}`);

      if (intent === 'class') {
        const bits: string[] = [];
        const level = selectText(f, 'cls_level');
        const date = fieldValue(f, 'cls_date');
        if (level) bits.push(level);
        if (date) bits.push(`preferred date ${date}`);
        if (bits.length) lines.push(`Class: ${bits.join(', ')}`);
      } else if (intent === 'stay') {
        const bits: string[] = [];
        const arrival = fieldValue(f, 'stay_arrival');
        const duration = selectText(f, 'stay_duration');
        const people = fieldValue(f, 'stay_people');
        if (arrival) bits.push(`arriving ${arrival}`);
        if (duration) bits.push(duration);
        if (people) bits.push(`${people} ${people === '1' ? 'person' : 'people'}`);
        if (bits.length) lines.push(`Stay: ${bits.join(', ')}`);
        const extras: string[] = [];
        if (isChecked(f, 'stay_acc')) extras.push('accommodation');
        if (isChecked(f, 'stay_scoot')) extras.push('scooter');
        if (extras.length) lines.push(`Also interested in: ${extras.join(', ')}`);
      } else if (intent === 'scooter') {
        const bits: string[] = [];
        const model = selectText(f, 'sct_model');
        const from = fieldValue(f, 'sct_from');
        const to = fieldValue(f, 'sct_to');
        if (model) bits.push(model);
        if (from) bits.push(`from ${from}`);
        if (to) bits.push(`to ${to}`);
        if (bits.length) lines.push(`Scooter: ${bits.join(', ')}`);
      } else if (intent === 'dtv') {
        const bits: string[] = [];
        const nat = fieldValue(f, 'dtv_nationality');
        const arrival = fieldValue(f, 'dtv_arrival');
        const duration = selectText(f, 'dtv_duration');
        if (nat) bits.push(nat);
        if (arrival) bits.push(`arriving ${arrival}`);
        if (duration) bits.push(`training ${duration.toLowerCase()}`);
        if (bits.length) lines.push(`DTV: ${bits.join(', ')}`);
        const stay = f.querySelector<HTMLInputElement>('input[name="dtv_stay"]:checked');
        if (stay) lines.push(stay.value === 'training_only' ? 'Training only, own accommodation' : 'Stay & Train (all inclusive)');
      }

      const msg = fieldValue(f, 'message');
      if (msg) lines.push('', msg);
      return lines.join('\n');
    };

    // Email propre : les champs des intentions non actives sont `disabled`
    // (non soumis). Fallback no-JS : tout part, verbeux mais fonctionnel.
    const disableInactive = (f: HTMLFormElement) => {
      const active = checkedIntent();
      f.querySelectorAll<HTMLElement>('.xtra').forEach((box) => {
        // data-i peut lister plusieurs intentions (ex. « stay dtv »).
        if ((box.dataset.i ?? '').split(' ').includes(active)) return;
        box
          .querySelectorAll<HTMLInputElement>('input, select, textarea')
          .forEach((field) => (field.disabled = true));
      });
    };

    const modal = document.querySelector<HTMLDialogElement>('dialog[data-wa-modal]');
    // Lectures conseillées dans le modal : par intention, et par niveau pour un cours.
    const recoKey = (f: HTMLFormElement) => {
      const v = checkedIntent();
      const level = fieldValue(f, 'cls_level');
      return v === 'class' && level ? `class-${level}` : v;
    };

    if (base)
      submitViaWhatsApp(form, { waBase: base, buildText, beforeSubmit: disableInactive, modal, recoKey });
  });
</script>

<style>
  .cform {
    display: grid;
    gap: 18px;
