---
import Button from '../ui/Button.astro';
import { seedRot } from '../../lib/guestbook';

/**
 * PricingCard — carte plan tarifaire « scrapbook » (direction validée
 * 2026-06-05, explorations /styleguide) : coches manuscrites Caveat,
 * et sur la populaire un prix cerclé au marqueur + tampon encre haut-droite
 * (asset die-cut `decor/stamp-most-popular.webp` rendu tel quel — opaque,
 * pas de multiply ; rotation seedée sur le nom, alt = popularLabel
 * localisé). Pas de bordure colorée — la populaire ne se distingue que par
 * le tampon, le cercle et une ombre un cran au-dessus. Prix préformaté par
 * la page (toLocaleString selon la locale), devise = code brut (THB).
 */
export interface Props {
  name: string;
  price: string;
  currency: string;
  unit: string;
  features: string[];
  cta: { label: string; href: string; variant?: 'gold' | 'forest' | 'outline' };
  popular?: boolean;
  popularLabel?: string;
}
const { name, price, currency, unit, features, cta, popular = false, popularLabel } = Astro.props;

// Tampon : rotation seedée sur le nom, poussée hors de la zone ±3° (toujours
// visiblement penché, jamais à plat).
const srot = seedRot(name + 'stamp', 5);
const stampRot = srot < 0 ? srot - 3 : srot + 3;
---

<article class:list={['plan', popular && 'pop']} style={`--srot:${stampRot}deg`} data-animate-item>
  {
    popular && popularLabel && (
      <img
        class="stamp"
        src="/assets/decor/stamp-most-popular.webp"
        alt={popularLabel}
        width="565"
        height="240"
        loading="lazy"
      />
    )
  }
  <div class="pname">{name}</div>
  <div>
    {
      popular ? (
        <span class="circle">
          <span class="pprice">
            {price} <span>{currency}</span>
          </span>
        </span>
      ) : (
        <span class="pprice">
          {price} <span>{currency}</span>
        </span>
      )
    }
  </div>
  <div class="punit">{unit}</div>
  <ul>
    {features.map((feature) => <li>{feature}</li>)}
  </ul>
  <Button href={cta.href} variant={cta.variant ?? 'outline'} class="cta">{cta.label}</Button>
</article>

<style>
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
    padding: 30px 28px;
  }
  .plan.pop {
    box-shadow: var(--shadow-md);
  }
  .stamp {
    position: absolute;
    top: -24px;
    right: -14px;
    width: 150px;
    height: auto;
    transform: rotate(var(--srot, 6deg));
    z-index: 1;
  }
  .pname {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--forest-light);
    margin-bottom: 14px;
  }
  .pprice {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 40px;
    letter-spacing: -0.02em;
    color: var(--forest);
    line-height: 1;
  }
  .pprice span {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink-3);
    letter-spacing: 0;
  }
  /* prix cerclé au marqueur (populaire) — ellipse irrégulière */
  .circle {
    display: inline-block;
    padding: 8px 18px 10px;
    border: 2.5px solid var(--gold-deep);
    border-radius: 52% 48% 55% 45% / 60% 50% 50% 40%;
    transform: rotate(-2deg);
    margin: -8px 0 0 -10px;
  }
  .punit {
    font-size: 13.5px;
    color: var(--ink-2);
    margin: 6px 0 20px;
  }
  ul {
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  li {
    font-size: 14px;
    color: var(--ink);
    padding-left: 24px;
    position: relative;
  }
  /* coche au marqueur (Caveat) */
  li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: -3px;
    font-family: var(--font-hand);
    font-size: 19px;
    font-weight: 700;
    color: var(--forest-light);
  }
  .plan :global(.cta) {
    width: 100%;
    justify-content: center;
    margin-top: auto;
  }
</style>
