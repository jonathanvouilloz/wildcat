---
import { seedPick, seedRot } from '../../lib/guestbook';

/**
 * CoachCard v2 — « polaroid de famille » (direction B validée 2026-06-07).
 * Photo carrée incrustée frame déchirée (mask + contre-transform, pattern
 * FighterCard : 2 frames × 4 rotations × 2 miroirs seedés sur le nom),
 * scotch seedé, rôle manuscrit Caveat. Sans photo → pastille initiales
 * dans le même carré masqué.
 */
export interface Props {
  name: string;
  role: string;
  bio?: string;
  photo?: { src: string; alt: string };
}
const { name, role, bio, photo } = Astro.props;
const initials = name
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
  .toUpperCase();

// Tout l'aléatoire est seedé sur le nom — stable au build (grammaire guest book).
const FRAMES = [
  { url: '/assets/textures/torn-frame.png', size: '104%' },
  { url: '/assets/textures/torn-t2.png', size: '106%' },
];
const frame = FRAMES[seedPick(name + 'f', FRAMES.length)];
const maskRot = seedPick(name + 'q', 4) * 90;
const maskFlip = seedPick(name + 'm', 2) === 0 ? 1 : -1;
const mediaStyle = `--murl:url('${frame.url}'); --msize:${frame.size}; --mrot:${maskRot}deg; --mflip:${maskFlip}`;
const tapeSrc = `/assets/decor/tape-${1 + seedPick(name + 't', 3)}.webp`;
const tapeRot = seedRot(name + 'tape', 8);
const cardRot = seedRot(name, 2);
---

<div class="coach" style={`--crot:${cardRot}deg`}>
  <img
    class="tape"
    src={tapeSrc}
    alt=""
    style={`transform: translateX(-50%) rotate(${tapeRot}deg)`}
  />
  <div class="media" style={mediaStyle}>
    {
      photo ? (
        <img src={photo.src} alt={photo.alt} loading="lazy" />
      ) : (
        <div class="placeholder" aria-hidden="true">
          {initials}
        </div>
      )
    }
  </div>
  <h4>{name}</h4>
  <div class="role">{role}</div>
  {bio && <p>{bio}</p>}
</div>

<style>
  .coach {
    position: relative;
    text-align: center;
    transform: rotate(var(--crot, 0deg));
  }
  .tape {
    position: absolute;
    top: -16px;
    left: 50%;
    width: 96px;
    z-index: 2;
    filter: drop-shadow(0 2px 3px rgba(20, 35, 25, 0.18));
    pointer-events: none;
  }
  .media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: 16px;
    -webkit-mask-image: var(--murl, url('/assets/textures/torn-frame.png'));
    mask-image: var(--murl, url('/assets/textures/torn-frame.png'));
    -webkit-mask-size: var(--msize, 104%) var(--msize, 104%);
    mask-size: var(--msize, 104%) var(--msize, 104%);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    transform: rotate(var(--mrot, 0deg)) scaleX(var(--mflip, 1));
  }
  .media img,
  .media .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* contre-transform : le mask tourne, le contenu reste droit */
    transform: scaleX(var(--mflip, 1)) rotate(calc(-1 * var(--mrot, 0deg)));
  }
  .media .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-2);
    color: var(--forest-light);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 44px;
    letter-spacing: 0.02em;
  }
  h4 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    color: var(--forest);
  }
  .role {
    font-family: var(--font-hand);
    font-size: 22px;
    line-height: 1.15;
    color: var(--gold-deep);
    margin: 2px 0 8px;
  }
  p {
    margin: 0 auto;
    font-size: 14px;
    color: var(--ink-2);
    line-height: 1.5;
    max-width: 28ch;
  }
</style>
