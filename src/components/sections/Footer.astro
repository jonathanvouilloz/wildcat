---
import { Icon } from 'astro-icon/components';
import Container from '../layout/Container.astro';
import { site } from '../../config/site';

/**
 * Footer — 4 colonnes (brand/social · Explore · Hours · Contact) + bottom bar.
 * Port fidèle de la maquette verrouillée (landing.css .foot).
 * Contenu : src/config/site.ts. Labels EN en dur (extraction i18n en E3).
 * Cream-alpha en rgba brut, cohérent avec Nav (pas de token cream-alpha).
 */
const year = new Date().getFullYear();
---

<footer class="foot" id="contact">
  <Container>
    <div class="foot-grid">
      <div>
        <div class="brand">
          <img src="/assets/logo-cream.png" alt={site.name} width="160" height="46" />
        </div>
        <p class="tag">{site.tagline}</p>
        <div class="social">
          {
            site.social.map((s) => (
              <a href={s.href} aria-label={s.label} target="_blank" rel="noopener">
                <Icon name={s.icon} width={18} height={18} />
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <h5>Explore</h5>
        <ul>
          {
            site.exploreLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h5>Hours</h5>
        <p class="ct">
          {
            site.hours.map((h) => (
              <>
                <b>{h.days}</b>
                <br />
                {h.time}
                <br />
              </>
            ))
          }
        </p>
      </div>
      <div>
        <h5>Contact</h5>
        <p class="ct">
          {site.contact.address}<br />
          <b>{site.contact.email}</b><br />
          <a href={site.contact.phoneHref}>{site.contact.phone}</a><br /><br />
          {site.contact.note}
        </p>
      </div>
    </div>
    <div class="foot-bot">
      <span>© {year} {site.name} Chiang Mai. All rights reserved.</span>
      <span class="mid">◆ {site.motto} ◆</span>
      <span>{site.domain}</span>
    </div>
  </Container>
</footer>

<style>
  .foot {
    background: var(--forest);
    color: var(--cream);
    padding: 58px 0 30px;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 36px;
  }

  .brand img {
    height: 46px;
    width: auto;
    margin-bottom: 16px;
  }
  .tag {
    margin: 0;
    font-size: 14px;
    color: rgba(246, 241, 230, 0.7);
    max-width: 30ch;
    line-height: 1.5;
  }
  .social {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }
  .social a {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(246, 241, 230, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: 0.16s;
  }
  .social a:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: #1c1407;
  }
  .social a:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  h5 {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 16px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  ul a {
    font-size: 14px;
    color: rgba(246, 241, 230, 0.78);
    transition: color 0.15s ease;
  }
  ul a:hover {
    color: var(--cream);
  }
  .ct {
    margin: 0;
    font-size: 14px;
    color: rgba(246, 241, 230, 0.78);
    line-height: 1.6;
  }
  .ct b {
    color: var(--cream);
    font-weight: 700;
  }
  .ct a:hover {
    color: var(--cream);
  }

  .foot-bot {
    margin-top: 42px;
    padding-top: 22px;
    border-top: 1px solid rgba(246, 241, 230, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 12.5px;
    color: rgba(246, 241, 230, 0.55);
  }
  .foot-bot .mid {
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.04em;
  }

  @media (max-width: 1024px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .foot-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social a,
    ul a {
      transition: none;
    }
  }
</style>
