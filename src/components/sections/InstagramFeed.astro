---
/**
 * InstagramFeed — grille des derniers posts Instagram (fetch build-time, lib instagram.ts).
 *
 * Réutilisable partout (home #community, /about#community, /stay-train…) :
 * même grille 6 colonnes que CommunityGallery, chaque tuile lie vers le post.
 * Les images CDN Instagram (signées, expirantes) passent par <Image>
 * (astro:assets) → téléchargées et ré-hébergées en local au build.
 *
 * Fallback : feed indisponible (pas de APIFY_TOKEN, échec réseau, dev) →
 * placeholders CommunityGallery. Build toujours vert, zéro JS client.
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import * as m from '../../paraglide/messages';
import { fetchInstagramPosts } from '../../lib/instagram';
import CommunityGallery from './CommunityGallery.astro';

export interface Props {
  /** Nombre de posts (et de tuiles placeholder en fallback). */
  count?: number;
}
const { count = 6 } = Astro.props;

const posts = await fetchInstagramPosts(count);
---

{
  posts ? (
    <div class="gal" data-animate-stagger="40">
      {posts.map((post) => (
        <a href={post.permalink} target="_blank" rel="noopener" data-animate-item>
          <Image
            src={post.src}
            alt={post.alt || m.ig_alt_fallback()}
            width={480}
            height={480}
            widths={[240, 480]}
            sizes="(max-width: 860px) 33vw, 190px"
            loading="lazy"
          />
          <span class="veil" aria-hidden="true">
            <Icon name="tabler:brand-instagram" />
          </span>
        </a>
      ))}
    </div>
  ) : (
    <CommunityGallery count={count} />
  )
}

<style>
  /* Même grammaire visuelle que CommunityGallery (.gal de la maquette). */
  .gal {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
  }
  .gal a {
    position: relative;
    display: block;
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .gal img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 1/1;
    object-fit: cover;
  }
  /* Overlay hover : voile charcoal + logo Instagram centré (minimal). */
  .veil {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(17, 17, 17, 0.55);
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .veil [data-icon] {
    width: 28px;
    height: 28px;
  }
  .gal a:hover .veil,
  .gal a:focus-visible .veil {
    opacity: 1;
  }
  @media (max-width: 860px) {
    .gal {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .veil {
      transition: none;
    }
  }
</style>
