---
import Container from '../layout/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import BrushSeparator from '../../assets/separator-green.svg';

/**
 * PageHero — hero compact des pages intérieures (pillars, contact…).
 * Variante dark = gradient forest (comme DtvTeaser). Slot `aside` optionnel
 * (sceau DTV, média) → passe en grille 2 colonnes.
 * Variante photo (prop `image`) = direction D2 du styleguide en compact
 * (« poster inversé ») : photo pleine largeur intacte (voile léger gold+forest),
 * brush de liaison, contenu sur bande forest solide dessous — lisibilité 100 %,
 * personne n'est coupé sur les photos de groupe. `image.position` = crop par
 * page. Le Breadcrumb reste au-dessus sur sa bande cream.
 * Utilisée sur /about et /about/coaches.
 */
export interface Props {
  head: string;
  title: string;
  titleEm?: string;
  titleAfter?: string;
  lead: string;
  dark?: boolean;
  cta?: { label: string; href: string };
  image?: { src: string; alt: string; position?: string };
  eyebrow?: string;
}
const { head, title, titleEm, titleAfter, lead, dark = false, cta, image, eyebrow } = Astro.props;
const hasAside = Astro.slots.has('aside');
const onDark = dark || !!image;
---

<section class:list={['page-hero', dark && 'page-hero--dark', image && 'page-hero--photo']}>
  {
    image && (
      <div class="ph-media">
        {/* LCP des pages qui l'utilisent → fetchpriority high */}
        <img
          src={image.src}
          alt={image.alt}
          fetchpriority="high"
          style={`object-position:${image.position ?? 'center 30%'}`}
        />
        <BrushSeparator class="ph-brush" aria-hidden="true" />
      </div>
    )
  }
  <Container>
    <div class:list={['grid', hasAside && 'grid--aside']}>
      <div>
        {eyebrow && <p class="ph-eyebrow"><span class="em on-dark">{eyebrow}</span></p>}
        <SectionHead onDark={onDark}>{head}</SectionHead>
        <h1 class="h1">
          {title}
          {titleEm && <span class:list={['em', onDark && 'on-dark']}>{titleEm}</span>}{
            titleAfter && ` ${titleAfter}`
          }
        </h1>
        <p class="lead">{lead}</p>
        {
          cta && (
            <div class="cta">
              <Button href={cta.href} variant="gold" arrow>
                {cta.label}
              </Button>
            </div>
          )
        }
      </div>
      {
        hasAside && (
          <div class="aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .page-hero {
    background: var(--cream);
    /* top réduit : le Breadcrumb au-dessus apporte déjà 20px */
    padding: clamp(24px, 3vw, 44px) 0 clamp(48px, 6vw, 72px);
  }
  .page-hero--dark {
    background: linear-gradient(180deg, #16271e, var(--forest-deep));
    color: var(--cream);
  }

  /* --- variante photo (direction D2 « poster inversé » compacte) --- */
  .page-hero--photo {
    /* la bande forest = le fond de la section, la photo coiffe le haut */
    background: var(--forest);
    color: var(--cream);
    padding: 0;
  }
  .ph-media {
    position: relative;
  }
  .ph-media img {
    display: block;
    width: 100%;
    height: clamp(280px, 42vh, 460px);
    object-fit: cover;
  }
  /* voile léger gold + forest — lie la photo à la palette sans la voiler */
  .ph-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(224, 166, 43, 0.05), rgba(224, 166, 43, 0.05)),
      rgba(33, 66, 44, 0.16);
  }
  /* brush de liaison — mord le bas de la photo, couleur = bande dessous */
  .ph-brush {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    width: 100%;
    height: auto;
    z-index: 1;
  }
  .ph-brush :global(path) {
    fill: var(--forest);
  }
  .page-hero--photo :global(.wc-container) {
    padding-top: clamp(28px, 3.5vw, 44px);
    padding-bottom: clamp(44px, 5vw, 64px);
  }
  .ph-eyebrow {
    font-size: clamp(17px, 1.6vw, 21px);
    margin: 0 0 10px;
  }
  .page-hero--photo .h1 {
    color: var(--cream);
  }
  .page-hero--photo .lead {
    color: rgba(246, 241, 230, 0.88);
    max-width: 52ch;
  }
  .grid--aside {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  .h1 {
    margin: 8px 0 16px;
  }
  .page-hero--dark .h1 {
    color: var(--cream);
  }
  .lead {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0;
  }
  .page-hero--dark .lead {
    color: rgba(246, 241, 230, 0.78);
  }
  .cta {
    margin-top: 26px;
  }
  .aside {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 860px) {
    .grid--aside {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .aside {
      justify-content: flex-start;
    }
  }
</style>
