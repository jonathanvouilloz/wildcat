---
import Container from '../layout/Container.astro';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';

/**
 * PageHero — hero compact des pages intérieures (pillars, contact…).
 * Variante dark = gradient forest (comme DtvTeaser). Slot `aside` optionnel
 * (sceau DTV, média) → passe en grille 2 colonnes.
 */
export interface Props {
  head: string;
  title: string;
  titleEm?: string;
  titleAfter?: string;
  lead: string;
  dark?: boolean;
  cta?: { label: string; href: string };
}
const { head, title, titleEm, titleAfter, lead, dark = false, cta } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-hero', dark && 'page-hero--dark']}>
  <Container>
    <div class:list={['grid', hasAside && 'grid--aside']}>
      <div>
        <SectionHead onDark={dark}>{head}</SectionHead>
        <h1 class="h1">
          {title}
          {titleEm && <span class:list={['em', dark && 'on-dark']}>{titleEm}</span>}{
            titleAfter && ` ${titleAfter}`
          }
        </h1>
        <p class="lead">{lead}</p>
        {
          cta && (
            <div class="cta">
              <Button href={cta.href} variant="gold" arrow>
                {cta.label}
              </Button>
            </div>
          )
        }
      </div>
      {
        hasAside && (
          <div class="aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </Container>
</section>

<style>
  .page-hero {
    background: var(--cream);
    padding: clamp(38px, 5vw, 64px) 0 clamp(48px, 6vw, 72px);
  }
  .page-hero--dark {
    background: linear-gradient(180deg, #16271e, var(--forest-deep));
    color: var(--cream);
  }
  .grid--aside {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  .h1 {
    margin: 8px 0 16px;
  }
  .page-hero--dark .h1 {
    color: var(--cream);
  }
  .lead {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0;
  }
  .page-hero--dark .lead {
    color: rgba(246, 241, 230, 0.78);
  }
  .cta {
    margin-top: 26px;
  }
  .aside {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 860px) {
    .grid--aside {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .aside {
      justify-content: flex-start;
    }
  }
</style>
