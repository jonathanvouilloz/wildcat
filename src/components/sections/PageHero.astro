---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import BrushSeparator from '../../assets/separator-green.svg';

/**
 * PageHero — hero compact des pages intérieures (pillars, contact…).
 * Variante dark = gradient forest (comme DtvTeaser). Slot `aside` optionnel
 * (sceau DTV, média) → passe en grille 2 colonnes.
 * Variante photo (prop `image`) = direction A du styleguide en compact :
 * photo full-bleed + voile gold + gradient vertical forest-deep (lisibilité),
 * contenu bottom-left sur la photo, brush en bas du hero (fill cream = la
 * section suivante). `image.position` = crop par page, `brush={false}` = bord
 * net. Le Breadcrumb reste au-dessus sur sa bande cream — sauf via le slot
 * `crumbs` (+ prop `overlay` du Breadcrumb) qui le fait flotter en haut du hero
 * (utilisé par la variante `full`, ex. /classes/beginners).
 * Utilisée sur /about/coaches (/about utilise SplitHero).
 */
export interface Props {
  title: string;
  titleEm?: string;
  titleAfter?: string;
  lead: string;
  dark?: boolean;
  cta?: { label: string; href: string };
  image?: { src: string; alt: string; position?: string };
  eyebrow?: string;
  /** brush de liaison photo→bande (défaut true) — false = bord net */
  brush?: boolean;
  /** fond décoratif full-bleed (URL) de la variante cream — webp cream + motif
      très faible (rayures + tête de tigre), cover, tête ancrée à droite */
  texture?: string;
  /** hero pleine hauteur (comme la home) — contenu centré verticalement */
  full?: boolean;
}
const {
  title,
  titleEm,
  titleAfter,
  lead,
  dark = false,
  cta,
  image,
  eyebrow,
  brush = true,
  texture,
  full = false,
} = Astro.props;
const hasAside = Astro.slots.has('aside');
const onDark = dark || !!image;
---

<section
  class:list={[
    'page-hero',
    dark && 'page-hero--dark',
    image && 'page-hero--photo',
    texture && 'page-hero--texture',
    full && 'page-hero--full',
  ]}
  style={texture ? `--ph-texture:url('${texture}')` : undefined}
>
  {
    Astro.slots.has('crumbs') && (
      <div class="ph-crumbs">
        <slot name="crumbs" />
      </div>
    )
  }
  {/* LCP des pages qui l'utilisent → fetchpriority high */}
  {
    image && (
      <img
        class="ph-bg"
        src={image.src}
        alt={image.alt}
        fetchpriority="high"
        style={`object-position:${image.position ?? 'center 30%'}`}
      />
    )
  }
  <Container>
    <div class:list={['grid', hasAside && 'grid--aside']}>
      <div>
        {eyebrow && <p class="ph-eyebrow"><span class="em on-dark">{eyebrow}</span></p>}
        <h1 class="h1">
          {title}
          {titleEm && <span class:list={['em', onDark && 'on-dark']}>{titleEm}</span>}{
            titleAfter && ` ${titleAfter}`
          }
        </h1>
        <p class="lead">{lead}</p>
        {
          cta && (
            <div class="cta">
              <Button href={cta.href} variant="gold" arrow>
                {cta.label}
              </Button>
            </div>
          )
        }
      </div>
      {
        hasAside && (
          <div class="aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </Container>
  {image && brush && <BrushSeparator class="ph-brush" preserveAspectRatio="none" aria-hidden="true" />}
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--cream);
    /* top réduit : le Breadcrumb au-dessus apporte déjà 20px */
    padding: clamp(24px, 3vw, 44px) 0 clamp(48px, 6vw, 72px);
  }
  /* breadcrumb flottant (slot crumbs) — par-dessus le hero, pas de bande dédiée */
  .ph-crumbs {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
  }
  .page-hero--dark {
    background: linear-gradient(180deg, #16271e, var(--forest-deep));
    color: var(--cream);
  }
  /* fond décoratif full-bleed — le motif est assez faible pour passer sous le
     texte à toutes les tailles ; tête de tigre ancrée côté droit */
  .page-hero--texture {
    background-image: var(--ph-texture);
    background-repeat: no-repeat;
    background-position: center right;
    background-size: cover;
  }
  /* fondu de sortie : le cream de l'image ≠ exactement var(--cream) → gradient
     vers la section suivante pour éviter la cassure nette en bas du hero */
  .page-hero--texture::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: clamp(80px, 12vh, 140px);
    background: linear-gradient(180deg, transparent, var(--cream));
    pointer-events: none;
  }
  .page-hero--texture :global(.wc-container) {
    position: relative;
    z-index: 1;
  }

  /* variante full : pleine hauteur (même clamp que la home), contenu centré */
  .page-hero--full {
    display: flex;
    align-items: center;
    min-height: clamp(560px, 88vh, 860px);
  }
  .page-hero--full :global(.wc-container) {
    width: 100%;
  }

  /* --- variante photo (direction A compacte : overlay + brush en bas) --- */
  .page-hero--photo {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: clamp(440px, 60vh, 640px);
    /* fallback pendant le chargement de la photo */
    background: var(--forest-deep);
    color: var(--cream);
    padding: 0;
  }
  .ph-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* overlay type A : voile gold (réchauffe) + gradient vertical forest-deep */
  .page-hero--photo::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(rgba(224, 166, 43, 0.06), rgba(224, 166, 43, 0.06)),
      linear-gradient(
        180deg,
        rgba(33, 66, 44, 0.55) 0%,
        rgba(33, 66, 44, 0.26) 26%,
        rgba(33, 66, 44, 0.58) 54%,
        rgba(33, 66, 44, 0.95) 100%
      );
  }
  .page-hero--photo :global(.wc-container) {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: clamp(120px, 18vh, 180px);
    padding-bottom: clamp(60px, 8vw, 96px);
  }
  /* brush tout en bas du hero (comme la home) — fill = section suivante.
     Hauteur cappée (ratio naturel ~9:1 trop gourmand) via
     preserveAspectRatio="none". */
  .ph-brush {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(28px, 4vw, 56px);
    z-index: 2;
  }
  .ph-brush :global(path) {
    fill: var(--cream);
  }
  .ph-eyebrow {
    font-size: clamp(17px, 1.6vw, 21px);
    margin: 0 0 10px;
  }
  .page-hero--photo .h1 {
    color: var(--cream);
  }
  .page-hero--photo .lead {
    color: rgba(246, 241, 230, 0.88);
    max-width: 52ch;
  }
  .grid--aside {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
  }
  /* H1 de hero : un cran au-dessus du .h1 global (56px max), sous la home (92px).
     Pas de kicker ◆ CAPS en hero (redondant avec le breadcrumb) → margin-top 0. */
  .h1 {
    margin: 0 0 16px;
    font-size: clamp(40px, 5.6vw, 68px);
  }
  .page-hero--dark .h1 {
    color: var(--cream);
  }
  .lead {
    font-size: clamp(17px, 1.4vw, 20px);
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0;
  }
  .page-hero--dark .lead {
    color: rgba(246, 241, 230, 0.78);
  }
  .cta {
    margin-top: 26px;
  }
  .aside {
    display: flex;
    justify-content: center;
  }
  @media (max-width: 860px) {
    .grid--aside {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .aside {
      justify-content: flex-start;
    }
  }
</style>
