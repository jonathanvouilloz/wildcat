---
import SectionHead from '../ui/SectionHead.astro';

/**
 * StayTrainUpsell — bloc « Stay & Train » (demi-colonne du split home,
 * réutilisé sur /stay-train). Head + titre accentué + lead + image.
 */
export interface Props {
  head: string;
  title: string;
  titleEm: string;
  lead: string;
  image: { src: string; alt: string };
}
const { head, title, titleEm, lead, image } = Astro.props;
---

<div>
  <SectionHead>{head}</SectionHead>
  <h2 class="h2">
    {title} <span class="em">{titleEm}</span>
  </h2>
  <p class="lead">{lead}</p>
  <div class="imgbox">
    <img src={image.src} alt={image.alt} loading="lazy" />
  </div>
</div>

<style>
  .h2 {
    margin: 6px 0 14px;
  }
  .lead {
    font-size: 18px;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0 0 22px;
  }
  .imgbox {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    height: 300px;
  }
  .imgbox img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
