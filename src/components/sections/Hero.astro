---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import BrushSeparator from '../../assets/separator-green.svg';

/**
 * Hero — hero principal de la home (maquette landing : .hero).
 * Grid copy/média, badge pill, métas chiffrées, carte flottante forest.
 * Toutes les strings arrivent traduites en props (la page appelle m.*()).
 */
export interface Props {
  badgePill?: string;
  badge?: string;
  /** Titre en 3 morceaux : title <em>titleEm</em> titleAfter */
  title: string;
  titleEm: string;
  titleAfter?: string;
  sub: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  metas?: { b: string; s: string }[];
  image: { src: string; alt: string };
  float?: { t: string; d: string };
}

const { badgePill, badge, title, titleEm, titleAfter, sub, ctaPrimary, ctaSecondary, metas = [], image, float } =
  Astro.props;
---

<section class="hero">
  <Container>
    <div class="hero-grid">
      <div>
        {
          badge && (
            <div class="hero-badge">
              {badgePill && <span class="pill">{badgePill}</span>}
              {badge}
            </div>
          )
        }
        <h1 class="display">
          {title} <span class="em">{titleEm}</span>{titleAfter && ` ${titleAfter}`}
        </h1>
        <p class="sub">{sub}</p>
        <div class="cta-row">
          <Button href={ctaPrimary.href} variant="gold" arrow>{ctaPrimary.label}</Button>
          {ctaSecondary && <Button href={ctaSecondary.href} variant="outline">{ctaSecondary.label}</Button>}
        </div>
        {
          metas.length > 0 && (
            <div class="meta-row">
              {metas.map((meta) => (
                <div class="meta">
                  <b>{meta.b}</b>
                  <span>{meta.s}</span>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <div class="hero-media">
        <div class="imgbox">
          <img src={image.src} alt={image.alt} fetchpriority="high" />
        </div>
        {
          float && (
            <div class="hero-float">
              <div class="t">{float.t}</div>
              <div class="d">{float.d}</div>
            </div>
          )
        }
      </div>
    </div>
  </Container>
</section>
<BrushSeparator class="brush" aria-hidden="true" />

<style>
  .hero {
    position: relative;
    background: var(--cream);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.04fr 1fr;
    gap: 46px;
    align-items: center;
    padding: clamp(38px, 5vw, 68px) 0 clamp(70px, 7vw, 96px);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 22px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 7px 14px 7px 8px;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--forest);
    box-shadow: var(--shadow-sm);
  }
  .hero-badge .pill {
    background: var(--gold);
    color: #1c1407;
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  h1 {
    margin: 0 0 18px;
  }
  .sub {
    font-size: clamp(18px, 1.5vw, 21px);
    color: var(--ink-2);
    max-width: 38ch;
    margin: 0 0 30px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 30px;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .meta b {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--forest);
    letter-spacing: -0.01em;
  }
  .meta span {
    font-size: 12.5px;
    color: var(--ink-3);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .hero-media {
    position: relative;
  }
  .imgbox {
    display: block;
    width: 100%;
    height: clamp(360px, 46vw, 540px);
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }
  .imgbox img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-float {
    position: absolute;
    left: -18px;
    bottom: 26px;
    z-index: 3;
    background: var(--forest);
    color: var(--cream);
    border-radius: var(--r-md);
    padding: 14px 18px;
    box-shadow: var(--shadow-lg);
    max-width: 210px;
  }
  .hero-float .t {
    font-weight: 800;
    font-size: 15px;
    color: var(--gold);
    margin-bottom: 2px;
  }
  .hero-float .d {
    font-size: 12.5px;
    color: rgba(246, 241, 230, 0.8);
    line-height: 1.4;
  }

  /* divider brossé (transition cream → bande forest des values) */
  .brush {
    display: block;
    width: 100%;
    height: auto; /* ratio natif du dessin — pas d'étirement */
    margin-bottom: -3px; /* le bas du path n'est pas au ras du viewBox → chevauchement pour éviter un liseré */
  }
  /* la couleur vient du token, pas du fill en dur exporté par Illustrator */
  .brush :global(path) {
    fill: var(--forest);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }
  }
  @media (max-width: 520px) {
    .cta-row :global(.wc-btn) {
      flex: 1;
      justify-content: center;
    }
  }
</style>
