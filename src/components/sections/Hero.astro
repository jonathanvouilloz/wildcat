---
import Button from '../ui/Button.astro';
import BrushSeparator from '../../assets/separator-green.svg';

/**
 * Hero — hero principal de la home (direction A validée sur /styleguide).
 * Photo équipe full-bleed + overlay charcoal (validé 2026-06-05 : le noir rend
 * mieux que le vert sur les photos — "sinon ça fait trop green partout") + voile gold,
 * lockup signature en H1 centré, metas ◆ en bandeau, brush intégré qui mord
 * le bas de la photo (la section suivante doit être forest — ValueStrip).
 * Toutes les strings arrivent traduites en props (la page appelle m.*()).
 */
export interface Props {
  /** Lockup signature : title (Satoshi cream) / titleEm (Fraunces gold) */
  title: string;
  titleEm: string;
  sub: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  metas?: { b: string; s: string }[];
  image: {
    src: string;
    alt: string;
    position?: string;
    /** Variantes responsive (LCP) — ex : `${src768} 768w, ${src} 1080w`. */
    srcset?: string;
  };
}

const { title, titleEm, sub, ctaPrimary, ctaSecondary, metas = [], image } = Astro.props;
---

<section class="hero">
  <img
    class="hero-bg"
    src={image.src}
    srcset={image.srcset}
    sizes={image.srcset ? '100vw' : undefined}
    alt={image.alt}
    fetchpriority="high"
    decoding="async"
    style={image.position && `object-position:${image.position}`}
  />
  {/* Entrée AU LOAD : data-animate-load sur le CONTAINER (un seul reveal,
      pas d'observer) — la chorégraphie des enfants est 100 % CSS scoped
      ci-dessous (lockup en line-rise masqué, cascade lente : ça « ouvre »
      le site). Photo + brush statiques : l'image est l'élément LCP. */}
  <div class="hero-inner" data-animate="hero" data-animate-load>
    <h1 class="display">
      <span class="line"><span class="line-in">{title}</span></span>
      <span class="line"><span class="line-in em on-dark">{titleEm}</span></span>
    </h1>
    <p class="sub">{sub}</p>
    <div class="cta-row">
      <Button href={ctaPrimary.href} variant="gold" arrow>{ctaPrimary.label}</Button>
      {ctaSecondary && <Button href={ctaSecondary.href} variant="outline" onDark>{ctaSecondary.label}</Button>}
    </div>
    {
      metas.length > 0 && (
        <div class="meta-row">
          {metas.map((meta, i) => (
            <>
              {i > 0 && (
                <i class="sep" aria-hidden="true">
                  ◆
                </i>
              )}
              <span class="meta">
                <b>{meta.b}</b> · {meta.s}
              </span>
            </>
          ))}
        </div>
      )
    }
  </div>
  <BrushSeparator class="brush" aria-hidden="true" />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* juste milieu (retour Jonathan 2026-06-06 v2) entre l'original (88vh/860)
       et la passe −15 % (75vh/730) — contenu flex-end + brush remontent ensemble */
    min-height: clamp(560px, 81vh, 795px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    /* fallback pendant le chargement de la photo (texte cream lisible) */
    background: var(--forest-deep);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Y élevé : visages intacts en haut, zone de texte sur les torses/jambes */
    object-position: center 60%;
    z-index: 0;
  }
  /* overlay : voile gold (réchauffe) + voile uniforme (centre lumineux) + gradient charcoal (lisibilité) */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(rgba(224, 166, 43, 0.06), rgba(224, 166, 43, 0.06)),
      linear-gradient(rgba(17, 17, 17, 0.18), rgba(17, 17, 17, 0.18)),
      linear-gradient(
        180deg,
        rgba(17, 17, 17, 0.6) 0%,
        rgba(17, 17, 17, 0.50) 26%,
        rgba(17, 17, 17, 0.65) 54%,
        rgba(17, 17, 17, 0.92) 100%
      );
  }

  /* H1 home only : plus grand que le .display global (l'espace est là) —
     la colonne passe à 1060px pour garder le lockup sur 2 lignes */
  .hero .display {
    font-size: clamp(46px, 7vw, 92px);
  }
  .hero-inner {
    position: relative;
    z-index: 3; /* au-dessus du brush — le bandeau metas le chevauche */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 1060px;
    margin: 0 auto;
    padding: clamp(140px, 20vh, 220px) var(--gutter) clamp(24px, 3vw, 44px);
  }

  h1 {
    margin: 0;
    color: var(--cream);
  }
  /* lockup en 2 lignes block (remplace le <br/> — nécessaire au line-rise) */
  .line {
    display: block;
    /* fenêtre de masque : padding compense les débords Fraunces italic
       (descendantes/swashes) que l'overflow hidden clipperait — net zéro */
    padding: 0.14em 0.12em;
    margin: -0.14em -0.12em;
  }

  /* ------------------------------------------------------------
     Chorégraphie d'entrée (gated html.wc-anim — no-JS : tout visible).
     Transitions sur l'état .in-view UNIQUEMENT (règle motion.css).
     Séquence : scène 0s · ligne 1 0.15s · ligne 2 0.32s · sub 0.6s ·
     CTAs 0.8s · metas 1s — lent et successif, ça ouvre le site.
     ------------------------------------------------------------ */
  :global(html.wc-anim) .hero-inner .line {
    overflow: hidden;
  }
  :global(html.wc-anim) .hero-inner .line-in {
    display: inline-block;
    transform: translateY(118%);
  }
  :global(html.wc-anim) .hero-inner.in-view .line-in {
    transform: none;
    transition: transform 0.9s var(--ease-out-strong);
    transition-delay: 0.15s;
  }
  :global(html.wc-anim) .hero-inner.in-view .line:nth-child(2) .line-in {
    transition-delay: 0.32s;
  }

  :global(html.wc-anim) .hero-inner :is(.sub, .cta-row, .meta-row) {
    opacity: 0;
    transform: translateY(18px);
  }
  :global(html.wc-anim) .hero-inner.in-view :is(.sub, .cta-row, .meta-row) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s var(--ease-out-strong),
      transform 0.7s var(--ease-out-strong);
  }
  :global(html.wc-anim) .hero-inner.in-view .sub {
    transition-delay: 0.6s;
  }
  :global(html.wc-anim) .hero-inner.in-view .cta-row {
    transition-delay: 0.8s;
  }
  :global(html.wc-anim) .hero-inner.in-view .meta-row {
    transition-delay: 1s;
  }

  /* ceinture + bretelles (le script bail déjà sur reduced-motion) */
  @media (prefers-reduced-motion: reduce) {
    :global(html.wc-anim) .hero-inner .line-in,
    :global(html.wc-anim) .hero-inner :is(.sub, .cta-row, .meta-row) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .sub {
    font-size: clamp(17px, 1.5vw, 20px);
    color: rgba(246, 241, 230, 0.88);
    max-width: 52ch;
    margin: 20px 0 28px;
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 18px;
    margin-top: 34px;
    padding-top: 20px;
    border-top: 1px solid rgba(246, 241, 230, 0.25);
    color: rgba(246, 241, 230, 0.85);
    font-size: clamp(14.5px, 1.2vw, 16px);
  }
  .meta b {
    color: var(--cream);
    font-weight: 800;
  }
  .sep {
    color: var(--gold);
    font-style: normal;
    font-size: 10px;
  }

  /* brush dans le hero, absolu sur le bas de la photo → overlap complet,
     la section suivante (ValueStrip, forest) enchaîne au ras dessous */
  .brush {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    width: 100%;
    height: auto;
    z-index: 2;
  }
  /* la couleur vient du token, pas du fill en dur exporté par Illustrator */
  .brush :global(path) {
    fill: var(--forest);
  }

  @media (max-width: 520px) {
    .cta-row {
      width: 100%;
    }
    .cta-row :global(.wc-btn) {
      flex: 1;
      justify-content: center;
    }
  }
</style>
