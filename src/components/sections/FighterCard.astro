---
/**
 * FighterCard — entrée du livre d'or, v2 « incrusté scrapbook » (E5d).
 * Photo posée directement sur le fond de page, bord déchiré (mask torn 112%)
 * qui fait la transition photo↔fond ; un morceau de scotch seedé (1 de 3,
 * haut gauche/droite) ; stamps achievements répartis sur les CÔTÉS de la
 * photo (max 5 : 2/3 ou 3/2, seedé) ; nom + drapeau + année sur l'ornement
 * crème ; quote Fraunces + ligne signature dessous.
 * Pas de record W/L : la seule stat est la sigLine pré-composée par la page.
 * Tout l'aléatoire est seedé sur le nom → stable au build.
 */
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import AchievementStamp from '../ui/AchievementStamp.astro';
import { initialsOf, seedPick, seedRot } from '../../lib/guestbook';

export interface Props {
  name: string;
  fightName?: string;
  /** ISO alpha-2 → drapeau SVG (flag-icons) inliné au build, rendu identique partout. */
  countryCode?: string;
  year?: number;
  quote?: string;
  photo?: { src: string; alt: string };
  achievements?: { value: string; label: string }[];
  sigLine?: string;
  /** Label a11y de la liste des achievements (« Achievements » / « Tampons »). */
  achListLabel: string;
}
const { name, fightName, countryCode, year, quote, photo, achievements = [], sigLine, achListLabel } =
  Astro.props;

const rot = seedRot(name, 2);
const signature = [`— ${fightName ?? name.split(/\s+/)[0]}`, sigLine].filter(Boolean).join(' · ');

// Stamps latéraux : max 5 (ordre priorité = page), répartition 2/3 ou 3/2 seedée
const stamps = achievements.slice(0, 5);
const leftCount =
  stamps.length <= 1 ? 0 : seedPick(name, 2) === 0 ? Math.ceil(stamps.length / 2) : Math.floor(stamps.length / 2);
const leftStamps = stamps.slice(0, leftCount);
const rightStamps = stamps.slice(leftCount);

// Scotch : asset 1 de 3 + côté haut gauche/droite, seedés
const tapeSrc = `/assets/decor/tape-${1 + seedPick(name + 't', 3)}.webp`;
const tapeRight = seedPick(name + 's', 2) === 1;
const tapeRot = seedRot(name + 'tape', 8);

// Drapeau SVG inliné au build (pages prerendered only) — l'emoji drapeau ne
// rend pas sur Chrome/Windows, le SVG flag-icons est uniforme partout.
let flagSvg: string | undefined;
if (countryCode) {
  try {
    flagSvg = await readFile(
      path.resolve(process.cwd(), 'node_modules/flag-icons/flags/4x3', `${countryCode.toLowerCase()}.svg`),
      'utf8',
    );
  } catch {
    flagSvg = undefined; // code inconnu → plaque sans drapeau
  }
}
---

<article class="fighter" style={`--rot:${rot}deg`}>
  <div class="photo">
    <div class="media">
      {
        photo ? (
          <img src={photo.src} alt={photo.alt} width={640} height={640} loading="lazy" />
        ) : (
          <span class="ph" aria-hidden="true">
            {initialsOf(name)}
          </span>
        )
      }
    </div>
    <img
      class:list={['tape', tapeRight ? 'tape--right' : 'tape--left']}
      src={tapeSrc}
      alt=""
      width={110}
      height={28}
      loading="lazy"
      aria-hidden="true"
      style={`--trot:${tapeRot}deg`}
    />
    {
      leftStamps.length > 0 && (
        <div class="stamps stamps--left" aria-hidden="true">
          {leftStamps.map((a) => (
            <span class="srow" style={`--dx:${seedRot(name + a.value + 'x', 6)}px`}>
              <AchievementStamp value={a.value} label={a.label} rot={seedRot(name + a.value)} />
            </span>
          ))}
        </div>
      )
    }
    {
      rightStamps.length > 0 && (
        <div class="stamps stamps--right" aria-hidden="true">
          {rightStamps.map((a) => (
            <span class="srow" style={`--dx:${seedRot(name + a.value + 'x', 6)}px`}>
              <AchievementStamp value={a.value} label={a.label} rot={seedRot(name + a.value)} />
            </span>
          ))}
        </div>
      )
    }
  </div>

  <div class="plate">
    {flagSvg && <span class="plate-flag" role="img" aria-label={countryCode} set:html={flagSvg} />}
    {name}
    {year != null && <span> · {year}</span>}
  </div>

  {quote && <blockquote class="quote">“{quote}”</blockquote>}
  <div class="sig">{signature}</div>

  {
    stamps.length > 0 && (
      <dl class="sr-only">
        <dt>{achListLabel}</dt>
        {achievements.map((a) => (
          <dd>{a.label}</dd>
        ))}
      </dl>
    )
  }
</article>

<style>
  .fighter {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .photo {
    position: relative;
    width: 100%;
    transform: rotate(var(--rot, -1deg));
    transition: transform 0.25s ease;
  }
  /* au survol la photo « se redresse » */
  .fighter:hover .photo {
    transform: rotate(0deg);
  }

  /* Photo incrustée : pas de cadre — le bord déchiré fait la transition
     avec le fond de page. Scratches légères clipées par le même mask. */
  .media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    -webkit-mask-image: url('/assets/textures/torn-frame.png');
    mask-image: url('/assets/textures/torn-frame.png');
    -webkit-mask-size: 112% 112%;
    mask-size: 112% 112%;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/assets/textures/photo-scratches.png') center / 100% 100% no-repeat;
    mix-blend-mode: screen;
    opacity: 0.18;
    pointer-events: none;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.06) saturate(0.88) sepia(0.08);
  }
  .ph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-2);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 52px;
    color: var(--line-3);
  }
  .ph::before {
    content: '';
    position: absolute;
    inset: 10%;
    background: var(--forest);
    opacity: 0.09;
    -webkit-mask: url('/assets/logo-only.svg') center / contain no-repeat;
    mask: url('/assets/logo-only.svg') center / contain no-repeat;
  }

  /* Scotch — à cheval sur le bord haut, asset + côté + rotation seedés */
  .tape {
    position: absolute;
    top: -15px;
    width: 110px;
    height: auto;
    z-index: 3;
    transform: rotate(var(--trot, 4deg));
    opacity: 0.92;
  }
  .tape--left {
    left: 14px;
  }
  .tape--right {
    right: 14px;
  }

  /* Stamps latéraux — colonnes à cheval sur les bords (≈moitié dehors) */
  .stamps {
    position: absolute;
    top: 8%;
    bottom: 8%;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
    align-items: center;
    z-index: 2;
  }
  .stamps--left {
    left: -34px;
  }
  .stamps--right {
    right: -34px;
  }
  .srow {
    display: block;
    transform: translateX(var(--dx, 0));
  }

  /* Plaque ornement — chevauche légèrement le bas de la photo */
  .plate {
    position: relative;
    z-index: 2;
    margin-top: -16px;
    padding: 13px 34px;
    background: url('/assets/decor/ornament.webp') center / 100% 100% no-repeat;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 600;
    font-variation-settings: 'opsz' 30;
    font-size: 17px;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    max-width: 100%;
  }
  .plate-flag {
    display: inline-block;
    margin-right: 2px;
  }
  .plate-flag :global(svg) {
    width: 20px;
    height: auto;
    border-radius: 2px;
    vertical-align: -2px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .quote {
    margin: 16px 8px 0;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 600;
    font-variation-settings: 'opsz' 50;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.35;
    color: var(--forest);
  }
  .sig {
    margin-top: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo {
      transition: none;
    }
    .fighter:hover .photo {
      transform: rotate(var(--rot, -1deg));
    }
  }
</style>
