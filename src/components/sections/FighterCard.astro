---
/**
 * FighterCard — entrée du livre d'or, v2 « incrusté scrapbook » (E5d).
 * Photo posée directement sur le fond de page, bord déchiré (mask torn 112%)
 * qui fait la transition photo↔fond ; un morceau de scotch seedé (1 de 3,
 * haut gauche/droite) ; stamps achievements sur les CÔTÉS de la photo
 * (max 3, côtés alternés + hauteurs jitterées, seedé — jamais symétrique) ;
 * nom + drapeau + année sur l'ornement crème (chevauche le bas de la photo) ;
 * quote Fraunces + ligne signature dessous. Pas d'effet hover.
 * Pas de record W/L : la seule stat est la sigLine pré-composée par la page.
 * Tout l'aléatoire est seedé sur le nom → stable au build.
 */
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import AchievementStamp from '../ui/AchievementStamp.astro';
import { initialsOf, seedPick, seedRot } from '../../lib/guestbook';

export interface Props {
  name: string;
  fightName?: string;
  /** ISO alpha-2 → drapeau SVG (flag-icons) inliné au build, rendu identique partout. */
  countryCode?: string;
  year?: number;
  quote?: string;
  photo?: { src: string; alt: string };
  achievements?: { value: string; label: string }[];
  sigLine?: string;
  /** Label a11y de la liste des achievements (« Achievements » / « Tampons »). */
  achListLabel: string;
}
const { name, fightName, countryCode, year, quote, photo, achievements = [], sigLine, achListLabel } =
  Astro.props;

const rot = seedRot(name, 2);
const signature = [`— ${fightName ?? name.split(/\s+/)[0]}`, sigLine].filter(Boolean).join(' · ');

// Stamps : max 3 (ordre priorité = page), tous du MÊME côté (seedé) en
// grappe qui se chevauche — collés les uns sur les autres comme de vrais
// stickers. Départ vertical seedé + chaîne descendante (12 %/stamp ≈
// chevauchement léger) + jitters horizontaux/verticaux + rotations.
const stamps = achievements.slice(0, 3);
const stampSide: 'left' | 'right' = seedPick(name + 'side', 2) === 0 ? 'left' : 'right';
const clusterTop = 8 + seedPick(name + 'cluster', 24); // 8–31 %
const placedStamps = stamps.map((a, i) => ({
  ...a,
  top: clusterTop + i * 12 + seedRot(name + a.value + 'jt', 3),
  dx: seedRot(name + a.value + 'x', 9),
  rot: seedRot(name + a.value),
}));

// Scotch : asset 1 de 3 + côté haut gauche/droite, seedés
const tapeSrc = `/assets/decor/tape-${1 + seedPick(name + 't', 3)}.webp`;
const tapeRight = seedPick(name + 's', 2) === 1;
const tapeRot = seedRot(name + 'tape', 8);

// Frame torn : 2 cadres alternés (l'historique à 104 % + le grunge t2 à
// 106 %) × orientation seedée (quart de tour + miroir, cadres carrés →
// rotation CSS sans perte, photo contre-tournée) = 16 variations de bord.
const FRAMES = [
  { url: '/assets/textures/torn-frame.png', size: '104%' },
  { url: '/assets/textures/torn-t2.png', size: '106%' },
];
const frame = FRAMES[seedPick(name + 'f', FRAMES.length)];
const maskRot = seedPick(name + 'q', 4) * 90;
const maskFlip = seedPick(name + 'm', 2) === 0 ? 1 : -1;
const mediaStyle = `--murl:url('${frame.url}'); --msize:${frame.size}; --mrot:${maskRot}deg; --mflip:${maskFlip}`;

// Drapeau SVG inliné au build (pages prerendered only) — l'emoji drapeau ne
// rend pas sur Chrome/Windows, le SVG flag-icons est uniforme partout.
let flagSvg: string | undefined;
if (countryCode) {
  try {
    flagSvg = await readFile(
      path.resolve(process.cwd(), 'node_modules/flag-icons/flags/4x3', `${countryCode.toLowerCase()}.svg`),
      'utf8',
    );
  } catch {
    flagSvg = undefined; // code inconnu → plaque sans drapeau
  }
}
---

<article class="fighter" style={`--rot:${rot}deg`}>
  <div class="photo">
    <div class="media" style={mediaStyle}>
      {
        photo ? (
          <img src={photo.src} alt={photo.alt} width={640} height={640} loading="lazy" />
        ) : (
          <span class="ph" aria-hidden="true">
            {initialsOf(name)}
          </span>
        )
      }
    </div>
    <img
      class:list={['tape', tapeRight ? 'tape--right' : 'tape--left']}
      src={tapeSrc}
      alt=""
      width={110}
      height={28}
      loading="lazy"
      aria-hidden="true"
      style={`--trot:${tapeRot}deg`}
    />
    {
      placedStamps.map((s) => (
        <span
          class:list={['stamp', stampSide === 'left' ? 'stamp--left' : 'stamp--right']}
          style={`--top:${s.top}%; --dx:${s.dx}px`}
          aria-hidden="true"
        >
          <AchievementStamp value={s.value} label={s.label} rot={s.rot} />
        </span>
      ))
    }
  </div>

  <div class="plate">
    {flagSvg && <span class="plate-flag" role="img" aria-label={countryCode} set:html={flagSvg} />}
    {name}
    {year != null && <span> · {year}</span>}
  </div>

  {quote && <blockquote class="quote">“{quote}”</blockquote>}
  <div class="sig">{signature}</div>

  {
    stamps.length > 0 && (
      <dl class="sr-only">
        <dt>{achListLabel}</dt>
        {achievements.map((a) => (
          <dd>{a.label}</dd>
        ))}
      </dl>
    )
  }
</article>

<style>
  /* Rotation seedée sur la carte entière : photo, ornement et textes
     tournent ensemble — cohérent et organique (page de scrapbook posée) */
  .fighter {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transform: rotate(var(--rot, -1deg));
  }

  .photo {
    position: relative;
    width: 100%;
  }

  /* Photo incrustée : pas de cadre — le bord déchiré fait la transition
     avec le fond de page. Frame + orientation seedés par card (--murl,
     --msize, --mrot quart de tour, --mflip miroir) : le conteneur masqué
     tourne, la photo est contre-tournée → le bord varie, pas la photo.
     Scratches légères clipées par le même mask (et tournées avec lui). */
  .media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    -webkit-mask-image: var(--murl, url('/assets/textures/torn-frame.png'));
    mask-image: var(--murl, url('/assets/textures/torn-frame.png'));
    -webkit-mask-size: var(--msize, 104%) var(--msize, 104%);
    mask-size: var(--msize, 104%) var(--msize, 104%);
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    transform: rotate(var(--mrot, 0deg)) scaleX(var(--mflip, 1));
  }
  .media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/assets/textures/photo-scratches.png') center / 100% 100% no-repeat;
    mix-blend-mode: screen;
    opacity: 0.18;
    pointer-events: none;
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: contrast(1.06) saturate(0.88) sepia(0.08);
    /* inverse exacte de la transform du conteneur masqué */
    transform: scaleX(var(--mflip, 1)) rotate(calc(-1 * var(--mrot, 0deg)));
  }
  .ph {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--soft-2);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 52px;
    color: var(--line-3);
    transform: scaleX(var(--mflip, 1)) rotate(calc(-1 * var(--mrot, 0deg)));
  }
  .ph::before {
    content: '';
    position: absolute;
    inset: 10%;
    background: var(--forest);
    opacity: 0.09;
    -webkit-mask: url('/assets/logo-only.svg') center / contain no-repeat;
    mask: url('/assets/logo-only.svg') center / contain no-repeat;
  }

  /* Scotch — à cheval sur le bord haut, asset + côté + rotation seedés */
  .tape {
    position: absolute;
    top: -15px;
    width: 110px;
    height: auto;
    z-index: 3;
    transform: rotate(var(--trot, 4deg));
    opacity: 0.92;
  }
  .tape--left {
    left: 14px;
  }
  .tape--right {
    right: 14px;
  }

  /* Stamps — grappe d'un seul côté (seedé), chevauchement vertical léger */
  .stamp {
    position: absolute;
    top: var(--top, 20%);
    z-index: 2;
    transform: translateX(var(--dx, 0));
  }
  .stamp--left {
    left: -30px;
  }
  .stamp--right {
    right: -30px;
  }
  .stamp :global(.ach-stamp--img) {
    height: 55px;
  }

  /* Plaque ornement — chevauche franchement le bas de la photo */
  .plate {
    position: relative;
    z-index: 2;
    margin-top: -30px;
    padding: 13px 34px;
    background: url('/assets/decor/ornament.webp') center / 100% 100% no-repeat;
    font-family: var(--font-accent);
    font-style: italic;
    font-weight: 600;
    font-variation-settings: 'opsz' 30;
    font-size: 17px;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
    max-width: 100%;
  }
  .plate-flag {
    display: inline-block;
    margin-right: 2px;
  }
  .plate-flag :global(svg) {
    width: 20px;
    height: auto;
    border-radius: 2px;
    vertical-align: -2px;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  /* Quote — manuscrite (Caveat), l'entrée au stylo du livre d'or */
  .quote {
    margin: 14px 8px 0;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: clamp(23px, 2.4vw, 27px);
    line-height: 1.2;
    color: var(--forest);
  }
  .sig {
    margin-top: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

</style>
