---
import Button from '../ui/Button.astro';
import ArrowWild from '../ui/ArrowWild.astro';
import DtvStamp from '../ui/DtvStamp.astro';
import LangSwitcher from '../ui/LangSwitcher.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';
import { localePath } from '../../lib/routes';
import { m } from '../../paraglide/messages.js';

/**
 * Nav — mega menu Wildcat (repris du bundle Claude Design, adapté au design system).
 * Tokens (forest #2E5D3C, gold, cream), Satoshi (titres+corps), Fraunces (.em accents).
 * CTA Join = <Button> gold ; CTA cartes promo = pill gold + swoosh.
 * Desktop : mega panels au survol/clic/clavier. Mobile (<1080px) : drawer accordéon.
 * Strings : messages/{locale}.json (m.*) — zéro libellé en dur.
 *
 * Props :
 *  - sticky (def. true) : position sticky ; false = relative (démo styleguide).
 *  - cta : libellé du CTA Join (sinon déduit de la page courante).
 */
export interface Props {
  sticky?: boolean;
  cta?: string;
}
const { sticky = true, cta } = Astro.props;

// Liens localisés (slugs EN dans toutes les locales — src/lib/routes.ts).
// E5 : les clusters pas encore construits pointent vers leur pillar (+ anchor)
// le plus proche — zéro 404 ; les satellites remplaceront ces cibles.
const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

// CTA dynamique selon la page (toujours avec le swoosh).
// Record explicite (pas d'accès dynamique m['...'] — tree-shaking + typage).
const ctaLabels = {
  start_dtv: m.cta_start_dtv(),
  plan_stay: m.cta_plan_stay(),
  book_class: m.cta_book_class(),
  join_now: m.cta_join_now(),
} as const;
function ctaKeyFor(p: string): keyof typeof ctaLabels {
  if (p.includes('/dtv-visa')) return 'start_dtv';
  if (p.includes('/stay-train')) return 'plan_stay';
  if (p.includes('/classes') || p.includes('/schedule') || p.includes('/pricing')) return 'book_class';
  return 'join_now';
}
const ctaLabel = cta ?? ctaLabels[ctaKeyFor(Astro.url.pathname)];
---


<!-- ============ UTILITY BAR ============ -->
<div class="util">
  <div class="wrap">
    <div class="u-left">
      <span class="u-item"><Icon name="tabler:map-pin" class="i" /> {m.nav_util_location()}</span>
      <span class="u-item hide-sm"><span class="dot-open"></span> {m.nav_util_open_today()}</span>
      <span class="u-item hide-sm"><Icon name="tabler:phone" class="i" /> <a href={site.contact.phoneHref}>{site.contact.phone}</a></span>
    </div>
    <div class="u-right">
      <div class="u-soc">
        {site.social.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} /></a>
        ))}
      </div>
      <LangSwitcher />
    </div>
  </div>
</div>

<!-- ============ MAIN NAV ============ -->
<header class:list={['nav', !sticky && 'nav--static']} id="wc-nav">
  <div class="wrap">
    <a class="brand" href={p('/')} aria-label={m.nav_aria_home()}><img src="/assets/logo-horizontal-cream.svg" alt={site.name}></a>

    <nav class="menubar" aria-label={m.nav_aria_primary()}>

      <!-- TRAIN -->
      <div class="mi wide" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">{m.nav_train()}</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega" role="menu">
          <div class="mcol">
            <span class="lab">{m.nav_train_col_classes()}</span>
            <a class="mlink" href={p('/classes/beginners')}><span class="mic"><Icon name="tabler:karate" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_beginner_title()}</span><span class="md">{m.nav_train_beginner_desc()}</span></span></a>
            <a class="mlink" href={p('/classes#programs')}><span class="mic"><Icon name="tabler:chart-bar" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_alllevels_title()}</span><span class="md">{m.nav_train_alllevels_desc()}</span></span></a>
            <a class="mlink" href={p('/classes#programs')}><span class="mic"><Icon name="tabler:user" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_private_title()}</span><span class="md">{m.nav_train_private_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_train_col_everyone()}</span>
            <a class="mlink" href={p('/classes#programs')}><span class="mic"><Icon name="tabler:gender-female" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_women_title()}</span><span class="md">{m.nav_train_women_desc()}</span></span></a>
            <a class="mlink" href={p('/classes#programs')}><span class="mic"><Icon name="tabler:mood-kid" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_kids_title()}</span><span class="md">{m.nav_train_kids_desc()}</span></span></a>
            <a class="mlink" href={p('/fighters')}><span class="mic"><Icon name="tabler:flame" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_fight_title()}</span><span class="md">{m.nav_train_fight_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_train_col_plan()}</span>
            <a class="mlink" href={p('/classes#schedule')}><span class="mic"><Icon name="tabler:calendar-event" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_schedule_title()}</span><span class="md">{m.nav_train_schedule_desc()}</span></span></a>
            <a class="mlink" href={p('/classes#pricing')}><span class="mic"><Icon name="tabler:tag" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_pricing_title()}</span><span class="md">{m.nav_train_pricing_desc()}</span></span></a>
            <a class="mlink" href={p('/contact')}><span class="mic"><Icon name="tabler:sparkles" class="i" /></span><span class="mtx"><span class="mt">{m.nav_train_trial_title()}</span><span class="md">{m.nav_train_trial_desc()}</span></span></a>
          </div>
          <div class="mfeat">
            <span class="ft-tag">{m.nav_train_feat_tag()}</span>
            <h4>{m.nav_train_feat_title()} <span class="em">{m.nav_train_feat_title_em()}</span></h4>
            <p>{m.nav_train_feat_body()}</p>
            <div class="ff"><a class="fbtn" href={p('/contact')}>{m.nav_train_feat_btn()} <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
          <div class="mfoot">
            <div class="links">
              <a href={p('/classes#schedule')}><Icon name="tabler:calendar-event" /> {m.nav_train_foot_schedule()}</a>
              <a href={p('/classes#pricing')}><Icon name="tabler:tag" /> {m.nav_train_foot_passes()}</a>
            </div>
            <a class="allcta" href={p('/classes')}>{m.nav_train_allcta()} <ArrowWild size={18} /></a>
          </div>
        </div>
      </div>

      <!-- STAY & TRAIN -->
      <div class="mi wide" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">{m.nav_stay()}</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega" role="menu">
          <div class="mcol">
            <span class="lab">{m.nav_stay_col_train()}</span>
            <a class="mlink" href={p('/stay-train#packages')}><span class="mic"><Icon name="tabler:route" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_packages_title()}</span><span class="md">{m.nav_stay_packages_desc()}</span></span></a>
            <a class="mlink" href={p('/dtv-visa/long-stay-training')}><span class="mic"><Icon name="tabler:home-2" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_longstay_title()}</span><span class="md">{m.nav_stay_longstay_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_stay_col_logistics()}</span>
            <a class="mlink" href={p('/stay-train#accommodation')}><span class="mic"><Icon name="tabler:bed" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_accom_title()}</span><span class="md">{m.nav_stay_accom_desc()}</span></span></a>
            <a class="mlink" href={p('/stay-train#life')}><span class="mic"><Icon name="tabler:motorbike" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_scooter_title()}</span><span class="md">{m.nav_stay_scooter_desc()}</span></span></a>
            <a class="mlink" href={p('/contact')}><span class="mic"><Icon name="tabler:map-pin" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_getting_title()}</span><span class="md">{m.nav_stay_getting_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_stay_col_explore()}</span>
            <a class="mlink" href={p('/stay-train#life')}><span class="mic"><Icon name="tabler:map-2" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_guide_title()}</span><span class="md">{m.nav_stay_guide_desc()}</span></span></a>
            <a class="mlink" href={p('/stay-train#life')}><span class="mic"><Icon name="tabler:leaf" class="i" /></span><span class="mtx"><span class="mt">{m.nav_stay_todo_title()}</span><span class="md">{m.nav_stay_todo_desc()}</span></span></a>
          </div>
          <div class="mfeat">
            <span class="ft-tag">{m.nav_stay_feat_tag()}</span>
            <h4>{m.nav_stay_feat_title()} <span class="em">{m.nav_stay_feat_title_em()}</span></h4>
            <p>{m.nav_stay_feat_body()}</p>
            <div class="ff"><a class="fbtn" href={p('/stay-train')}>{m.nav_stay_feat_btn()} <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
          <div class="mfoot">
            <div class="links">
              <a href={p('/dtv-visa')}><Icon name="tabler:id" /> {m.nav_stay_foot_dtv()}</a>
            </div>
            <a class="allcta" href={p('/stay-train')}>{m.nav_stay_allcta()} <ArrowWild size={18} /></a>
          </div>
        </div>
      </div>

      <!-- DTV VISA -->
      <div class="mi wide" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">{m.nav_dtv()}</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega" role="menu">
          <div class="mcol">
            <span class="lab">{m.nav_dtv_col_guide()}</span>
            <a class="mlink" href={p('/dtv-visa')}><span class="mic"><Icon name="tabler:id" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_what_title()}</span><span class="md">{m.nav_dtv_what_desc()}</span></span></a>
            <a class="mlink" href={p('/dtv-visa/eligibility')}><span class="mic"><Icon name="tabler:circle-check" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_eligible_title()}</span><span class="md">{m.nav_dtv_eligible_desc()}</span></span></a>
            <a class="mlink" href={p('/dtv-visa/how-to-apply')}><span class="mic"><Icon name="tabler:route" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_apply_title()}</span><span class="md">{m.nav_dtv_apply_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_dtv_col_train()}</span>
            <a class="mlink" href={p('/dtv-visa/muay-thai')}><span class="mic"><Icon name="tabler:karate" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_muaythai_title()}</span><span class="md">{m.nav_dtv_muaythai_desc()}</span></span></a>
            <a class="mlink" href={p('/dtv-visa/long-stay-training')}><span class="mic"><Icon name="tabler:home-2" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_plans_title()}</span><span class="md">{m.nav_dtv_plans_desc()}</span></span></a>
            <a class="mlink" href={p('/dtv-visa/how-to-apply#documents')}><span class="mic"><Icon name="tabler:file-text" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_docs_title()}</span><span class="md">{m.nav_dtv_docs_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_dtv_col_help()}</span>
            <a class="mlink" href={p('/dtv-visa/faq')}><span class="mic"><Icon name="tabler:help-circle" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_faq_title()}</span><span class="md">{m.nav_dtv_faq_desc()}</span></span></a>
            <a class="mlink" href={p('/contact')}><span class="mic"><Icon name="tabler:message-circle" class="i" /></span><span class="mtx"><span class="mt">{m.nav_dtv_talk_title()}</span><span class="md">{m.nav_dtv_talk_desc()}</span></span></a>
          </div>
          <div class="mfeat gold">
            <DtvStamp size={88} shadow={false} class="feat-stamp" />
            <h4>{m.nav_dtv_feat_title()} <span class="em">{m.nav_dtv_feat_title_em()}</span></h4>
            <p>{m.nav_dtv_feat_body()}</p>
            <div class="ff"><a class="fbtn" href={p('/dtv-visa')}>{m.cta_start_dtv()} <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
          <div class="mfoot">
            <div class="links">
              <a href={p('/stay-train')}><Icon name="tabler:motorbike" /> {m.nav_dtv_foot_scooter()}</a>
              <a href={p('/stay-train')}><Icon name="tabler:bed" /> {m.nav_dtv_foot_accom()}</a>
            </div>
            <a class="allcta" href={p('/dtv-visa')}>{m.nav_dtv_allcta()} <ArrowWild size={18} /></a>
          </div>
        </div>
      </div>

      <!-- ABOUT -->
      <div class="mi" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">{m.nav_about()}</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega mega--about" role="menu">
          <div class="mcol">
            <span class="lab">{m.nav_about_col_wildcat()}</span>
            <a class="mlink" href={p('/about')}><span class="mic"><Icon name="tabler:leaf" class="i" /></span><span class="mtx"><span class="mt">{m.nav_about_story_title()}</span><span class="md">{m.nav_about_story_desc()}</span></span></a>
            <a class="mlink" href={p('/about/coaches')}><span class="mic"><Icon name="tabler:user" class="i" /></span><span class="mtx"><span class="mt">{m.nav_about_coaches_title()}</span><span class="md">{m.nav_about_coaches_desc()}</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">{m.nav_about_col_community()}</span>
            <a class="mlink" href={p('/about#community')}><span class="mic"><Icon name="tabler:users" class="i" /></span><span class="mtx"><span class="mt">{m.nav_about_community_title()}</span><span class="md">{m.nav_about_community_desc()}</span></span></a>
            {/* Gallery : réintégrer avec la vraie galerie (E9) */}
            <a class="mlink" href={p('/about#reviews')}><span class="mic"><Icon name="tabler:star" class="i" /></span><span class="mtx"><span class="mt">{m.nav_about_reviews_title()}</span><span class="md">{m.nav_about_reviews_desc()}</span></span></a>
          </div>
          <div class="mfeat">
            <span class="ft-tag">{m.nav_about_feat_tag()}</span>
            <h4>{m.nav_about_feat_title()} <span class="em">{m.nav_about_feat_title_em()}</span></h4>
            <p>{m.nav_about_feat_body()}</p>
            <div class="ff"><a class="fbtn" href={p('/about')}>{m.nav_about_feat_btn()} <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
        </div>
      </div>

      <!-- SIMPLE LINKS -->
      <!-- Blog : href="#" jusqu'à E8 -->
      <div class="mi"><a href="#"><span class="lbl">{m.nav_blog()}</span></a></div>
      <div class="mi"><a href={p('/contact')}><span class="lbl">{m.nav_contact()}</span></a></div>
      <div class="mi cta"><Button variant="gold" flat arrow href={p('/contact')}>{ctaLabel}</Button></div>
    </nav>

    <button class="nav-toggle" aria-label={m.nav_aria_open_menu()} data-drawer-open>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- ============ MOBILE DRAWER ============ -->
<div class="drawer" id="wc-drawer">
  <div class="scrim" data-drawer-close></div>
  <div class="panel">
    <div class="dh"><img src="/assets/logo-horizontal-cream.svg" alt={site.name}><button class="x" aria-label={m.nav_aria_close()} data-drawer-close>×</button></div>
    <div class="dbody">
      <details open><summary>{m.nav_train()} <span class="pm">+</span></summary><div class="sub-links"><a href={p('/classes#programs')}><span class="dot"></span> {m.nav_train_beginner_title()}</a><a href={p('/classes#programs')}><span class="dot"></span> {m.nav_drawer_alllevels()}</a><a href={p('/classes#programs')}><span class="dot"></span> {m.nav_train_private_title()}</a><a href={p('/classes#programs')}><span class="dot"></span> {m.nav_train_women_title()}</a><a href={p('/classes#programs')}><span class="dot"></span> {m.nav_train_kids_title()}</a><a href={p('/fighters')}><span class="dot"></span> {m.nav_train_fight_title()}</a><a href={p('/classes#schedule')}><span class="dot"></span> {m.nav_drawer_schedule_pricing()}</a></div></details>
      <details><summary>{m.nav_stay()} <span class="pm">+</span></summary><div class="sub-links"><a href={p('/stay-train#packages')}><span class="dot"></span> {m.nav_drawer_packages()}</a><a href={p('/stay-train#accommodation')}><span class="dot"></span> {m.nav_drawer_accommodation()}</a><a href={p('/stay-train#life')}><span class="dot"></span> {m.nav_stay_scooter_title()}</a><a href={p('/contact')}><span class="dot"></span> {m.nav_stay_getting_title()}</a><a href={p('/stay-train#life')}><span class="dot"></span> {m.nav_stay_guide_title()}</a></div></details>
      <details><summary>{m.nav_dtv()} <span class="pm">+</span></summary><div class="sub-links"><a href={p('/dtv-visa')}><span class="dot"></span> {m.nav_drawer_dtv_guide()}</a><a href={p('/dtv-visa/eligibility')}><span class="dot"></span> {m.nav_dtv_eligible_title()}</a><a href={p('/dtv-visa/how-to-apply')}><span class="dot"></span> {m.nav_dtv_apply_title()}</a><a href={p('/dtv-visa/muay-thai')}><span class="dot"></span> {m.nav_dtv_muaythai_title()}</a><a href={p('/dtv-visa/long-stay-training')}><span class="dot"></span> {m.nav_dtv_plans_title()}</a><a href={p('/dtv-visa/faq')}><span class="dot"></span> {m.nav_dtv_faq_title()}</a></div></details>
      <details><summary>{m.nav_about()} <span class="pm">+</span></summary><div class="sub-links"><a href={p('/about')}><span class="dot"></span> {m.nav_about_story_title()}</a><a href={p('/about/coaches')}><span class="dot"></span> {m.nav_drawer_coaches()}</a><a href={p('/about#community')}><span class="dot"></span> {m.nav_about_col_community()}</a><a href={p('/about#reviews')}><span class="dot"></span> {m.nav_about_reviews_title()}</a></div></details>
      <!-- Blog : href="#" jusqu'à E8 -->
      <a class="flat" href="#">{m.nav_blog()}</a>
      <a class="flat" href={p('/contact')}>{m.nav_contact()}</a>
      <Button variant="gold" flat arrow href={p('/contact')} class="djoin">{ctaLabel}</Button>
    </div>
  </div>
</div>

<style>
  .util {
    background: var(--forest-deep);
    color: rgba(246, 241, 230, 0.72);
    font-size: 12.5px;
  }
  .util .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    gap: 18px;
  }
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 32px);
  }
  .util .u-left { display: flex; align-items: center; gap: 18px; }
  .util .u-item { display: flex; align-items: center; gap: 7px; white-space: nowrap; }
  .util .u-item svg { width: 14px; height: 14px; color: var(--gold); }
  .util .dot-open { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px var(--success-glow); }
  .util .u-right { display: flex; align-items: center; gap: 16px; }
  .util .u-soc { display: flex; gap: 11px; }
  .util .u-soc a { display: flex; opacity: 0.8; transition: 0.15s; }
  .util .u-soc a:hover { opacity: 1; color: var(--gold); }
  .util .u-soc svg { width: 15px; height: 15px; }
  /* styles du switch EN/FR : voir LangSwitcher.astro */

  /* MAIN NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 80;
    background: var(--forest);
    color: var(--cream);
    border-bottom: 1px solid rgba(246, 241, 230, 0.1);
    font-family: var(--font-display);
  }
  .nav--static { position: relative; }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 74px; }
  .brand img { height: 44px; width: auto; display: block; }
  .menubar { display: flex; align-items: stretch; height: 74px; gap: 2px; }
  .mi { position: relative; display: flex; align-items: center; }
  .mi > a,
  .mi > button {
    font-family: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    color: rgba(246, 241, 230, 0.85);
    font-weight: 600;
    font-size: 14.5px;
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 15px;
    position: relative;
  }
  .mi > a:hover,
  .mi > button:hover,
  .mi.open > button { color: var(--cream); }
  .mi > button .caret { width: 11px; height: 11px; transition: transform 0.22s ease; opacity: 0.7; }
  .mi.open > button .caret { transform: rotate(180deg); }
  /* gold underline indicator — sous le texte (pas au bas de la navbar) */
  .lbl { position: relative; display: inline-block; }
  .lbl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.22s ease;
  }
  .mi:hover > a .lbl::after,
  .mi:hover > button .lbl::after,
  .mi.open > button .lbl::after { transform: scaleX(1); }
  .mi.cta { margin-left: 10px; }
  .nav-toggle { display: none; background: none; border: 0; color: var(--cream); cursor: pointer; }
  .nav-toggle svg { width: 28px; height: 28px; }
  svg.i { width: 20px; height: 20px; flex: 0 0 auto; }
  .caret { display: inline-block; }

  /* Focus visible — accessibilité clavier */
  .mi > a:focus-visible,
  .mi > button:focus-visible,
  .util .u-soc a:focus-visible,
  .mlink:focus-visible,
  .fbtn:focus-visible,
  .mega .mfoot a:focus-visible,
  .allcta:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }

  /* MEGA PANEL */
  .mega {
    --shift: 0px;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(calc(-50% + var(--shift)), 8px);
    width: min(1100px, calc(100vw - 24px));
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: 0 30px 70px -34px rgba(20, 35, 25, 0.55);
    padding: 26px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 0.92fr;
    gap: 8px 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 90;
  }
  /* bridge transparent pour combler le gap navbar↔panel au survol */
  .mega::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .mega--about { grid-template-columns: 1fr 1fr 0.95fr; width: min(720px, calc(100vw - 24px)); }
  .mi.open .mega { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(calc(-50% + var(--shift)), 0); }

  .mcol { display: flex; flex-direction: column; }
  .mcol .lab {
    font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gold-deep); margin: 2px 0 12px; display: flex; align-items: center; gap: 7px;
  }
  .mcol .lab::before { content: '◆'; color: var(--orange); font-size: 9px; }
  .mlink { display: flex; gap: 11px; align-items: flex-start; padding: 9px 10px; border-radius: var(--r-sm); transition: 0.14s; margin: 0 -10px; }
  .mlink:hover { background: var(--soft); }
  .mlink .mic { width: 34px; height: 34px; flex: 0 0 auto; border-radius: 9px; background: var(--soft-2); color: var(--forest); display: flex; align-items: center; justify-content: center; transition: 0.14s; }
  .mlink:hover .mic { background: var(--forest); color: var(--gold); }
  .mlink .mtx { min-width: 0; }
  .mlink .mt { display: block; font-weight: 700; font-size: 14.5px; color: var(--forest); line-height: 1.25; white-space: nowrap; }
  .mlink .md { display: block; font-size: 12.5px; color: var(--ink-2); line-height: 1.35; margin-top: 2px; }

  /* featured promo card */
  .mfeat { background: var(--forest); color: var(--cream); border-radius: var(--r-md); padding: 20px; display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .mfeat.gold { background: radial-gradient(120% 90% at 80% 0, var(--forest-light), var(--forest)); }
  .mfeat .ft-tag { font-size: 10.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .mfeat h4 { font-family: var(--font-display); font-weight: 800; font-size: 19px; line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 7px; }
  .mfeat h4 .em { color: var(--gold); }
  .mfeat p { font-size: 12.5px; color: rgba(246, 241, 230, 0.74); line-height: 1.45; margin: 0 0 16px; }
  .mfeat .ff { margin-top: auto; }
  .fbtn { display: inline-flex; align-items: center; gap: 8px; background: var(--gold); color: var(--charcoal); font-family: var(--font-display); font-weight: 700; font-size: 13px; padding: 9px 16px; border-radius: 999px; transition: 0.16s; }
  .fbtn:hover { background: color-mix(in srgb, var(--gold), #fff 10%); }
  .fbtn-ar { transition: transform 0.18s ease; }
  .fbtn:hover .fbtn-ar { transform: translateX(3px); }
  /* sceau DTV : asset officiel via <DtvStamp /> (l'ancien sceau CSS .dtv-mini est retiré) */
  .mfeat :global(.feat-stamp) { margin: 0 0 14px; }

  /* mega footer strip */
  .mega .mfoot { grid-column: 1 / -1; margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .mega .mfoot .links { display: flex; gap: 18px; flex-wrap: wrap; }
  .mega .mfoot a { font-size: 12.5px; font-weight: 600; color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px; }
  .mega .mfoot a:hover { color: var(--forest); }
  .mega .mfoot .links a svg { width: 14px; height: 14px; color: var(--gold-deep); }
  .mega .mfoot .allcta { font-size: 12.5px; font-weight: 700; color: var(--gold-deep); display: inline-flex; align-items: center; gap: 6px; }

  /* RESPONSIVE */
  @media (max-width: 1080px) {
    .menubar { display: none; }
    .nav-toggle { display: block; }
  }

  /* MOBILE DRAWER */
  .drawer { display: none; position: fixed; inset: 0; z-index: 200; }
  .drawer.open { display: block; }
  .drawer .scrim { position: absolute; inset: 0; background: rgba(17, 17, 17, 0.55); }
  .drawer .panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(86vw, 360px); background: var(--cream); overflow-y: auto; box-shadow: 0 30px 70px -34px rgba(20, 35, 25, 0.55); font-family: var(--font-display); }
  .drawer .dh { position: sticky; top: 0; background: var(--forest); display: flex; align-items: center; justify-content: space-between; padding: 16px; }
  .drawer .dh img { height: 32px; }
  .drawer .dh .x { background: none; border: 0; color: var(--cream); font-size: 28px; cursor: pointer; line-height: 1; }
  .drawer .dbody { padding: 8px 14px 30px; }
  .drawer details { border-bottom: 1px solid var(--line); }
  .drawer summary { list-style: none; cursor: pointer; padding: 15px 6px; display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 16px; color: var(--forest); }
  .drawer summary::-webkit-details-marker { display: none; }
  .drawer summary .pm { color: var(--gold-deep); font-size: 20px; transition: 0.2s; }
  .drawer details[open] summary .pm { transform: rotate(45deg); }
  .drawer .sub-links { padding: 0 6px 12px; display: flex; flex-direction: column; gap: 1px; }
  .drawer .sub-links a { padding: 10px 12px; font-size: 14px; font-weight: 600; color: var(--ink-2); border-radius: 7px; display: flex; align-items: center; gap: 9px; }
  .drawer .sub-links a:hover { background: var(--soft); color: var(--forest); }
  .drawer .sub-links a .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }
  .drawer .flat { padding: 15px 6px; font-weight: 700; font-size: 16px; color: var(--forest); border-bottom: 1px solid var(--line); display: block; }
  .drawer :global(.djoin) { margin: 18px 6px 0; width: calc(100% - 12px); justify-content: center; }

  /* Reduced motion — neutralise les transitions du nav */
  @media (prefers-reduced-motion: reduce) {
    .mi > button .caret,
    .lbl::after,
    .mega,
    .mlink,
    .fbtn-ar,
    .drawer summary .pm { transition: none; }
  }
</style>

<script>
  (function () {
    const items = Array.from(document.querySelectorAll('.mi[data-mega]'));
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function closeAll(except?: Element | null) {
      items.forEach((it) => {
        if (it !== except) {
          it.classList.remove('open');
          it.querySelector('button')?.setAttribute('aria-expanded', 'false');
        }
      });
    }
    function clamp(it: Element) {
      const p = it.querySelector('.mega') as HTMLElement | null;
      if (!p) return;
      p.style.setProperty('--shift', '0px');
      const r = p.getBoundingClientRect();
      const m = 12;
      let shift = 0;
      if (r.right > window.innerWidth - m) shift -= r.right - (window.innerWidth - m);
      if (r.left + shift < m) shift += m - (r.left + shift);
      if (shift) p.style.setProperty('--shift', Math.round(shift) + 'px');
    }
    function open(it: Element) {
      if (closeTimer) clearTimeout(closeTimer);
      closeAll(it);
      it.classList.add('open');
      it.querySelector('button')?.setAttribute('aria-expanded', 'true');
      clamp(it);
    }
    function close(it: Element) {
      it.classList.remove('open');
      it.querySelector('button')?.setAttribute('aria-expanded', 'false');
    }

    items.forEach((it) => {
      const btn = it.querySelector('button');
      it.addEventListener('mouseenter', () => open(it));
      it.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(() => close(it), 120);
      });
      btn?.addEventListener('click', (e) => {
        e.preventDefault();
        it.classList.contains('open') ? close(it) : open(it);
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll(null);
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as Element)?.closest('.menubar')) closeAll(null);
    });

    // mobile drawer
    const drawer = document.getElementById('wc-drawer');
    document.querySelectorAll('[data-drawer-open]').forEach((b) =>
      b.addEventListener('click', () => drawer?.classList.add('open'))
    );
    document.querySelectorAll('[data-drawer-close]').forEach((b) =>
      b.addEventListener('click', () => drawer?.classList.remove('open'))
    );
  })();
</script>
