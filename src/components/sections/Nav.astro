---
import Button from '../ui/Button.astro';
import LangSwitcher from '../ui/LangSwitcher.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';
import { localePath } from '../../lib/routes';
import { m } from '../../paraglide/messages.js';

/**
 * Nav — navigation principale Wildcat (dropdowns compacts 1 colonne, 1 lien = 1 vraie page).
 * Tokens (forest #2E5D3C, gold, cream), Satoshi (titres+corps).
 * CTA Join = <Button> gold + swoosh dynamique selon la page.
 * Desktop : menus déroulants compacts au survol/clic/clavier. Mobile (<1080px) : drawer accordéon.
 * Strings : messages/{locale}.json (m.*) — zéro libellé en dur.
 *
 * Props :
 *  - sticky (def. true) : position sticky ; false = relative (démo styleguide).
 *  - cta : libellé du CTA Join (sinon déduit de la page courante).
 *  - alternates : hreflang asymétriques (articles blog, slugs traduits) —
 *    transmis tel quel au LangSwitcher (vient de BaseLayout).
 */
export interface Props {
  sticky?: boolean;
  cta?: string;
  alternates?: { lang: string; href: string }[];
}
const { sticky = true, cta, alternates } = Astro.props;

const lang = Astro.currentLocale ?? 'en';
const p = (path: string) => localePath(lang, path);

// CTA dynamique selon la page (toujours avec le swoosh).
// Record explicite (pas d'accès dynamique m['...'] — tree-shaking + typage).
const ctaLabels = {
  start_dtv: m.cta_start_dtv(),
  plan_stay: m.cta_plan_stay(),
  book_class: m.cta_book_class(),
  join_now: m.cta_join_now(),
} as const;
function ctaKeyFor(path: string): keyof typeof ctaLabels {
  if (path.includes('/dtv-visa')) return 'start_dtv';
  if (path.includes('/stay-train')) return 'plan_stay';
  if (path.includes('/classes') || path.includes('/schedule') || path.includes('/pricing')) return 'book_class';
  return 'join_now';
}
// La cible suit le label : form pré-ciblé (?intent=) ou form séjour inline.
const ctaTargets: Record<keyof typeof ctaLabels, string> = {
  start_dtv: `${p('/contact')}?intent=dtv`,
  plan_stay: `${p('/stay-train')}#plan`,
  book_class: `${p('/contact')}?intent=class`,
  join_now: `${p('/contact')}?intent=class`,
};
const ctaKey = ctaKeyFor(Astro.url.pathname);
const ctaLabel = cta ?? ctaLabels[ctaKey];
const ctaHref = cta ? p('/contact') : ctaTargets[ctaKey];

const menus = [
  {
    label: m.nav_train(),
    openDefault: true,
    items: [
      { href: p('/classes'), icon: 'tabler:calendar-event', title: m.nav_train_classes_title(), desc: m.nav_train_classes_desc() },
      { href: p('/classes/beginners'), icon: 'tabler:karate', title: m.nav_train_beginner_title(), desc: m.nav_train_beginner_desc() },
      { href: p('/fighters'), icon: 'tabler:flame', title: m.nav_train_fight_title(), desc: m.nav_train_fight_desc() },
    ],
  },
  {
    label: m.nav_stay(),
    openDefault: false,
    items: [
      { href: p('/stay-train'), icon: 'tabler:route', title: m.nav_stay_packages_title(), desc: m.nav_stay_packages_desc() },
      { href: p('/stay-train/scooter-rental'), icon: 'tabler:motorbike', title: m.nav_stay_scooter_title(), desc: m.nav_stay_scooter_desc() },
      { href: p('/chiang-mai-guide'), icon: 'tabler:map-2', title: m.nav_stay_guide_title(), desc: m.nav_stay_guide_desc() },
    ],
  },
  {
    label: m.nav_dtv(),
    openDefault: false,
    items: [
      { href: p('/dtv-visa'), icon: 'tabler:id', title: m.nav_dtv_what_title(), desc: m.nav_dtv_what_desc() },
      { href: p('/dtv-visa/eligibility'), icon: 'tabler:circle-check', title: m.nav_dtv_eligible_title(), desc: m.nav_dtv_eligible_desc() },
      { href: p('/dtv-visa/how-to-apply'), icon: 'tabler:route', title: m.nav_dtv_apply_title(), desc: m.nav_dtv_apply_desc() },
      { href: p('/dtv-visa/long-stay-training'), icon: 'tabler:home-2', title: m.nav_dtv_plans_title(), desc: m.nav_dtv_plans_desc() },
    ],
  },
  {
    label: m.nav_about(),
    openDefault: false,
    items: [
      { href: p('/about'), icon: 'tabler:leaf', title: m.nav_about_story_title(), desc: m.nav_about_story_desc() },
      { href: p('/about/coaches'), icon: 'tabler:user', title: m.nav_about_coaches_title(), desc: m.nav_about_coaches_desc() },
    ],
  },
];
---

<!-- ============ UTILITY BAR ============ -->
<div class="util">
  <div class="wrap">
    <div class="u-left">
      <span class="u-item"><Icon name="tabler:map-pin" class="i" /> {m.nav_util_location()}</span>
      <span class="u-item hide-sm"><span class="dot-open"></span> {m.nav_util_open_today()}</span>
      <span class="u-item hide-sm"><Icon name="tabler:phone" class="i" /> <a href={site.contact.phoneHref}>{site.contact.phone}</a></span>
    </div>
    <div class="u-right">
      <div class="u-soc">
        {site.social.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} /></a>
        ))}
      </div>
      <LangSwitcher alternates={alternates} />
    </div>
  </div>
</div>

<!-- ============ MAIN NAV ============ -->
<header class:list={['nav', !sticky && 'nav--static']} id="wc-nav">
  <div class="wrap">
    <a class="brand" href={p('/')} aria-label={m.nav_aria_home()}><img src="/assets/logo-horizontal-cream.svg" alt={site.name}></a>

    <nav class="menubar" aria-label={m.nav_aria_primary()}>
      {menus.map((menu) => (
        <div class="mi" data-drop>
          <button aria-haspopup="true" aria-expanded="false">
            <span class="lbl">{menu.label}</span>
            <Icon name="tabler:chevron-down" class="caret" />
          </button>
          <div class="drop" role="menu">
            {menu.items.map((item) => (
              <a class="mlink" href={item.href} role="menuitem">
                <span class="mic"><Icon name={item.icon} class="i" /></span>
                <span class="mtx">
                  <span class="mt">{item.title}</span>
                  <span class="md">{item.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}

      <div class="mi"><a href={p('/blog')}><span class="lbl">{m.nav_blog()}</span></a></div>
      <div class="mi"><a href={p('/contact')}><span class="lbl">{m.nav_contact()}</span></a></div>
      <div class="mi cta"><Button variant="gold" flat arrow href={ctaHref}>{ctaLabel}</Button></div>
    </nav>

    <button class="nav-toggle" aria-label={m.nav_aria_open_menu()} data-drawer-open>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- ============ MOBILE DRAWER ============ -->
<div class="drawer" id="wc-drawer">
  <div class="scrim" data-drawer-close></div>
  <div class="panel">
    <div class="dh"><img src="/assets/logo-horizontal-cream.svg" alt={site.name}><button class="x" aria-label={m.nav_aria_close()} data-drawer-close>×</button></div>
    <div class="dbody">
      {menus.map((menu) => (
        <details open={menu.openDefault}>
          <summary>{menu.label} <span class="pm">+</span></summary>
          <div class="sub-links">
            {menu.items.map((item) => (
              <a href={item.href}><span class="dot"></span> {item.title}</a>
            ))}
          </div>
        </details>
      ))}
      <a class="flat" href={p('/blog')}>{m.nav_blog()}</a>
      <a class="flat" href={p('/contact')}>{m.nav_contact()}</a>
      <Button variant="gold" flat arrow href={ctaHref} class="djoin">{ctaLabel}</Button>
    </div>
  </div>
</div>

<style>
  .util {
    background: var(--forest-deep);
    color: rgba(246, 241, 230, 0.72);
    font-size: 12.5px;
  }
  .util .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    gap: 18px;
  }
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 32px);
  }
  .util .u-left { display: flex; align-items: center; gap: 18px; }
  .util .u-item { display: flex; align-items: center; gap: 7px; white-space: nowrap; }
  .util .u-item svg { width: 14px; height: 14px; color: var(--gold); }
  .util .dot-open { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px var(--success-glow); }
  .util .u-right { display: flex; align-items: center; gap: 16px; }
  .util .u-soc { display: flex; gap: 11px; }
  .util .u-soc a { display: flex; opacity: 0.8; transition: 0.15s; }
  .util .u-soc a:hover { opacity: 1; color: var(--gold); }
  .util .u-soc svg { width: 15px; height: 15px; }
  @media (max-width: 780px) {
    .util .u-item.hide-sm { display: none; }
    .util .wrap { gap: 12px; }
    .util .u-left { gap: 12px; min-width: 0; }
    .util .u-item { overflow: hidden; }
  }

  /* MAIN NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 80;
    background: var(--forest);
    color: var(--cream);
    border-bottom: 1px solid rgba(246, 241, 230, 0.1);
    font-family: var(--font-display);
  }
  .nav--static { position: relative; }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 74px; }
  .brand img { height: 44px; width: auto; display: block; }
  .menubar { display: flex; align-items: stretch; height: 74px; gap: 2px; }
  .mi { position: relative; display: flex; align-items: center; }
  .mi > a,
  .mi > button {
    font-family: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    color: rgba(246, 241, 230, 0.85);
    font-weight: 600;
    font-size: 14.5px;
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 15px;
    position: relative;
  }
  .mi > a:hover,
  .mi > button:hover,
  .mi.open > button { color: var(--cream); }
  .mi > button .caret { width: 11px; height: 11px; transition: transform 0.22s ease; opacity: 0.7; }
  .mi.open > button .caret { transform: rotate(180deg); }
  .lbl { position: relative; display: inline-block; }
  .lbl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.22s ease;
  }
  .mi:hover > a .lbl::after,
  .mi:hover > button .lbl::after,
  .mi.open > button .lbl::after { transform: scaleX(1); }
  .mi.cta { margin-left: 10px; }
  .nav-toggle { display: none; background: none; border: 0; color: var(--cream); cursor: pointer; }
  .nav-toggle svg { width: 28px; height: 28px; }
  svg.i { width: 20px; height: 20px; flex: 0 0 auto; }
  .caret { display: inline-block; }

  /* Focus visible — accessibilité clavier */
  .mi > a:focus-visible,
  .mi > button:focus-visible,
  .util .u-soc a:focus-visible,
  .mlink:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }

  /* COMPACT DROPDOWN PANEL */
  .drop {
    --shift: 0px;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(calc(-50% + var(--shift)), 8px);
    width: min(340px, calc(100vw - 24px));
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: 0 24px 56px -28px rgba(20, 35, 25, 0.5);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.18s ease, transform 0.18s ease;
    z-index: 90;
  }
  /* bridge transparent pour combler le gap navbar↔panel au survol */
  .drop::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .mi.open .drop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(calc(-50% + var(--shift)), 0);
  }

  .mlink {
    display: flex;
    gap: 11px;
    align-items: flex-start;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    transition: background 0.14s;
  }
  .mlink:hover { background: var(--soft); }
  .mlink .mic {
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    border-radius: 9px;
    background: var(--soft-2);
    color: var(--forest);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.14s, color 0.14s;
  }
  .mlink:hover .mic { background: var(--forest); color: var(--gold); }
  .mlink .mtx { min-width: 0; }
  .mlink .mt { display: block; font-weight: 700; font-size: 14.5px; color: var(--forest); line-height: 1.25; }
  .mlink .md { display: block; font-size: 12.5px; color: var(--ink-2); line-height: 1.35; margin-top: 2px; }

  /* RESPONSIVE */
  @media (max-width: 1080px) {
    .menubar { display: none; }
    .nav-toggle { display: block; }
  }

  /* MOBILE DRAWER */
  .drawer { display: none; position: fixed; inset: 0; z-index: 200; }
  .drawer.open { display: block; }
  .drawer .scrim { position: absolute; inset: 0; background: rgba(17, 17, 17, 0.55); }
  .drawer .panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(86vw, 360px); background: var(--cream); overflow-y: auto; box-shadow: 0 30px 70px -34px rgba(20, 35, 25, 0.55); font-family: var(--font-display); }
  .drawer .dh { position: sticky; top: 0; background: var(--forest); display: flex; align-items: center; justify-content: space-between; padding: 16px; }
  .drawer .dh img { height: 32px; }
  .drawer .dh .x { background: none; border: 0; color: var(--cream); font-size: 28px; cursor: pointer; line-height: 1; }
  .drawer .dbody { padding: 8px 14px 30px; }
  .drawer details { border-bottom: 1px solid var(--line); }
  .drawer summary { list-style: none; cursor: pointer; padding: 15px 6px; display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 16px; color: var(--forest); }
  .drawer summary::-webkit-details-marker { display: none; }
  .drawer summary .pm { color: var(--gold-deep); font-size: 20px; transition: 0.2s; }
  .drawer details[open] summary .pm { transform: rotate(45deg); }
  .drawer .sub-links { padding: 0 6px 12px; display: flex; flex-direction: column; gap: 1px; }
  .drawer .sub-links a { padding: 10px 12px; font-size: 14px; font-weight: 600; color: var(--ink-2); border-radius: 7px; display: flex; align-items: center; gap: 9px; }
  .drawer .sub-links a:hover { background: var(--soft); color: var(--forest); }
  .drawer .sub-links a .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }
  .drawer .flat { padding: 15px 6px; font-weight: 700; font-size: 16px; color: var(--forest); border-bottom: 1px solid var(--line); display: block; }
  .drawer :global(.djoin) { margin: 18px 6px 0; width: calc(100% - 12px); justify-content: center; }

  @media (prefers-reduced-motion: reduce) {
    .mi > button .caret,
    .lbl::after,
    .drop,
    .mlink,
    .mlink .mic,
    .drawer summary .pm { transition: none; }
  }
</style>

<script>
  (function () {
    const items = Array.from(document.querySelectorAll('.mi[data-drop]'));
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function closeAll(except?: Element | null) {
      items.forEach((it) => {
        if (it !== except) {
          it.classList.remove('open');
          it.querySelector('button')?.setAttribute('aria-expanded', 'false');
        }
      });
    }
    function clamp(it: Element) {
      const p = it.querySelector('.drop') as HTMLElement | null;
      if (!p) return;
      p.style.setProperty('--shift', '0px');
      const r = p.getBoundingClientRect();
      const m = 12;
      let shift = 0;
      if (r.right > window.innerWidth - m) shift -= r.right - (window.innerWidth - m);
      if (r.left + shift < m) shift += m - (r.left + shift);
      if (shift) p.style.setProperty('--shift', Math.round(shift) + 'px');
    }
    function open(it: Element) {
      if (closeTimer) clearTimeout(closeTimer);
      closeAll(it);
      it.classList.add('open');
      it.querySelector('button')?.setAttribute('aria-expanded', 'true');
      clamp(it);
    }
    function close(it: Element) {
      it.classList.remove('open');
      it.querySelector('button')?.setAttribute('aria-expanded', 'false');
    }

    items.forEach((it) => {
      const btn = it.querySelector('button');
      it.addEventListener('mouseenter', () => open(it));
      it.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(() => close(it), 120);
      });
      btn?.addEventListener('click', (e) => {
        e.preventDefault();
        it.classList.contains('open') ? close(it) : open(it);
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll(null);
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as Element)?.closest('.menubar')) closeAll(null);
    });

    // mobile drawer
    const drawer = document.getElementById('wc-drawer');
    document.querySelectorAll('[data-drawer-open]').forEach((b) =>
      b.addEventListener('click', () => drawer?.classList.add('open'))
    );
    document.querySelectorAll('[data-drawer-close]').forEach((b) =>
      b.addEventListener('click', () => drawer?.classList.remove('open'))
    );
  })();
</script>
