---
import Button from '../ui/Button.astro';
import ArrowWild from '../ui/ArrowWild.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../../config/site';

/**
 * Nav — mega menu Wildcat (repris du bundle Claude Design, adapté au design system).
 * Tokens (forest #2E5D3C, gold, cream), Satoshi (titres+corps), Fraunces (.em accents).
 * CTA Join = <Button> gold ; CTA cartes promo = pill gold + swoosh.
 * Desktop : mega panels au survol/clic/clavier. Mobile (<1080px) : drawer accordéon.
 *
 * Props :
 *  - sticky (def. true) : position sticky ; false = relative (démo styleguide).
 *  - cta : libellé du CTA Join (sinon déduit de la page courante).
 */
export interface Props {
  sticky?: boolean;
  cta?: string;
}
const { sticky = true, cta } = Astro.props;

// CTA dynamique selon la page (toujours avec le swoosh).
function ctaFor(p: string): string {
  if (p.includes('/dtv-visa')) return 'Start your DTV';
  if (p.includes('/stay-train')) return 'Plan your stay';
  if (p.includes('/classes') || p.includes('/schedule') || p.includes('/pricing')) return 'Book a class';
  return 'Join now';
}
const ctaLabel = cta ?? ctaFor(Astro.url.pathname);
---


<!-- ============ UTILITY BAR ============ -->
<div class="util">
  <div class="wrap">
    <div class="u-left">
      <span class="u-item"><Icon name="tabler:map-pin" class="i" /> Hang Dong, Chiang Mai</span>
      <span class="u-item hide-sm"><span class="dot-open"></span> Open today · 07:00–21:00</span>
      <span class="u-item hide-sm"><Icon name="tabler:phone" class="i" /> <a href={site.contact.phoneHref}>{site.contact.phone}</a></span>
    </div>
    <div class="u-right">
      <div class="u-soc">
        {site.social.map((s) => (
          <a href={s.href} aria-label={s.label} target="_blank" rel="noopener"><Icon name={s.icon} /></a>
        ))}
      </div>
      <span class="lang"><b>EN</b> <span>/</span> FR</span>
    </div>
  </div>
</div>

<!-- ============ MAIN NAV ============ -->
<header class:list={['nav', !sticky && 'nav--static']} id="wc-nav">
  <div class="wrap">
    <a class="brand" href="#" aria-label="Wildcat Muay Thai home"><img src="/assets/logo-cream.png" alt="Wildcat Muay Thai"></a>

    <nav class="menubar" aria-label="Primary">

      <!-- TRAIN -->
      <div class="mi wide" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">Train</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega" role="menu">
          <div class="mcol">
            <span class="lab">Classes</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:karate" class="i" /></span><span class="mtx"><span class="mt">Beginner Muay Thai</span><span class="md">Start from zero — no experience needed</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:chart-bar" class="i" /></span><span class="mtx"><span class="mt">All-Levels Classes</span><span class="md">Daily group training for everyone</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:user" class="i" /></span><span class="mtx"><span class="mt">Private Sessions</span><span class="md">One-on-one with a Kru</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">For everyone</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:gender-female" class="i" /></span><span class="mtx"><span class="mt">Women's Muay Thai</span><span class="md">A welcoming, supportive space</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:mood-kid" class="i" /></span><span class="mtx"><span class="mt">Kids &amp; Family</span><span class="md">Fun, safe, confidence-building</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:flame" class="i" /></span><span class="mtx"><span class="mt">Fight Team</span><span class="md">Train hard &amp; compete</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">Plan your training</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:calendar-event" class="i" /></span><span class="mtx"><span class="mt">Class Schedule</span><span class="md">Daily timetable &amp; sessions</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:tag" class="i" /></span><span class="mtx"><span class="mt">Pricing &amp; Passes</span><span class="md">Drop-in, monthly &amp; long-stay</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:sparkles" class="i" /></span><span class="mtx"><span class="mt">Free Trial Class</span><span class="md">Try your first class on us</span></span></a>
          </div>
          <div class="mfeat">
            <span class="ft-tag">New here?</span>
            <h4>Your first class is <span class="em">free.</span></h4>
            <p>Never thrown a kick? Perfect. Everyone starts somewhere — come as you are.</p>
            <div class="ff"><a class="fbtn" href="#">Book a trial <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
          <div class="mfoot">
            <div class="links">
              <a href="#"><Icon name="tabler:calendar-event" /> View full schedule</a>
              <a href="#"><Icon name="tabler:tag" /> Compare passes</a>
            </div>
            <a class="allcta" href="#">All classes <ArrowWild size={18} /></a>
          </div>
        </div>
      </div>

      <!-- STAY & TRAIN -->
      <div class="mi wide" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">Stay &amp; Train</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega" role="menu">
          <div class="mcol">
            <span class="lab">Train &amp; stay</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:route" class="i" /></span><span class="mtx"><span class="mt">Stay &amp; Train Packages</span><span class="md">All-in week or month plans</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:home-2" class="i" /></span><span class="mtx"><span class="mt">Long-Stay Training</span><span class="md">Settle in for the season</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">Logistics</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:bed" class="i" /></span><span class="mtx"><span class="mt">Where to Stay</span><span class="md">Partner accommodation nearby</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:motorbike" class="i" /></span><span class="mtx"><span class="mt">Scooter Rental</span><span class="md">Get around on two wheels</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:map-pin" class="i" /></span><span class="mtx"><span class="mt">Getting Here</span><span class="md">Find &amp; reach the gym</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">Explore Chiang Mai</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:map-2" class="i" /></span><span class="mtx"><span class="mt">Chiang Mai Guide</span><span class="md">Food, temples &amp; nature</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:leaf" class="i" /></span><span class="mtx"><span class="mt">Things to Do</span><span class="md">Make the most of your stay</span></span></a>
          </div>
          <div class="mfeat">
            <span class="ft-tag">Make it home</span>
            <h4>Your Chiang Mai <span class="em">base.</span></h4>
            <p>Train daily, recover by the pool, find your people. Week or season — you belong here.</p>
            <div class="ff"><a class="fbtn" href="#">Plan your stay <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
          <div class="mfoot">
            <div class="links">
              <a href="#"><Icon name="tabler:id" /> Staying long-term? See DTV Visa</a>
            </div>
            <a class="allcta" href="#">Stay &amp; Train overview <ArrowWild size={18} /></a>
          </div>
        </div>
      </div>

      <!-- DTV VISA -->
      <div class="mi wide" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">DTV Visa</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega" role="menu">
          <div class="mcol">
            <span class="lab">The DTV guide</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:id" class="i" /></span><span class="mtx"><span class="mt">What is the DTV Visa</span><span class="md">The 5-year soft-power visa, explained</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:circle-check" class="i" /></span><span class="mtx"><span class="mt">Am I Eligible?</span><span class="md">Requirements &amp; who qualifies</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:route" class="i" /></span><span class="mtx"><span class="mt">How to Apply</span><span class="md">Step-by-step walkthrough</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">Train on a DTV</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:karate" class="i" /></span><span class="mtx"><span class="mt">Muay Thai &amp; the DTV</span><span class="md">Training as your qualifying activity</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:home-2" class="i" /></span><span class="mtx"><span class="mt">Long-Stay Training Plans</span><span class="md">Programs built for the DTV</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:file-text" class="i" /></span><span class="mtx"><span class="mt">Your Training Documents</span><span class="md">We provide your enrolment letter</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">Get help</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:help-circle" class="i" /></span><span class="mtx"><span class="mt">DTV FAQ</span><span class="md">Common questions answered</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:message-circle" class="i" /></span><span class="mtx"><span class="mt">Talk to Us</span><span class="md">Ask about your situation</span></span></a>
          </div>
          <div class="mfeat gold">
            <span class="stamp"></span>
            <div class="dtv-mini"><b>DTV</b><i>Visa</i></div>
            <h4>Stay up to <span class="em">5 years.</span></h4>
            <p>Enrol long-term and we handle your training documents to support your application.</p>
            <div class="ff"><a class="fbtn" href="#">Start your DTV <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
          <div class="mfoot">
            <div class="links">
              <a href="#"><Icon name="tabler:motorbike" /> Scooter rental for your stay</a>
              <a href="#"><Icon name="tabler:bed" /> Accommodation</a>
            </div>
            <a class="allcta" href="#">DTV Visa guide <ArrowWild size={18} /></a>
          </div>
        </div>
      </div>

      <!-- ABOUT -->
      <div class="mi" data-mega>
        <button aria-haspopup="true" aria-expanded="false"><span class="lbl">About</span> <Icon name="tabler:chevron-down" class="caret" /></button>
        <div class="mega mega--about" role="menu">
          <div class="mcol">
            <span class="lab">Wildcat</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:leaf" class="i" /></span><span class="mtx"><span class="mt">Our Story</span><span class="md">Family-led, born in Chiang Mai</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:user" class="i" /></span><span class="mtx"><span class="mt">Meet the Coaches</span><span class="md">Real Thai trainers &amp; warmth</span></span></a>
          </div>
          <div class="mcol">
            <span class="lab">Community</span>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:users" class="i" /></span><span class="mtx"><span class="mt">Our Community</span><span class="md">Members from around the world</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:camera" class="i" /></span><span class="mtx"><span class="mt">Gallery</span><span class="md">Life at the gym</span></span></a>
            <a class="mlink" href="#"><span class="mic"><Icon name="tabler:star" class="i" /></span><span class="mtx"><span class="mt">Reviews</span><span class="md">What members say</span></span></a>
          </div>
          <div class="mfeat">
            <span class="ft-tag">Why Wildcat</span>
            <h4>Run by a woman, built like a <span class="em">family.</span></h4>
            <p>No ego at the door — just real training and real people.</p>
            <div class="ff"><a class="fbtn" href="#">Our story <ArrowWild class="fbtn-ar" size={20} /></a></div>
          </div>
        </div>
      </div>

      <!-- SIMPLE LINKS -->
      <div class="mi"><a href="#"><span class="lbl">Blog</span></a></div>
      <div class="mi"><a href="#"><span class="lbl">Contact</span></a></div>
      <div class="mi cta"><Button variant="gold" flat arrow href="#">{ctaLabel}</Button></div>
    </nav>

    <button class="nav-toggle" aria-label="Open menu" data-drawer-open>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</header>

<!-- ============ MOBILE DRAWER ============ -->
<div class="drawer" id="wc-drawer">
  <div class="scrim" data-drawer-close></div>
  <div class="panel">
    <div class="dh"><img src="/assets/logo-cream.png" alt="Wildcat"><button class="x" aria-label="Close" data-drawer-close>×</button></div>
    <div class="dbody">
      <details open><summary>Train <span class="pm">+</span></summary><div class="sub-links"><a href="#"><span class="dot"></span> Beginner Muay Thai</a><a href="#"><span class="dot"></span> All Levels</a><a href="#"><span class="dot"></span> Private Sessions</a><a href="#"><span class="dot"></span> Women's Muay Thai</a><a href="#"><span class="dot"></span> Kids &amp; Family</a><a href="#"><span class="dot"></span> Fight Team</a><a href="#"><span class="dot"></span> Schedule &amp; Pricing</a></div></details>
      <details><summary>Stay &amp; Train <span class="pm">+</span></summary><div class="sub-links"><a href="#"><span class="dot"></span> Packages</a><a href="#"><span class="dot"></span> Accommodation</a><a href="#"><span class="dot"></span> Scooter Rental</a><a href="#"><span class="dot"></span> Getting Here</a><a href="#"><span class="dot"></span> Chiang Mai Guide</a></div></details>
      <details><summary>DTV Visa <span class="pm">+</span></summary><div class="sub-links"><a href="#"><span class="dot"></span> DTV Visa Guide</a><a href="#"><span class="dot"></span> Am I Eligible?</a><a href="#"><span class="dot"></span> How to Apply</a><a href="#"><span class="dot"></span> Muay Thai &amp; the DTV</a><a href="#"><span class="dot"></span> DTV FAQ</a></div></details>
      <details><summary>About <span class="pm">+</span></summary><div class="sub-links"><a href="#"><span class="dot"></span> Our Story</a><a href="#"><span class="dot"></span> Coaches</a><a href="#"><span class="dot"></span> Community</a><a href="#"><span class="dot"></span> Gallery &amp; Reviews</a></div></details>
      <a class="flat" href="#">Blog</a>
      <a class="flat" href="#">Contact</a>
      <Button variant="gold" flat arrow href="#" class="djoin">{ctaLabel}</Button>
    </div>
  </div>
</div>

<style>
  .util {
    background: var(--forest-deep);
    color: rgba(246, 241, 230, 0.72);
    font-size: 12.5px;
  }
  .util .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 38px;
    gap: 18px;
  }
  .wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 clamp(18px, 3vw, 32px);
  }
  .util .u-left { display: flex; align-items: center; gap: 18px; }
  .util .u-item { display: flex; align-items: center; gap: 7px; white-space: nowrap; }
  .util .u-item svg { width: 14px; height: 14px; color: var(--gold); }
  .util .dot-open { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px var(--success-glow); }
  .util .u-right { display: flex; align-items: center; gap: 16px; }
  .util .u-soc { display: flex; gap: 11px; }
  .util .u-soc a { display: flex; opacity: 0.8; transition: 0.15s; }
  .util .u-soc a:hover { opacity: 1; color: var(--gold); }
  .util .u-soc svg { width: 15px; height: 15px; }
  .util .lang b { color: var(--gold); }
  .util .lang span { opacity: 0.5; }

  /* MAIN NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 80;
    background: var(--forest);
    color: var(--cream);
    border-bottom: 1px solid rgba(246, 241, 230, 0.1);
    font-family: var(--font-display);
  }
  .nav--static { position: relative; }
  .nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 18px; height: 74px; }
  .brand img { height: 44px; width: auto; display: block; }
  .menubar { display: flex; align-items: stretch; height: 74px; gap: 2px; }
  .mi { position: relative; display: flex; align-items: center; }
  .mi > a,
  .mi > button {
    font-family: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    color: rgba(246, 241, 230, 0.85);
    font-weight: 600;
    font-size: 14.5px;
    height: 100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 15px;
    position: relative;
  }
  .mi > a:hover,
  .mi > button:hover,
  .mi.open > button { color: var(--cream); }
  .mi > button .caret { width: 11px; height: 11px; transition: transform 0.22s ease; opacity: 0.7; }
  .mi.open > button .caret { transform: rotate(180deg); }
  /* gold underline indicator — sous le texte (pas au bas de la navbar) */
  .lbl { position: relative; display: inline-block; }
  .lbl::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 2px;
    background: var(--gold);
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.22s ease;
  }
  .mi:hover > a .lbl::after,
  .mi:hover > button .lbl::after,
  .mi.open > button .lbl::after { transform: scaleX(1); }
  .mi.cta { margin-left: 10px; }
  .nav-toggle { display: none; background: none; border: 0; color: var(--cream); cursor: pointer; }
  .nav-toggle svg { width: 28px; height: 28px; }
  svg.i { width: 20px; height: 20px; flex: 0 0 auto; }
  .caret { display: inline-block; }

  /* Focus visible — accessibilité clavier */
  .mi > a:focus-visible,
  .mi > button:focus-visible,
  .util .u-soc a:focus-visible,
  .mlink:focus-visible,
  .fbtn:focus-visible,
  .mega .mfoot a:focus-visible,
  .allcta:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }

  /* MEGA PANEL */
  .mega {
    --shift: 0px;
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translate(calc(-50% + var(--shift)), 8px);
    width: min(1100px, calc(100vw - 24px));
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: 0 30px 70px -34px rgba(20, 35, 25, 0.55);
    padding: 26px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 0.92fr;
    gap: 8px 20px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    z-index: 90;
  }
  /* bridge transparent pour combler le gap navbar↔panel au survol */
  .mega::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    right: 0;
    height: 12px;
  }
  .mega--about { grid-template-columns: 1fr 1fr 0.95fr; width: min(720px, calc(100vw - 24px)); }
  .mi.open .mega { opacity: 1; visibility: visible; pointer-events: auto; transform: translate(calc(-50% + var(--shift)), 0); }

  .mcol { display: flex; flex-direction: column; }
  .mcol .lab {
    font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gold-deep); margin: 2px 0 12px; display: flex; align-items: center; gap: 7px;
  }
  .mcol .lab::before { content: '◆'; color: var(--orange); font-size: 9px; }
  .mlink { display: flex; gap: 11px; align-items: flex-start; padding: 9px 10px; border-radius: var(--r-sm); transition: 0.14s; margin: 0 -10px; }
  .mlink:hover { background: var(--soft); }
  .mlink .mic { width: 34px; height: 34px; flex: 0 0 auto; border-radius: 9px; background: var(--soft-2); color: var(--forest); display: flex; align-items: center; justify-content: center; transition: 0.14s; }
  .mlink:hover .mic { background: var(--forest); color: var(--gold); }
  .mlink .mtx { min-width: 0; }
  .mlink .mt { display: block; font-weight: 700; font-size: 14.5px; color: var(--forest); line-height: 1.25; white-space: nowrap; }
  .mlink .md { display: block; font-size: 12.5px; color: var(--ink-2); line-height: 1.35; margin-top: 2px; }

  /* featured promo card */
  .mfeat { background: var(--forest); color: var(--cream); border-radius: var(--r-md); padding: 20px; display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .mfeat.gold { background: radial-gradient(120% 90% at 80% 0, var(--forest-light), var(--forest)); }
  .mfeat .ft-tag { font-size: 10.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-bottom: 10px; }
  .mfeat h4 { font-family: var(--font-display); font-weight: 800; font-size: 19px; line-height: 1.1; letter-spacing: -0.01em; margin: 0 0 7px; }
  .mfeat h4 .em { color: var(--gold); }
  .mfeat p { font-size: 12.5px; color: rgba(246, 241, 230, 0.74); line-height: 1.45; margin: 0 0 16px; }
  .mfeat .ff { margin-top: auto; }
  .fbtn { display: inline-flex; align-items: center; gap: 8px; background: var(--gold); color: var(--charcoal); font-family: var(--font-display); font-weight: 700; font-size: 13px; padding: 9px 16px; border-radius: 999px; transition: 0.16s; }
  .fbtn:hover { background: color-mix(in srgb, var(--gold), #fff 10%); }
  .fbtn-ar { transition: transform 0.18s ease; }
  .fbtn:hover .fbtn-ar { transform: translateX(3px); }
  .mfeat .stamp { position: absolute; right: -26px; top: -26px; width: 120px; height: 120px; border-radius: 50%; background: radial-gradient(circle at 50% 38%, #efb63a, #db9a14); border: 2px solid #1c1407; opacity: 0.16; }
  .dtv-mini { width: 62px; height: 62px; border-radius: 50%; background: radial-gradient(circle at 50% 36%, #efb63a, #db9a14); border: 2px solid #1c1407; color: #1c1407; display: flex; flex-direction: column; align-items: center; justify-content: center; font-weight: 800; line-height: 0.85; margin-bottom: 14px; position: relative; }
  .dtv-mini b { font-size: 21px; }
  .dtv-mini i { font-style: normal; font-size: 7px; letter-spacing: 0.1em; text-transform: uppercase; margin-top: 3px; }

  /* mega footer strip */
  .mega .mfoot { grid-column: 1 / -1; margin-top: 6px; padding-top: 14px; border-top: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .mega .mfoot .links { display: flex; gap: 18px; flex-wrap: wrap; }
  .mega .mfoot a { font-size: 12.5px; font-weight: 600; color: var(--ink-2); display: inline-flex; align-items: center; gap: 6px; }
  .mega .mfoot a:hover { color: var(--forest); }
  .mega .mfoot .links a svg { width: 14px; height: 14px; color: var(--gold-deep); }
  .mega .mfoot .allcta { font-size: 12.5px; font-weight: 700; color: var(--gold-deep); display: inline-flex; align-items: center; gap: 6px; }

  /* RESPONSIVE */
  @media (max-width: 1080px) {
    .menubar { display: none; }
    .nav-toggle { display: block; }
  }

  /* MOBILE DRAWER */
  .drawer { display: none; position: fixed; inset: 0; z-index: 200; }
  .drawer.open { display: block; }
  .drawer .scrim { position: absolute; inset: 0; background: rgba(17, 17, 17, 0.55); }
  .drawer .panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(86vw, 360px); background: var(--cream); overflow-y: auto; box-shadow: 0 30px 70px -34px rgba(20, 35, 25, 0.55); font-family: var(--font-display); }
  .drawer .dh { position: sticky; top: 0; background: var(--forest); display: flex; align-items: center; justify-content: space-between; padding: 16px; }
  .drawer .dh img { height: 32px; }
  .drawer .dh .x { background: none; border: 0; color: var(--cream); font-size: 28px; cursor: pointer; line-height: 1; }
  .drawer .dbody { padding: 8px 14px 30px; }
  .drawer details { border-bottom: 1px solid var(--line); }
  .drawer summary { list-style: none; cursor: pointer; padding: 15px 6px; display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 16px; color: var(--forest); }
  .drawer summary::-webkit-details-marker { display: none; }
  .drawer summary .pm { color: var(--gold-deep); font-size: 20px; transition: 0.2s; }
  .drawer details[open] summary .pm { transform: rotate(45deg); }
  .drawer .sub-links { padding: 0 6px 12px; display: flex; flex-direction: column; gap: 1px; }
  .drawer .sub-links a { padding: 10px 12px; font-size: 14px; font-weight: 600; color: var(--ink-2); border-radius: 7px; display: flex; align-items: center; gap: 9px; }
  .drawer .sub-links a:hover { background: var(--soft); color: var(--forest); }
  .drawer .sub-links a .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--gold); }
  .drawer .flat { padding: 15px 6px; font-weight: 700; font-size: 16px; color: var(--forest); border-bottom: 1px solid var(--line); display: block; }
  .drawer :global(.djoin) { margin: 18px 6px 0; width: calc(100% - 12px); justify-content: center; }

  /* Reduced motion — neutralise les transitions du nav */
  @media (prefers-reduced-motion: reduce) {
    .mi > button .caret,
    .lbl::after,
    .mega,
    .mlink,
    .fbtn-ar,
    .drawer summary .pm { transition: none; }
  }
</style>

<script>
  (function () {
    const items = Array.from(document.querySelectorAll('.mi[data-mega]'));
    let closeTimer: ReturnType<typeof setTimeout> | null = null;

    function closeAll(except?: Element | null) {
      items.forEach((it) => {
        if (it !== except) {
          it.classList.remove('open');
          it.querySelector('button')?.setAttribute('aria-expanded', 'false');
        }
      });
    }
    function clamp(it: Element) {
      const p = it.querySelector('.mega') as HTMLElement | null;
      if (!p) return;
      p.style.setProperty('--shift', '0px');
      const r = p.getBoundingClientRect();
      const m = 12;
      let shift = 0;
      if (r.right > window.innerWidth - m) shift -= r.right - (window.innerWidth - m);
      if (r.left + shift < m) shift += m - (r.left + shift);
      if (shift) p.style.setProperty('--shift', Math.round(shift) + 'px');
    }
    function open(it: Element) {
      if (closeTimer) clearTimeout(closeTimer);
      closeAll(it);
      it.classList.add('open');
      it.querySelector('button')?.setAttribute('aria-expanded', 'true');
      clamp(it);
    }
    function close(it: Element) {
      it.classList.remove('open');
      it.querySelector('button')?.setAttribute('aria-expanded', 'false');
    }

    items.forEach((it) => {
      const btn = it.querySelector('button');
      it.addEventListener('mouseenter', () => open(it));
      it.addEventListener('mouseleave', () => {
        closeTimer = setTimeout(() => close(it), 120);
      });
      btn?.addEventListener('click', (e) => {
        e.preventDefault();
        it.classList.contains('open') ? close(it) : open(it);
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll(null);
    });
    document.addEventListener('click', (e) => {
      if (!(e.target as Element)?.closest('.menubar')) closeAll(null);
    });

    // mobile drawer
    const drawer = document.getElementById('wc-drawer');
    document.querySelectorAll('[data-drawer-open]').forEach((b) =>
      b.addEventListener('click', () => drawer?.classList.add('open'))
    );
    document.querySelectorAll('[data-drawer-close]').forEach((b) =>
      b.addEventListener('click', () => drawer?.classList.remove('open'))
    );
  })();
</script>
