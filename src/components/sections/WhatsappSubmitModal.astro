---
import { Icon } from 'astro-icon/components';
import { m } from '../../paraglide/messages.js';
import { localePath } from '../../lib/routes';
import { getPostsByKeys, blogPath } from '../../lib/blog';

/**
 * WhatsappSubmitModal — modal de confirmation après submit (2026-07-19).
 * Remplace l'ouverture directe de WhatsApp (ex `window.open` dans wa-form.ts) :
 * au submit (JS actif), l'email part en tâche de fond puis ce `<dialog>` s'ouvre
 * avec l'aperçu du message pré-rempli + un bouton « Envoyer sur WhatsApp ».
 * WhatsApp ne s'ouvre QUE si l'utilisateur clique. Le remplissage runtime
 * (`[data-wa-preview]`, `[data-wa-send]`) et l'ouverture sont gérés par
 * `src/scripts/wa-form.ts` via `opts.modal`. Sans JS : jamais affiché, la
 * bannière ?sent=1 (POST natif Web3Forms) reste le fallback.
 *
 * Rendu une fois par form (ContactForm, StayInquiryForm) ; les deux forms ne
 * coexistent jamais sur une même page → un seul `[data-wa-modal]` par page.
 *
 * Lectures conseillées (2026-10-16) : un groupe `[data-reco]` par intention
 * (et par niveau pour les cours), montré par wa-form.ts selon `recoKey`.
 * Articles résolus par translationKey dans la locale (clé absente = ignorée).
 */
type Reco = { href: string; title: string; desc: string };
const lang = Astro.currentLocale ?? 'en';
const page = (path: string, title: string, desc: string): Reco => ({
  href: localePath(lang, path),
  title,
  desc,
});
const posts = async (keys: string[]): Promise<Reco[]> =>
  (await getPostsByKeys(lang, keys)).map((e) => ({ href: blogPath(e), title: e.data.title, desc: m.nav_blog() }));

const beginner = page('/classes/beginners', m.nav_train_beginner_title(), m.nav_train_beginner_desc());
const schedule = page('/classes#schedule', m.nav_train_schedule_title(), m.nav_train_schedule_desc());
const pricing = page('/classes#pricing', m.nav_train_pricing_title(), m.nav_train_pricing_desc());
const guide = page('/chiang-mai-guide', m.nav_stay_guide_title(), m.nav_stay_guide_desc());

const groups: Record<string, Reco[]> = {
  'class-first-time': [beginner, schedule, ...(await posts(['muay-thai-gear-beginners']))],
  'class-some-experience': [schedule, pricing, ...(await posts(['muay-thai-stance']))],
  'class-experienced': [
    page('/fighters', m.nav_train_fight_title(), m.nav_train_fight_desc()),
    schedule,
    ...(await posts(['watch-muay-thai-fights-chiang-mai'])),
  ],
  class: [schedule, beginner, pricing],
  stay: [
    page('/stay-train#packages', m.nav_stay_packages_title(), m.nav_stay_packages_desc()),
    ...(await posts(['muay-thai-training-thailand-cost', 'stage-boxe-thai-thailande-prix'])),
    guide,
  ],
  scooter: [page('/stay-train/scooter-rental', m.nav_stay_scooter_title(), m.nav_stay_scooter_desc()), guide],
  dtv: [
    page('/dtv-visa/how-to-apply', m.nav_dtv_apply_title(), m.nav_dtv_apply_desc()),
    page('/dtv-visa/eligibility', m.nav_dtv_eligible_title(), m.nav_dtv_eligible_desc()),
    ...(await posts(['dtv-visa-proof-of-funds', 'thailand-visa-guide-by-training-length'])),
  ],
  general: [
    page('/about', m.nav_about_story_title(), m.nav_about_story_desc()),
    page('/about/coaches', m.nav_about_coaches_title(), m.nav_about_coaches_desc()),
    schedule,
  ],
};
---

<dialog class="wamodal" data-wa-modal aria-labelledby="wamodal-title">
  <div class="wamodal-box">
    <button type="button" class="wamodal-x" data-wa-close aria-label={m.contact_modal_close()}>
      <Icon name="tabler:x" aria-hidden="true" />
    </button>

    <div class="wamodal-head">
      <span class="wamodal-check"><Icon name="tabler:circle-check" aria-hidden="true" /></span>
      <h2 id="wamodal-title">{m.contact_success_title()}</h2>
    </div>

    <p class="wamodal-body">{m.contact_modal_body()}</p>

    <div class="wamodal-preview">
      <span class="wamodal-preview-lb">{m.contact_modal_preview_label()}</span>
      <pre data-wa-preview></pre>
    </div>

    <div class="wamodal-actions">
      <a class="wamodal-send" data-wa-send href="#" target="_blank" rel="noopener">
        <Icon name="tabler:brand-whatsapp" aria-hidden="true" />
        <span>{m.contact_modal_wa_cta()}</span>
      </a>
      <button type="button" class="wamodal-dismiss" data-wa-close>{m.contact_modal_close()}</button>
    </div>

    <div class="wamodal-reco" data-wa-reco hidden>
      <span class="wamodal-preview-lb">{m.contact_reco_title()}</span>
      {
        Object.entries(groups).map(([key, items]) => (
          <ul data-reco={key} hidden>
            {items.slice(0, 3).map((it) => (
              <li>
                <a href={it.href}>
                  <b>{it.title}</b>
                  <span>{it.desc}</span>
                </a>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</dialog>

<style>
  .wamodal {
    /* Centrage explicite (fixed + inset:0 + margin:auto avec height définie) :
       bat le style UA du <dialog:modal> et ne dépend d'aucun quirk de top-layer.
       N'utilise que margin → laisse le transform libre pour l'animation d'entrée. */
    position: fixed;
    inset: 0;
    margin: auto;
    width: calc(100% - 32px);
    max-width: 460px;
    height: fit-content;
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    border-radius: var(--r-lg, 18px);
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }
  .wamodal::backdrop {
    background: rgba(17, 17, 17, 0.55);
    backdrop-filter: blur(2px);
  }
  .wamodal-box {
    position: relative;
    padding: 30px 26px 24px;
    background: var(--cream);
    border-radius: var(--r-lg, 18px);
    box-shadow: 0 24px 60px -20px rgba(12, 26, 17, 0.55);
    /* les lectures conseillées allongent la boîte : scroll interne sur petit écran */
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
  }

  .wamodal-x {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    padding: 6px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .wamodal-x:hover {
    background: color-mix(in srgb, var(--ink-2), transparent 88%);
  }
  .wamodal-x svg {
    width: 20px;
    height: 20px;
  }

  .wamodal-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }
  .wamodal-check {
    display: inline-flex;
    color: var(--success, var(--forest));
  }
  .wamodal-check svg {
    width: 30px;
    height: 30px;
  }
  .wamodal-head h2 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .wamodal-body {
    margin: 0 0 16px;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .wamodal-preview {
    margin-bottom: 20px;
    padding: 12px 14px;
    background: color-mix(in srgb, var(--field-bg, #fff), #fff 30%);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .wamodal-preview-lb {
    display: block;
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-2);
  }
  .wamodal-preview pre {
    margin: 0;
    max-height: 168px;
    overflow-y: auto;
    font-family: inherit;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .wamodal-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .wamodal-send {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 46px;
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--forest-light);
    color: var(--cream);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15.5px;
    letter-spacing: -0.01em;
    box-shadow:
      0 6px 0 -1px var(--forest-deep),
      0 14px 24px -12px rgba(12, 26, 17, 0.55);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease;
  }
  .wamodal-send:hover {
    background: color-mix(in srgb, var(--forest-light), #fff 10%);
    transform: translateY(-1px);
  }
  .wamodal-send:active {
    transform: translateY(1px) scale(0.99);
  }
  .wamodal-send svg {
    width: 22px;
    height: 22px;
  }
  .wamodal-dismiss {
    margin-left: auto;
    padding: 8px 12px;
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    border-radius: 6px;
    transition: color 0.15s ease;
  }
  .wamodal-dismiss:hover {
    color: var(--ink);
  }

  /* ---- Lectures conseillées ---- */
  .wamodal-reco {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
  }
  .wamodal-reco ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .wamodal-reco ul[hidden] {
    display: none;
  }
  .wamodal-reco a {
    display: grid;
    gap: 1px;
    padding: 9px 12px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--field-bg, #fff), #fff 30%);
    border: 1px solid var(--line);
    transition: border-color 0.15s ease;
  }
  .wamodal-reco a:hover {
    border-color: var(--forest);
  }
  .wamodal-reco b {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
    color: var(--ink);
  }
  .wamodal-reco a span {
    font-size: 13px;
    color: var(--ink-2);
  }

  /* Entrée fondu + léger scale (progressive : @starting-style, ignoré si non
     supporté = apparition instantanée, aucun bug). */
  .wamodal[open] {
    animation: wamodal-in 0.22s ease both;
  }
  .wamodal[open]::backdrop {
    animation: wamodal-bg 0.22s ease both;
  }
  @keyframes wamodal-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
  }
  @keyframes wamodal-bg {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wamodal[open],
    .wamodal[open]::backdrop {
      animation: none;
    }
    .wamodal-send {
      transition: none;
    }
    .wamodal-send:hover {
      transform: none;
    }
  }
</style>
