---
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';

/**
 * CtaBanner — bannière de conversion forest arrondie (maquette : .cta-banner).
 * Image de fond optionnelle en voile (opacity .26).
 */
export interface Props {
  title: string;
  titleEm: string;
  titleAfter?: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  image?: { src: string };
}
const { title, titleEm, titleAfter, ctaPrimary, ctaSecondary, image } = Astro.props;
---

<section class="cta-block">
  <Container>
    <div class="cta-banner">
      {
        image && (
          <div class="imgbg" aria-hidden="true">
            <img src={image.src} alt="" loading="lazy" />
          </div>
        )
      }
      <div class="inner">
        <h2>
          {title} <span class="em on-dark">{titleEm}</span>{titleAfter && ` ${titleAfter}`}
        </h2>
        <div class="cta-row">
          <Button href={ctaPrimary.href} variant="gold" arrow>{ctaPrimary.label}</Button>
          {ctaSecondary && <Button href={ctaSecondary.href} variant="outline" onDark>{ctaSecondary.label}</Button>}
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .cta-block {
    /* respiration symétrique par défaut : après une bande soft/dark, la card
       a besoin de sa propre marge cream au-dessus (sinon collée au seam) */
    padding-block: var(--section-y);
  }
  /* après une section cream (même fond), le padding-bottom de la section
     précédente suffit — on collapse pour éviter le double espace */
  :global(.wc-section:not(.wc-section--soft):not(.wc-section--dark)) + .cta-block {
    padding-top: 0;
  }
  .cta-banner {
    position: relative;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--forest);
    color: var(--cream);
  }
  .imgbg {
    position: absolute;
    inset: 0;
    opacity: 0.26;
  }
  .imgbg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .inner {
    position: relative;
    z-index: 2;
    padding: clamp(40px, 6vw, 68px) clamp(28px, 5vw, 60px);
    text-align: center;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 4.6vw, 52px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 22px;
    color: var(--cream);
    text-wrap: balance;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
