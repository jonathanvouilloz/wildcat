---
import Stars from '../ui/Stars.astro';

/**
 * TestimonialQuote — citation témoignage statique (maquette : .quote).
 * Boîte forest arrondie, guillemet Fraunces, étoiles or. Pas de slider en E5
 * (zéro island) — plusieurs témoignages = grille de quotes.
 */
export interface Props {
  content: string;
  name: string;
  /** Ex : « Member · Australia » — traduit par la page. */
  meta?: string;
  rating?: number;
  /** Libellé accessible des étoiles (ex : « Rated 5 out of 5 »). */
  ratingLabel?: string;
}
const { content, name, meta, rating = 5, ratingLabel } = Astro.props;
---

<figure class="quote">
  <span class="mark" aria-hidden="true">“</span>
  <Stars rating={rating} label={ratingLabel} class="stars" />
  <blockquote>{content}</blockquote>
  <figcaption class="who">
    {name}
    {meta && <span>{meta}</span>}
  </figcaption>
</figure>

<style>
  .quote {
    background: var(--forest);
    color: var(--cream);
    border-radius: var(--r-lg);
    padding: 36px 36px 34px;
    position: relative;
    margin: 0;
  }
  .mark {
    font-family: var(--font-accent);
    font-style: italic;
    font-size: 64px;
    line-height: 0.6;
    color: var(--gold);
    height: 34px;
    display: block;
  }
  .quote :global(.stars) {
    display: block;
    margin-bottom: 14px;
  }
  blockquote {
    margin: 0 0 18px;
    font-family: var(--font-accent);
    font-variation-settings: 'opsz' 72;
    font-style: italic;
    font-weight: 500;
    font-size: 21px;
    line-height: 1.4;
  }
  .who {
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .who span {
    display: block;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    color: rgba(246, 241, 230, 0.6);
    font-size: 13px;
  }
</style>
