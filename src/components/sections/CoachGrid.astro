---
import CoachCard from './CoachCard.astro';

/**
 * CoachGrid — grille de coachs (maquette : .coach-grid, 3 colonnes).
 */
export interface Props {
  coaches: {
    name: string;
    role: string;
    bio?: string;
    photo?: { src: string; alt: string };
  }[];
}
const { coaches } = Astro.props;
---

{/* ⚠️ wrapper par item (pas data-animate-item sur la card) : la racine de
    CoachCard porte la rotation seedée --crot — le stagger animerait transform
    et écraserait la rotation. Le nth-child(even) punaisé matche le wrapper. */}
<div class="coach-grid" data-animate-stagger>
  {coaches.map((coach) => <div data-animate-item><CoachCard {...coach} /></div>)}
</div>

<style>
  .coach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px 28px;
  }
  @media (min-width: 861px) {
    /* punaisé, pas aligné au cordeau (pattern guest book) */
    .coach-grid > :global(*:nth-child(even)) {
      margin-top: 26px;
    }
  }
  @media (max-width: 860px) {
    .coach-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
</style>
