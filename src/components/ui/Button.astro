---
import ArrowWild from './ArrowWild.astro';

/**
 * Button — CTA signature Wildcat.
 * Pill · Satoshi Bold (casse normale) · relief (surface claire + ombre foncée) · swoosh maison.
 * Variantes : gold (primaire) · forest · outline (+ onDark) · link (texte, navbar).
 * Toutes les variantes "boutons" partagent exactement la même boîte (hauteur/padding/pill/bordure).
 * Rend <a> si href, sinon <button>.
 */
export interface Props {
  variant?: 'gold' | 'forest' | 'outline' | 'link';
  href?: string;
  onDark?: boolean;
  arrow?: boolean;
  /** Sans relief/ombre (ex : CTA nav). */
  flat?: boolean;
  class?: string;
  type?: 'button' | 'submit';
}

const {
  variant = 'gold',
  href,
  onDark = false,
  arrow = false,
  flat = false,
  class: extra = '',
  type = 'button',
} = Astro.props;

const Tag = href ? 'a' : 'button';
const variantClass =
  variant === 'gold'
    ? 'wc-gold'
    : variant === 'forest'
      ? 'wc-forest'
      : variant === 'link'
        ? onDark
          ? 'wc-link wc-link--dark'
          : 'wc-link'
        : onDark
          ? 'wc-outline wc-outline--dark'
          : 'wc-outline';
---

<Tag
  class:list={['wc-btn', variantClass, flat && 'wc-flat', extra]}
  href={href}
  type={href ? undefined : type}
>
  <span class="wc-label"><slot /></span>
  {arrow && <ArrowWild class="wc-ar" size={26} />}
</Tag>

<style>
  .wc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    min-height: 44px;
    padding: 10px 24px;
    border-radius: 999px;
    border: 1.5px solid transparent;
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      background-color 0.18s ease,
      border-color 0.18s ease;
  }
  .wc-btn:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  .wc-ar {
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }
  .wc-btn:hover .wc-ar {
    transform: translateX(4px);
  }
  .wc-btn:active {
    transform: translateY(1px) scale(0.99);
  }

  /* Forest — surface vert clair + relief/ombre vert foncé */
  .wc-forest {
    background: var(--forest-light);
    color: var(--cream);
    box-shadow:
      0 7px 0 -1px var(--forest-deep),
      0 16px 26px -12px rgba(12, 26, 17, 0.6);
  }
  .wc-forest:hover {
    background: color-mix(in srgb, var(--forest-light), #fff 10%);
    transform: translateY(-1px);
    box-shadow:
      0 8px 0 -1px var(--forest-deep),
      0 20px 30px -12px rgba(12, 26, 17, 0.65);
  }
  .wc-forest:active {
    box-shadow:
      0 3px 0 -1px var(--forest-deep),
      0 10px 18px -12px rgba(12, 26, 17, 0.55);
  }

  /* Gold — relief or profond */
  .wc-gold {
    background: var(--gold);
    color: var(--charcoal);
    box-shadow:
      0 7px 0 -1px var(--gold-deep),
      0 16px 26px -12px rgba(160, 116, 18, 0.55);
  }
  .wc-gold:hover {
    background: color-mix(in srgb, var(--gold), #fff 10%);
    transform: translateY(-1px);
    box-shadow:
      0 8px 0 -1px var(--gold-deep),
      0 20px 30px -12px rgba(160, 116, 18, 0.6);
  }
  .wc-gold:active {
    box-shadow:
      0 3px 0 -1px var(--gold-deep),
      0 10px 18px -12px rgba(160, 116, 18, 0.5);
  }

  /* Outline — relief "double ligne" : bordure + ligne blanche décalée (pastille claire),
     surface transparente (prend la couleur du fond où le bouton est posé). */
  /* Outline — totalement transparent (ni fond ni bordure), texte seul.
     Même boîte que primary/secondary. Hover = léger fond teinté pour l'affordance. */
  .wc-outline {
    background: transparent;
    border-color: transparent;
    color: var(--forest);
  }
  .wc-outline:hover {
    background: rgba(46, 93, 60, 0.07);
  }

  /* Outline sur fond sombre — texte crème */
  .wc-outline--dark {
    color: var(--cream);
    border-color: transparent;
  }
  .wc-outline--dark:hover {
    background: rgba(246, 241, 230, 0.1);
  }

  /* Link — texte simple (navbar), sans bordure ni relief, soulignement or animé */
  .wc-link {
    min-height: 0;
    padding: 4px 2px;
    border: 0;
    border-radius: 4px;
    box-shadow: none;
    background-color: transparent;
    background-image: linear-gradient(var(--gold-deep), var(--gold-deep));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    color: var(--ink);
    font-weight: 600;
    gap: 7px;
    transition:
      background-size 0.2s ease,
      color 0.18s ease;
  }
  .wc-link:hover {
    color: var(--gold-deep);
    background-size: 100% 2px;
  }
  .wc-link:active {
    transform: none;
  }
  .wc-link--dark {
    color: var(--cream);
    background-image: linear-gradient(var(--gold), var(--gold));
  }
  .wc-link--dark:hover {
    color: var(--gold);
  }

  /* Flat — même couleur, sans relief ni lift (ex : CTA nav) */
  .wc-flat,
  .wc-flat:hover,
  .wc-flat:active {
    box-shadow: none;
  }
  .wc-flat:hover {
    transform: none;
  }
  .wc-flat:active {
    transform: translateY(1px) scale(0.99);
  }

  @media (prefers-reduced-motion: reduce) {
    .wc-btn,
    .wc-ar {
      transition: none;
    }
    .wc-btn:hover {
      transform: none;
    }
  }
</style>
