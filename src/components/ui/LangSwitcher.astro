---
import { m } from '../../paraglide/messages.js';

/**
 * LangSwitcher — bascule EN/FR en préservant le path courant.
 * Strip du préfixe locale identique aux alternates hreflang de BaseLayout.
 * Locale active en <b> gold (non cliquable), autres locales en lien.
 * Pur HTML (zéro JS) : le changement de langue est une navigation.
 *
 * Blog (E8) : les slugs d'articles sont TRADUITS par locale → le calcul
 * symétrique est faux. Les pages article passent `alternates` (via
 * BaseLayout → Nav) ; locale absente des alternates (article non traduit)
 * → fallback vers l'index /blog de la locale cible, jamais un 404.
 */
export interface Props {
  alternates?: { lang: string; href: string }[];
}
const { alternates } = Astro.props;

const locales = ['en', 'fr'] as const;
const current = Astro.currentLocale ?? 'en';
const path = Astro.url.pathname.replace(/^\/(en|fr)(?=\/|$)/, '');
const hrefFor = (loc: string) => {
  if (alternates) return alternates.find((alt) => alt.lang === loc)?.href ?? `/${loc}/blog`;
  return `/${loc}${path}`;
};
---

<nav class="lang" aria-label={m.nav_aria_lang_switch()}>
  {
    locales.map((loc, i) => (
      <>
        {i > 0 && (
          <span class="sep" aria-hidden="true">
            /
          </span>
        )}
        {loc === current ? (
          <b aria-current="page">{loc.toUpperCase()}</b>
        ) : (
          <a href={hrefFor(loc)} hreflang={loc} lang={loc}>
            {loc.toUpperCase()}
          </a>
        )}
      </>
    ))
  }
</nav>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .lang b {
    color: var(--gold);
  }
  .lang .sep {
    opacity: 0.5;
  }
  .lang a {
    transition: color 0.15s ease;
  }
  .lang a:hover {
    color: var(--gold);
  }
  .lang a:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 3px;
    border-radius: var(--r-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang a {
      transition: none;
    }
  }
</style>
