---
/**
 * DtvStamp — badge DTV officiel (asset /assets/dtv-stamp.webp : tigre +
 * « DTV Visa Friendly », fond transparent, 627×627).
 * SEUL rendu autorisé du sceau — jamais d'<img> brut ni de sceau CSS.
 * Texte de marque, JAMAIS traduit (comme « Wildcat ») — voir docs/DESIGN.md.
 * Décoratif : alt vide, le contexte textuel vit dans la section parente.
 */
export interface Props {
  /** Largeur/hauteur en px (asset carré). Heros/teaser : 240 · mega menu : 88 · badge Callout : 118. */
  size?: number;
  /** Drop-shadow (calibré pour les grandes tailles) — false en usage sticker/badge. */
  shadow?: boolean;
  class?: string;
}
const { size = 150, shadow = true, class: extra = '' } = Astro.props;
---

<img
  class:list={['dtv-stamp', shadow && 'dtv-stamp--shadow', extra]}
  src="/assets/dtv-stamp.webp"
  alt=""
  width={size}
  height={size}
  loading="lazy"
  decoding="async"
/>

<style>
  .dtv-stamp {
    flex: 0 0 auto;
  }
  /* drop-shadow (suit le contour alpha) — équivalent du box-shadow de l'ancien sceau */
  .dtv-stamp--shadow {
    filter: drop-shadow(0 18px 32px rgba(0, 0, 0, 0.4));
  }
</style>
