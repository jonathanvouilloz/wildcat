---
import { m } from '../../paraglide/messages.js';

/**
 * HelpfulWidget — « Cet article vous a aidé ? » en fin d'article.
 *
 * Site statique, pas de backend : « Oui » → merci + localStorage anti-revote ;
 * « Non » → mini textarea « qu'est-ce qui manquait ? » → POST Web3Forms
 * (backend forms décidé 2026-06-05 — premier composant à l'utiliser).
 * Clé absente (PUBLIC_WEB3FORMS_KEY) → même philosophie que RESEND_API_KEY :
 * pas de fetch, le merci s'affiche quand même (zéro frustration utilisateur).
 * Hook analytics générique : window.wcTrack?.('blog_helpful', {…}).
 *
 * Purement interactif (aucune valeur de contenu) → hidden par défaut,
 * révélé par le JS : pas de boutons morts en no-JS.
 */
export interface Props {
  /** Slug de l'article (clé localStorage + sujet du feedback). */
  slug: string;
}
const { slug } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<div class="helpful" data-helpful data-slug={slug} hidden>
  <div class="ask" data-h-ask>
    <p class="q">{m.blog_helpful_q()}</p>
    <div class="btns">
      <button type="button" class="vote" data-h-yes>
        <span aria-hidden="true">👍</span>
        {m.blog_helpful_yes()}
      </button>
      <button type="button" class="vote" data-h-no>
        <span aria-hidden="true">👎</span>
        {m.blog_helpful_no()}
      </button>
    </div>
  </div>

  <form class="form" data-h-form hidden>
    <label class="lbl" for={`h-msg-${slug}`}>{m.blog_helpful_form_label()}</label>
    <textarea
      id={`h-msg-${slug}`}
      class="wc-control"
      rows="3"
      placeholder={m.blog_helpful_form_placeholder()}
      data-h-msg></textarea>
    <!-- honeypot Web3Forms -->
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" data-h-bot />
    <button type="submit" class="send">{m.blog_helpful_send()}</button>
  </form>

  <p class="done" data-h-thanks aria-live="polite" hidden>{m.blog_helpful_thanks()}</p>
  <p class="done" data-h-sent aria-live="polite" hidden>{m.blog_helpful_sent()}</p>
</div>

<script define:vars={{ accessKey }}>
  (function () {
    const root = document.querySelector('[data-helpful]');
    if (!root) return;
    const slug = root.getAttribute('data-slug') || 'post';
    const storageKey = 'wc-blog-helpful-' + slug;
    const ask = root.querySelector('[data-h-ask]');
    const form = root.querySelector('[data-h-form]');
    const msg = root.querySelector('[data-h-msg]');
    const bot = root.querySelector('[data-h-bot]');
    const thanks = root.querySelector('[data-h-thanks]');
    const sent = root.querySelector('[data-h-sent]');

    root.hidden = false;

    // anti-revote : déjà voté → état final direct.
    let voted = null;
    try {
      voted = window.localStorage.getItem(storageKey);
    } catch (e) {
      /* storage indisponible (private mode) : le widget reste utilisable */
    }
    if (voted) {
      ask.hidden = true;
      (voted === 'yes' ? thanks : sent).hidden = false;
      return;
    }

    function remember(value) {
      try {
        window.localStorage.setItem(storageKey, value);
      } catch (e) {
        /* noop */
      }
    }

    root.querySelector('[data-h-yes]').addEventListener('click', function () {
      remember('yes');
      ask.hidden = true;
      thanks.hidden = false;
      if (window.wcTrack) window.wcTrack('blog_helpful', { slug: slug, helpful: true });
    });

    root.querySelector('[data-h-no]').addEventListener('click', function () {
      ask.hidden = true;
      form.hidden = false;
      msg.focus();
      if (window.wcTrack) window.wcTrack('blog_helpful', { slug: slug, helpful: false });
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      remember('no');
      form.hidden = true;
      sent.hidden = false;
      const text = (msg.value || '').trim();
      // Clé absente ou honeypot coché ou message vide → pas d'envoi, merci quand même.
      if (!accessKey || bot.checked || !text) return;
      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: accessKey,
          subject: '[Wildcat] Blog feedback — ' + slug,
          from_name: 'Wildcat blog',
          message: text + '\n\n' + window.location.href,
        }),
      }).catch(function () {
        /* le merci est déjà affiché — l'échec réseau ne casse rien */
      });
    });
  })();
</script>

<style>
  .helpful {
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--soft);
    padding: 22px 24px;
  }
  .q {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--forest);
  }
  .btns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .vote {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .vote:hover {
    border-color: var(--gold);
    background: var(--soft-2);
  }
  .vote:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  .form {
    display: grid;
    gap: 10px;
  }
  .lbl {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
    color: var(--forest);
  }
  .hp {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  .send {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border: none;
    border-radius: 999px;
    background: var(--gold);
    color: var(--charcoal);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14.5px;
    cursor: pointer;
  }
  .send:hover {
    background: var(--gold-deep);
    color: var(--cream);
  }
  .send:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  .done {
    margin: 0;
    font-size: 15.5px;
    font-weight: 600;
    color: var(--forest);
  }
  @media (prefers-reduced-motion: reduce) {
    .vote {
      transition: none;
    }
  }
</style>
