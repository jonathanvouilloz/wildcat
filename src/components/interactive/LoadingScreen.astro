/**
 * LoadingScreen — écran d'intro scénographique (test E-loading).
 *
 * Séquence : shape tigre, remplissage liquide gold (~2.5s) ; « Wildcat »
 * s'écrit PENDANT le remplissage (variante A outline-draw / B handwriting)
 * → sortie « keyhole » : zoom à travers la shape (mask-composite exclude),
 *   fallback zoom+fade si non supporté.
 *
 * Garde-fous : no-JS = overlay masqué (noscript) ; reduced-motion = skip ;
 * scroll lock pendant l'anim ; rejoue l'entrée hero ([data-animate-load])
 * à la révélation. Variante via ?v=a|b (défaut b).
 *
 * En prod (home EN/FR) : 1 affichage par session (sessionStorage).
 * Sur /home-test-loading : oncePerSession={false} → replay illimité.
 *
 * Squelettes handwriting : tracés sur le SVG texte via tests/trace-spines.py
 * (coverage vérifiée en mode masque) — toute retouche passe par cet outil.
 */

export interface Props {
  /** false = rejoue à chaque load (page de test) ; true = 1×/session (prod). */
  oncePerSession?: boolean;
}
const { oncePerSession = true } = Astro.props;

