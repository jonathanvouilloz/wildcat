# ============================================================
# Wildcat Muay Thai — variables d'environnement (template)
# Copier vers .env et remplir. Ne jamais committer .env.
# Réf : docs/PRD.md §9
# ============================================================

# --- Site ---
# Q5 tranchée (2026-06-05) : wildcatmuaythai.com (+ wildcatchiangmai.com en 301 défensif).
PUBLIC_SITE_URL=https://wildcatmuaythai.com

# --- Sanity CMS (E4) ---
# PUBLIC_ : lus côté navigateur par le studio embarqué (pas des secrets).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Token privé — seulement si dataset privé / previews. JAMAIS de préfixe PUBLIC_.
SANITY_TOKEN=

# --- Feed Instagram (build-time, via Apify) ---
# Token personnel Apify (Console → Settings → API & Integrations).
# Absent : la section community affiche les placeholders (build vert).
# Coût : ~0,006 $/build (plan gratuit Apify = 5 $/mois, largement assez).
APIFY_TOKEN=
# En dev le fetch Apify est désactivé (30-60 s bloquants au premier rendu).
# Mettre à 1 pour forcer en dev ; sinon tester via npm run build + preview.
# INSTAGRAM_DEV_FETCH=1

# --- Formulaires : Web3Forms (décision 2026-06-05, remplace Resend) ---
# Clé d'accès publique (liée à la boîte qui reçoit les soumissions).
# Utilisée par ContactForm, StayInquiryForm et HelpfulWidget (blog).
PUBLIC_WEB3FORMS_KEY=

# --- WhatsApp deep link (E6) ---
OWNER_WHATSAPP_NUMBER=

# --- Routeur d'intake (contact-intake-router) ---
# Secrets SERVEUR uniquement — lus via process.env dans src/pages/api/inquiry.ts
# (route serverless). JAMAIS de préfixe PUBLIC_ : sinon ils fuient dans le bundle
# client. Absents : la route dégrade en silence (le mail Web3Forms reste le secours).
# À poser sur Vercel (Production + Preview).
# Bot Telegram (BotFather → /newbot).
TELEGRAM_BOT_TOKEN=
# ID du groupe commun Jon + Meaw (négatif). Récup : envoyer un message dans le
# groupe puis GET https://api.telegram.org/bot<TOKEN>/getUpdates → chat.id.
TELEGRAM_CHAT_ID=
# Envoi de l'auto-réponse (class/scooter). Domaine wildcatmuaythai.com à vérifier
# dans Resend (SPF/DKIM) avant usage.
RESEND_API_KEY=
# Classification des messages `general` (tier PAYANT — pas Experiment).
MISTRAL_API_KEY=

# --- Storage dossiers DTV (E6) ---
# Q1 NON TRANCHÉE : choisir Google Drive OU Supabase avant E6.
# Option A — Google Drive API
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Option B — Supabase Storage
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# SUPABASE_DTV_BUCKET=dtv-documents

# --- Traduction auto (V1.1, langues secondaires) ---
# DEEPL_API_KEY=
